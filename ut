Функция ВыгрузитьВМассивСтруктур(Запрос)
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Массив = Новый Массив;
	Для Каждого Строка Из Результат Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("ГУИД",        XMLСтрока(Строка.ГУИД));
		Элемент.Вставить("Наименование", Строка.Наименование);
		Массив.Добавить(Элемент);
	КонецЦикла;
	
	Возврат Массив;
	
КонецФункции

Функция ПроверитьСоответствиеФизическихЛицPOST(Запрос)
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	Попытка
		
		ДанныеЗапроса = гкм_ОбменДанными.ЗначениеИзСтрокиJSON(
			Запрос.ПолучитьТелоКакСтроку(), Истина);
		
		МассивФизлиц = ДанныеЗапроса["Физлица"];
		
		Если МассивФизлиц = Неопределено Тогда
			Ответ = Новый HTTPСервисОтвет(400);
			ОшибкаСтруктура = Новый Структура("Ошибка",
				"Отсутствует обязательное поле 'Физлица' в теле запроса");
			Ответ.УстановитьТелоИзСтроки(
				гкм_ОбменДанными.ЗначениеВСтрокуJSON(ОшибкаСтруктура),
				КодировкаТекста.UTF8);
			Возврат Ответ;
		КонецЕсли;
		
		Если ТипЗнч(МассивФизлиц) <> Тип("Массив") Тогда
			Ответ = Новый HTTPСервисОтвет(400);
			ОшибкаСтруктура = Новый Структура("Ошибка",
				"Поле 'Физлица' должно быть массивом");
			Ответ.УстановитьТелоИзСтроки(
				гкм_ОбменДанными.ЗначениеВСтрокуJSON(ОшибкаСтруктура),
				КодировкаТекста.UTF8);
			Возврат Ответ;
		КонецЕсли;
		
		Если МассивФизлиц.Количество() = 0 Тогда
			Ответ = Новый HTTPСервисОтвет(400);
			ОшибкаСтруктура = Новый Структура("Ошибка",
				"Массив 'Физлица' не может быть пустым");
			Ответ.УстановитьТелоИзСтроки(
				гкм_ОбменДанными.ЗначениеВСтрокуJSON(ОшибкаСтруктура),
				КодировкаТекста.UTF8);
			Возврат Ответ;
		КонецЕсли;
		
		// Собираем идентификаторы для запроса к регистру
		СписокИд = Новый Массив;
		Для Каждого Физлицо Из МассивФизлиц Цикл
			ИдФизлица = Физлицо["Идентификатор"];
			Если ЗначениеЗаполнено(ИдФизлица) Тогда
				СписокИд.Добавить(ИдФизлица);
			КонецЕсли;
		КонецЦикла;
		
		// Получаем только тех кого НЕТ в регистре
		НезамапленныеИд = ПолучитьНезамапленныеФизлица(СписокИд);
		
		// Формируем ответ только из незамапленных
		РезультатФизлиц = Новый Массив;
		Для Каждого Физлицо Из МассивФизлиц Цикл
			
			ИдФизлица       = Физлицо["Идентификатор"];
			НаимФизлица     = Физлицо["Наименование"];
			
			Если НезамапленныеИд.Найти(ИдФизлица) <> Неопределено Тогда
				Элемент = Новый Структура;
				Элемент.Вставить("Идентификатор", ИдФизлица);
				Элемент.Вставить("Наименование",  НаимФизлица);
				РезультатФизлиц.Добавить(Элемент);
			КонецЕсли;
			
		КонецЦикла;
		
		Результат = Новый Структура;
		Результат.Вставить("ЕстьНесопоставленные", РезультатФизлиц.Количество() > 0);
		Результат.Вставить("Физлица",              РезультатФизлиц);
		
		Ответ.УстановитьТелоИзСтроки(
			гкм_ОбменДанными.ЗначениеВСтрокуJSON(Результат),
			КодировкаТекста.UTF8);
		
	Исключение
		
		Ответ = Новый HTTPСервисОтвет(500);
		ОшибкаСтруктура = Новый Структура("Ошибка",
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Ответ.УстановитьТелоИзСтроки(
			гкм_ОбменДанными.ЗначениеВСтрокуJSON(ОшибкаСтруктура),
			КодировкаТекста.UTF8);
		
	КонецПопытки;
	
	Возврат Ответ;
	
КонецФункции

Функция ПолучитьНезамапленныеФизлица(СписокИд)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Соответствие.ИдентификаторФизлицаЗУП КАК Идентификатор
		|ИЗ
		|	РегистрСведений.гкм_СоответствиеДанныхФизлицЗУП КАК Соответствие
		|ГДЕ
		|	Соответствие.ИдентификаторФизлицаЗУП В (&СписокИд)";
	
	Запрос.УстановитьПараметр("СписокИд", СписокИд);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	// Собираем кто уже замаплен
	ЗамапленныеИд = Новый Массив;
	Для Каждого Строка Из Результат Цикл
		ЗамапленныеИд.Добавить(Строка.Идентификатор);
	КонецЦикла;
	
	// Вычитаем замапленных из входящего списка
	НезамапленныеИд = Новый Массив;
	Для Каждого Ид Из СписокИд Цикл
		Если ЗамапленныеИд.Найти(Ид) = Неопределено Тогда
			НезамапленныеИд.Добавить(Ид);
		КонецЕсли;
	КонецЦикла;
	
	Возврат НезамапленныеИд;
	
КонецФункции

Функция ЗаписатьСоответствиеФизическихЛицPOST(Запрос)
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	Попытка
		
		ДанныеЗапроса = гкм_ОбменДанными.ЗначениеИзСтрокиJSON(
			Запрос.ПолучитьТелоКакСтроку(), Истина);
		
