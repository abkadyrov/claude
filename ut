// Загружает аналитику физлиц (Подразделение, ЦентрРасходов, ОбъектСтроительства) одним запросом.
// Используется только в режиме прямой выплаты.
//
// Параметры:
//  МассивФизлиц - Массив из Соответствий с ключом "Идентификатор"
//
// Возвращаемое значение:
//   Структура - ключи: Идентификатор (Строка),
//               значения: Структура (Подразделение, ЦентрРасходов, ОбъектСтроительства)
//
Функция ПолучитьАналитикуФизлицИзРегистра(МассивФизлиц)
	
	СписокИд = Новый Массив;
	Для Каждого Физлицо Из МассивФизлиц Цикл
		СписокИд.Добавить(Физлицо["Идентификатор"]);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Соответствие.ИдентификаторФизлицаЗУП КАК Идентификатор,
		|	Соответствие.Подразделение            КАК Подразделение,
		|	Соответствие.ЦентрРасходов            КАК ЦентрРасходов,
		|	Соответствие.ОбъектСтроительства      КАК ОбъектСтроительства
		|ИЗ
		|	РегистрСведений.гкм_СоответствиеДанныхФизлицЗУП КАК Соответствие
		|ГДЕ
		|	Соответствие.ИдентификаторФизлицаЗУП В (&СписокИд)";
	Запрос.УстановитьПараметр("СписокИд", СписокИд);
	
	ТаблицаРезультата = Запрос.Выполнить().Выгрузить();
	
	АналитикаФизлиц = Новый Соответствие;
	Для Каждого Строка Из ТаблицаРезультата Цикл
		Аналитика = Новый Структура;
		Аналитика.Вставить("Подразделение",       Строка.Подразделение);
		Аналитика.Вставить("ЦентрРасходов",       Строка.ЦентрРасходов);
		Аналитика.Вставить("ОбъектСтроительства", Строка.ОбъектСтроительства);
		АналитикаФизлиц.Вставить(Строка.Идентификатор, Аналитика);
	КонецЦикла;
	
	Возврат АналитикаФизлиц;
	
КонецФункции

// Ищет контрагента по наименованию физлица и его банковский счёт по номеру лицевого счёта.
//
// Параметры:
//  НаименованиеФизлица - Строка
//  НомерЛицевогоСчета  - Строка
//
// Возвращаемое значение:
//   Структура:
//     * Успех          - Булево
//     * Ошибка         - Строка
//     * Контрагент     - СправочникСсылка.Контрагенты
//     * БанковскийСчет - СправочникСсылка.БанковскиеСчетаКонтрагентов
//
Функция НайтиКонтрагентаИСчет(НаименованиеФизлица, НомерЛицевогоСчета)
	
	Результат = Новый Структура("Успех, Ошибка, Контрагент, БанковскийСчет",
		Ложь, "", Неопределено, Неопределено);
	
	ЗапросКА = Новый Запрос;
	ЗапросКА.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Контрагенты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Наименование = &Наименование
		|	И НЕ Контрагенты.ПометкаУдаления";
	ЗапросКА.УстановитьПараметр("Наименование", НаименованиеФизлица);
	РезКА = ЗапросКА.Выполнить().Выгрузить();
	
	Если РезКА.Количество() = 0 Тогда
		Результат.Ошибка = "Контрагент не найден по наименованию: """ + НаименованиеФизлица + """";
		Возврат Результат;
	КонецЕсли;
	
	Контрагент = РезКА[0].Ссылка;
	
	ЗапросСчет = Новый Запрос;
	ЗапросСчет.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	БанковскиеСчета.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.БанковскиеСчетаКонтрагентов КАК БанковскиеСчета
		|ГДЕ
		|	БанковскиеСчета.Владелец = &Контрагент
		|	И БанковскиеСчета.НомерСчета = &НомерСчета
		|	И НЕ БанковскиеСчета.ПометкаУдаления";
	ЗапросСчет.УстановитьПараметр("Контрагент", Контрагент);
	ЗапросСчет.УстановитьПараметр("НомерСчета", НомерЛицевогоСчета);
	РезСчет = ЗапросСчет.Выполнить().Выгрузить();
	
	Если РезСчет.Количество() = 0 Тогда
		Результат.Ошибка = "Банковский счёт не найден для контрагента """
			+ НаименованиеФизлица + """, номер счёта: " + НомерЛицевогоСчета;
		Возврат Результат;
	КонецЕсли;
	
	Результат.Успех          = Истина;
	Результат.Контрагент     = Контрагент;
	Результат.БанковскийСчет = РезСчет[0].Ссылка;
	
	Возврат Результат;
	
КонецФункции

// Формирует массив аналитики платежа, группируя суммы физлиц по аналитике из регистра
// гкм_СоответствиеДанныхФизлицЗУП.
//
// Параметры:
//  МассивФизлиц - Массив из Соответствий с ключами "Идентификатор", "Сумма"
//
// Возвращаемое значение:
//   Массив из Структур - Подразделение, ЦентрРасходов, ОбъектСтроительства, Сумма
//
Функция СформироватьАналитикуПлатежа(МассивФизлиц)
	
	// Строим таблицу значений для параметра запроса
	КС = Новый КвалификаторыСтроки(36);
	КЧ = Новый КвалификаторыЧисла(15, 2);
	
	ТаблицаФизлиц = Новый ТаблицаЗначений;
	ТаблицаФизлиц.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка", КС));
	ТаблицаФизлиц.Колонки.Добавить("Сумма",         Новый ОписаниеТипов("Число", КЧ));
		
	Для Каждого Физлицо Из МассивФизлиц Цикл
		НоваяСтрока               = ТаблицаФизлиц.Добавить();
		НоваяСтрока.Идентификатор = Физлицо["Идентификатор"];
		НоваяСтрока.Сумма         = Физлицо["Сумма"];
	КонецЦикла;                                       
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	 "ВЫБРАТЬ
	 |	ВЫРАЗИТЬ(ТаблицаФизлиц.Идентификатор КАК СТРОКА(36)) КАК Идентификатор,
	 |	ТаблицаФизлиц.Сумма КАК Сумма
	 |ПОМЕСТИТЬ ТаблицаФизлиц
	 |ИЗ
	 |	&ТаблицаФизлиц КАК ТаблицаФизлиц
	 |;
	 |
	 |////////////////////////////////////////////////////////////////////////////////
	 |ВЫБРАТЬ
	 |	СУММА(ТаблицаФизлиц.Сумма) КАК Сумма,
	 |	гкм_СоответствиеДанныхФизлицЗУП.Подразделение КАК Подразделение,
	 |	гкм_СоответствиеДанныхФизлицЗУП.ЦентрРасходов КАК ЦентрРасходов,
	 |	гкм_СоответствиеДанныхФизлицЗУП.ОбъектСтроительства КАК ОбъектСтроительства
	 |ИЗ
	 |	ТаблицаФизлиц КАК ТаблицаФизлиц
	 |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.гкм_СоответствиеДанныхФизлицЗУП КАК гкм_СоответствиеДанныхФизлицЗУП
	 |		ПО ТаблицаФизлиц.Идентификатор = гкм_СоответствиеДанныхФизлицЗУП.ИдентификаторФизлицаЗУП
	 |
	 |СГРУППИРОВАТЬ ПО
	 |	гкм_СоответствиеДанныхФизлицЗУП.ЦентрРасходов,
	 |	гкм_СоответствиеДанныхФизлицЗУП.Подразделение,
	 |	гкм_СоответствиеДанныхФизлицЗУП.ОбъектСтроительства";
	
	Запрос.УстановитьПараметр("ТаблицаФизлиц", ТаблицаФизлиц);
	
	ТаблицаРезультата = Запрос.Выполнить().Выгрузить();
	
	АналитикаПлатежа = Новый Массив;
	Для Каждого Строка Из ТаблицаРезультата Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("Подразделение",       Строка.Подразделение);
		Элемент.Вставить("ЦентрРасходов",       Строка.ЦентрРасходов);
		Элемент.Вставить("ОбъектСтроительства", Строка.ОбъектСтроительства);
		Элемент.Вставить("Сумма",               Строка.Сумма);
		АналитикаПлатежа.Добавить(Элемент);
	КонецЦикла;
	
	Возврат АналитикаПлатежа;
	
КонецФункции
 
// Формирует структуру описания заявки для включения в ответ.
//
// Параметры:
//  ЗаявкаСсылка - ДокументСсылка.ЗаявкаНаРасходованиеДенежныхСредств
//  ТипВыплаты   - Строка ("Зарплата" или "НДФЛ")
//
// Возвращаемое значение:
//   Структура - Номер, Дата, ТипВыплаты, ГУИД
//
Функция ОписаниеЗаявки(ЗаявкаОбъект, ТипВыплаты)
	
	Описание = Новый Структура;
	Описание.Вставить("Номер",      ЗаявкаОбъект.Номер);
	Описание.Вставить("Дата",       Формат(ЗаявкаОбъект.Дата, "ДФ=dd.MM.yyyy"));
	Описание.Вставить("ТипВыплаты", ТипВыплаты);
	Описание.Вставить("ГУИД",       XMLСтрока(ЗаявкаОбъект.Ссылка.УникальныйИдентификатор()));
	Описание.Вставить("Сумма",      ЗаявкаОбъект.СуммаДокумента);
	
	Возврат Описание;
	
КонецФункции
 
// Формирует HTTP-ответ с ошибкой заданного кода.
//
// Параметры:
//  КодHTTP     - Число  - HTTP-код состояния (400, 500 и т.д.)
//  ТекстОшибки - Строка - Описание ошибки
//
// Возвращаемое значение:
//   HTTPСервисОтвет
//
Функция ОтветОшибка(КодHTTP, ТекстОшибки)
	
	ОтветОшб = Новый HTTPСервисОтвет(КодHTTP);
	ОтветОшб.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	ОтветОшб.УстановитьТелоИзСтроки(
		гкм_ОбменДанными.ЗначениеВСтрокуJSON(Новый Структура("Ошибка", ТекстОшибки)),
		КодировкаТекста.UTF8);
	
	Возврат ОтветОшб;
	
КонецФункции
