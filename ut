Функция ПолучитьЗарплатныеПроектыGET(Запрос)
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	Попытка
		
		ИдПроекта = Запрос.ПараметрыЗапроса.Получить("id");
		
		Если Не ЗначениеЗаполнено(ИдПроекта) Тогда
			Ответ = Новый HTTPСервисОтвет(400);
			ОшибкаСтруктура = Новый Структура("Ошибка",
				"Отсутствует обязательный параметр 'id'");
			Ответ.УстановитьТелоИзСтроки(
				гкм_ОбменДанными.ЗначениеВСтрокуJSON(ОшибкаСтруктура),
				КодировкаТекста.UTF8);
			Возврат Ответ;
		КонецЕсли;
		
		// Получаем данные из регистра с разворотом на справочник
		ЗапросПроекта = Новый Запрос;
		ЗапросПроекта.Текст =
			"ВЫБРАТЬ
			|	Настройки.ТипВыплаты                       КАК ТипВыплаты,
			|	Настройки.ЗарплатныйПроект.Наименование    КАК Наименование,
			|	Настройки.ЗарплатныйПроект.НомерДоговора   КАК НомерДоговора,
			|	Настройки.ЗарплатныйПроект.ДатаДоговора    КАК ДатаДоговора,
			|	Настройки.ЗарплатныйПроект.ПрямаяВыплата   КАК ПрямаяВыплата,
			|	Настройки.ЗарплатныйПроект                 КАК ПроектСсылка
			|ИЗ
			|	РегистрСведений.гкм_НастройкиЗарплатныхПроектовЗУП КАК Настройки
			|ГДЕ
			|	Настройки.ИдентификаторЗарплатногоПроектаЗУП = &ИдПроекта
			|	И НЕ Настройки.ЗарплатныйПроект.ПометкаУдаления";
		
		ЗапросПроекта.УстановитьПараметр("ИдПроекта", ИдПроекта);
		
		ТаблицаПроекта = ЗапросПроекта.Выполнить().Выгрузить();
		
		Если ТаблицаПроекта.Количество() = 0 Тогда
			Результат = Новый Структура;
			Результат.Вставить("Найден", Ложь);
			Ответ.УстановитьТелоИзСтроки(
				гкм_ОбменДанными.ЗначениеВСтрокуJSON(Результат),
				КодировкаТекста.UTF8);
			Возврат Ответ;
		КонецЕсли;
		
		// Берём общие данные из первой строки — они одинаковы для всех типов выплат
		ПерваяСтрока = ТаблицаПроекта[0];
		
		// Получаем шаблоны назначений платежей из ТЧ справочника
		ЗапросШаблонов = Новый Запрос;
		ЗапросШаблонов.Текст =
			"ВЫБРАТЬ
			|	ШаблоныНазначения.ТипВыплаты КАК ТипВыплаты,
			|	ШаблоныНазначения.Шаблон     КАК Шаблон
			|ИЗ
			|	Справочник.гкм_ЗарплатныеПроекты.ШаблонНазначенияПлатежа КАК ШаблоныНазначения
			|ГДЕ
			|	ШаблоныНазначения.Ссылка = &ПроектСсылка";
		
		ЗапросШаблонов.УстановитьПараметр("ПроектСсылка", ПерваяСтрока.ПроектСсылка);
		
		ТаблицаШаблонов = ЗапросШаблонов.Выполнить().Выгрузить();
		
		// Собираем шаблоны в соответствие
		Шаблоны = Новый Соответствие;
		Для Каждого СтрокаШаблона Из ТаблицаШаблонов Цикл
			Шаблоны.Вставить(Строка(СтрокаШаблона.ТипВыплаты), СтрокаШаблона.Шаблон);
		КонецЦикла;
		
		// Формируем ответ
		Результат = Новый Структура;
		Результат.Вставить("Найден",          Истина);
		Результат.Вставить("Наименование",    ПерваяСтрока.Наименование);
		Результат.Вставить("НомерДоговора",   ПерваяСтрока.НомерДоговора);
		Результат.Вставить("ДатаДоговора",    ?(ЗначениеЗаполнено(ПерваяСтрока.ДатаДоговора),
			Формат(ПерваяСтрока.ДатаДоговора, "ДФ=dd.MM.yyyy 'г.'"), ""));
		Результат.Вставить("ПрямаяВыплата",   ПерваяСтрока.ПрямаяВыплата);
		Результат.Вставить("Шаблоны",         Шаблоны);
		
		Ответ.УстановитьТелоИзСтроки(
