Функция ПолучитьПодразделения()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Соответствие.Подразделение КАК ГУИД,
		|	Соответствие.Подразделение.Наименование КАК Наименование
		|ИЗ
		|	РегистрСведений.гкм_СоответствиеПодразделенийИЦентровРасходов КАК Соответствие
		|ГДЕ
		|	НЕ Соответствие.Подразделение.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Соответствие.Подразделение.Наименование";
	
	Возврат ВыгрузитьВМассивСтруктур(Запрос);
	
КонецФункции

Функция ПолучитьЦентрыРасходов()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Соответствие.Подразделение КАК ПодразделениеГУИД,
		|	Соответствие.Подразделение.Наименование КАК ПодразделениеНаименование,
		|	Соответствие.ЦентрРасходов КАК ЦентрРасходовГУИД,
		|	Соответствие.ЦентрРасходов.Наименование КАК ЦентрРасходовНаименование
		|ИЗ
		|	РегистрСведений.гкм_СоответствиеПодразделенийИЦентровРасходов КАК Соответствие
		|ГДЕ
		|	НЕ Соответствие.Подразделение.ПометкаУдаления
		|	И НЕ Соответствие.ЦентрРасходов.ПометкаУдаления";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Массив = Новый Массив;
	Для Каждого Строка Из Результат Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("ПодразделениеГУИД",         XMLСтрока(Строка.ПодразделениеГУИД));
		Элемент.Вставить("ПодразделениеНаименование", Строка.ПодразделениеНаименование);
		Элемент.Вставить("ЦентрРасходовГУИД",         XMLСтрока(Строка.ЦентрРасходовГУИД));
		Элемент.Вставить("ЦентрРасходовНаименование", Строка.ЦентрРасходовНаименование);
		Массив.Добавить(Элемент);
	КонецЦикла;
	
	Возврат Массив;
	
КонецФункции

