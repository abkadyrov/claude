			гкм_ОбменДанными.ЗначениеВСтрокуJSON(ОшибкаСтруктура),
			КодировкаТекста.UTF8);
		
	КонецПопытки;
	
	Возврат Ответ;
	
КонецФункции  

Функция ЗаписатьМаппингФизлиц(МассивФизлиц)
	
	ОшибкиЗаписи = Новый Массив;
	
	Для Каждого Физлицо Из МассивФизлиц Цикл
		
		Попытка
			
			ИдФизлица               = Физлицо["Идентификатор"];
			НаимФизлица             = Физлицо["Наименование"];
			ПодразделениеГУИД       = Физлицо["ПодразделениеГУИД"];
			ЦентрРасходовГУИД       = Физлицо["ЦентрРасходовГУИД"];
			ОбъектСтроительстваГУИД = Физлицо["ОбъектСтроительстваГУИД"];
			
			// Проверяем обязательные поля
			Если Не ЗначениеЗаполнено(ИдФизлица) Тогда
				ОшибкиЗаписи.Добавить("Пустой идентификатор физлица");
				Продолжить;
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(ПодразделениеГУИД) Тогда
				ОшибкиЗаписи.Добавить(НаимФизлица + ": не заполнено подразделение");
				Продолжить;
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(ЦентрРасходовГУИД) Тогда
				ОшибкиЗаписи.Добавить(НаимФизлица + ": не заполнен центр расходов");
				Продолжить;
			КонецЕсли;
			
			// Получаем ссылку на подразделение по ГУИД
			Подразделение = Справочники.СтруктураПредприятия.ПолучитьСсылку(
				Новый УникальныйИдентификатор(ПодразделениеГУИД));
			
			Если Не ЗначениеЗаполнено(Подразделение) Тогда
				ОшибкиЗаписи.Добавить(НаимФизлица
					+ ": подразделение не найдено в УТ (" + ПодразделениеГУИД + ")");
				Продолжить;
			КонецЕсли;
			
			// Получаем ссылку на центр расходов по ГУИД
			ЦентрРасходов = Справочники.гкм_ЦентрыРасходов.ПолучитьСсылку(
				Новый УникальныйИдентификатор(ЦентрРасходовГУИД));
			
			Если Не ЗначениеЗаполнено(ЦентрРасходов) Тогда
				ОшибкиЗаписи.Добавить(НаимФизлица
					+ ": центр расходов не найден в УТ (" + ЦентрРасходовГУИД + ")");
				Продолжить;
			КонецЕсли;
			
			// Получаем ссылку на объект строительства по ГУИД (необязательное поле)
			ОбъектСтроительства = Справочники.гкм_ОбъектыСтроительства.ПустаяСсылка();
			Если ЗначениеЗаполнено(ОбъектСтроительстваГУИД) Тогда
				ОбъектСтроительства = Справочники.гкм_ОбъектыСтроительства.ПолучитьСсылку(
					Новый УникальныйИдентификатор(ОбъектСтроительстваГУИД));
			КонецЕсли;
			
			// Записываем в регистр — идемпотентно, перезапишет если уже есть
			НаборЗаписей = РегистрыСведений.гкм_СоответствиеДанныхФизлицЗУП.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ИдентификаторФизлицаЗУП.Установить(ИдФизлица);
			
			НоваяЗапись = НаборЗаписей.Добавить();
			НоваяЗапись.ИдентификаторФизлицаЗУП = ИдФизлица;
			НоваяЗапись.НаименованиеФизлицаЗУП  = НаимФизлица;
			НоваяЗапись.Подразделение           = Подразделение;
			НоваяЗапись.ЦентрРасходов           = ЦентрРасходов;
			НоваяЗапись.ОбъектСтроительства     = ОбъектСтроительства;
			
			НаборЗаписей.Записать();
			
		Исключение
			ОшибкиЗаписи.Добавить(
				НаимФизлица + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат ОшибкиЗаписи;
	
КонецФункции

Функция ПроверитьСоответствиеЗарплатныхПроектовPOST(Запрос)
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	Попытка
		
		ДанныеЗапроса = гкм_ОбменДанными.ЗначениеИзСтрокиJSON(
			Запрос.ПолучитьТелоКакСтроку(), Истина);
		
		ИдПроекта		= ДанныеЗапроса["ИдентификаторЗарплатногоПроекта"];
		ОрганизацияИНН  = ДанныеЗапроса["ОрганизацияИНН"];
		
		Если Не ЗначениеЗаполнено(ИдПроекта) Тогда
			Ответ = Новый HTTPСервисОтвет(400);
			ОшибкаСтруктура = Новый Структура("Ошибка",
				"Отсутствует обязательное поле 'ИдентификаторЗарплатногоПроекта'");
			Ответ.УстановитьТелоИзСтроки(
				гкм_ОбменДанными.ЗначениеВСтрокуJSON(ОшибкаСтруктура),
				КодировкаТекста.UTF8);
			Возврат Ответ;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ОрганизацияИНН) Тогда
			Ответ = Новый HTTPСервисОтвет(400);
			ОшибкаСтруктура = Новый Структура("Ошибка",
				"Отсутствует обязательное поле 'ОрганизацияИНН'");
			Ответ.УстановитьТелоИзСтроки(
				гкм_ОбменДанными.ЗначениеВСтрокуJSON(ОшибкаСтруктура),
				КодировкаТекста.UTF8);
			Возврат Ответ;
		КонецЕсли;
		
		// Получаем записи по обоим типам выплат
		ЗапросДанных = Новый Запрос;
		ЗапросДанных.Текст =
			"ВЫБРАТЬ
			|	Настройки.ТипВыплаты КАК ТипВыплаты,
			|	Настройки.ЗарплатныйПроект КАК ЗарплатныйПроект,
			|	Настройки.Контрагент КАК Контрагент,
			|	Настройки.БанковскийСчетКонтрагента КАК БанковскийСчетКонтрагента,
			|	Настройки.СтатьяДвиженияДенежныхСредств КАК СтатьяДДС,
			|	Настройки.ТипНалога КАК ТипНалога,
			|	Настройки.КодБК КАК КодБК,
			|	Настройки.ЗарплатныйПроект.Подразделение КАК Подразделение,
			|	Настройки.ЗарплатныйПроект.ЦентрРасходов КАК ЦентрРасходов,
			|	Настройки.ЗарплатныйПроект.ОбъектСтроительства КАК ОбъектСтроительства,
			|	Настройки.ЗарплатныйПроект.БанковскийСчетОрганизации КАК БанковскийСчетОрганизации,
			|	ЕСТЬNULL(Настройки.ЗарплатныйПроект.ПрямаяВыплата, ЛОЖЬ) КАК ПрямаяВыплата
			|ИЗ
			|	РегистрСведений.гкм_НастройкиЗарплатныхПроектовЗУП КАК Настройки
			|ГДЕ
			|	Настройки.Организация.ИНН = &ИНН
			|	И Настройки.ИдентификаторЗарплатногоПроектаЗУП = &ИдПроекта
			|	И Настройки.ТипВыплаты В (ЗНАЧЕНИЕ(Перечисление.гкм_ТипыВыплатыЗУП.Зарплата), ЗНАЧЕНИЕ(Перечисление.гкм_ТипыВыплатыЗУП.НДФЛ))";
		
		ЗапросДанных.УстановитьПараметр("ИНН",       ОрганизацияИНН);
		ЗапросДанных.УстановитьПараметр("ИдПроекта", ИдПроекта);
		
		Выборка = ЗапросДанных.Выполнить().Выгрузить();
		
		// Проект не найден совсем
		Если Выборка.Количество() = 0 Тогда
			Результат = Новый Структура;
			Результат.Вставить("Найден",             Ложь);
			Результат.Вставить("НастройкаВыполнена", Ложь);
			Результат.Вставить("НезаполненныеПоля",  Новый Массив);
			Ответ.УстановитьТелоИзСтроки(
				гкм_ОбменДанными.ЗначениеВСтрокуJSON(Результат),
				КодировкаТекста.UTF8);
			Возврат Ответ;
		КонецЕсли;
		
		НезаполненныеПоля = Новый Массив;
		
		СтрокаЗарплата = Выборка.Найти(Перечисления.гкм_ТипыВыплатыЗУП.Зарплата, "ТипВыплаты");
		СтрокаНДФЛ = Выборка.Найти(Перечисления.гкм_ТипыВыплатыЗУП.НДФЛ, "ТипВыплаты");
		
		// Проверка записи Зарплата
		Если СтрокаЗарплата = Неопределено Тогда
			НезаполненныеПоля.Добавить("Зарплата: запись не найдена");
		Иначе
			// Реквизиты справочника
			Если Не ЗначениеЗаполнено(СтрокаЗарплата.ЗарплатныйПроект) Тогда
				НезаполненныеПоля.Добавить("Зарплата: не заполнен Зарплатный проект");
			Иначе
				Если Не ЗначениеЗаполнено(СтрокаЗарплата.Подразделение) Тогда
					НезаполненныеПоля.Добавить("Зарплата: не заполнено Подразделение");
				КонецЕсли;
				Если Не ЗначениеЗаполнено(СтрокаЗарплата.ЦентрРасходов) Тогда
					НезаполненныеПоля.Добавить("Зарплата: не заполнен Центр расходов");
				КонецЕсли;
				Если Не ЗначениеЗаполнено(СтрокаЗарплата.ОбъектСтроительства) Тогда
					НезаполненныеПоля.Добавить("Зарплата: не заполнен Объект строительства");
				КонецЕсли;
				Если Не ЗначениеЗаполнено(СтрокаЗарплата.БанковскийСчетОрганизации) Тогда
					НезаполненныеПоля.Добавить("Зарплата: не заполнен Банковский счет организации");
				КонецЕсли;
			КонецЕсли;
			// Реквизиты регистра
			Если Не СтрокаЗарплата.ПрямаяВыплата Тогда
				Если Не ЗначениеЗаполнено(СтрокаЗарплата.Контрагент) Тогда
					НезаполненныеПоля.Добавить("Зарплата: не заполнен Контрагент");
				КонецЕсли;
				Если Не ЗначениеЗаполнено(СтрокаЗарплата.БанковскийСчетКонтрагента) Тогда
					НезаполненныеПоля.Добавить("Зарплата: не заполнен Банковский счет контрагента");
				КонецЕсли;
			КонецЕсли;
			Если Не ЗначениеЗаполнено(СтрокаЗарплата.СтатьяДДС) Тогда
				НезаполненныеПоля.Добавить("Зарплата: не заполнена Статья ДДС");
			КонецЕсли;
		КонецЕсли;
		
		// Проверка записи НДФЛ
		Если СтрокаНДФЛ = Неопределено Тогда
			НезаполненныеПоля.Добавить("НДФЛ: запись не найдена");
		Иначе
			// Реквизиты справочника
			Если Не ЗначениеЗаполнено(СтрокаНДФЛ.ЗарплатныйПроект) Тогда
				НезаполненныеПоля.Добавить("НДФЛ: не заполнен Зарплатный проект");
			Иначе
				Если Не ЗначениеЗаполнено(СтрокаНДФЛ.Подразделение) Тогда
					НезаполненныеПоля.Добавить("НДФЛ: не заполнено Подразделение");
				КонецЕсли;
				Если Не ЗначениеЗаполнено(СтрокаНДФЛ.ЦентрРасходов) Тогда
					НезаполненныеПоля.Добавить("НДФЛ: не заполнен Центр расходов");
				КонецЕсли;
				Если Не ЗначениеЗаполнено(СтрокаНДФЛ.ОбъектСтроительства) Тогда
					НезаполненныеПоля.Добавить("НДФЛ: не заполнен Объект строительства");
				КонецЕсли;
				Если Не ЗначениеЗаполнено(СтрокаНДФЛ.БанковскийСчетОрганизации) Тогда
					НезаполненныеПоля.Добавить("НДФЛ: не заполнен Банковский счет организации");
				КонецЕсли;
			КонецЕсли;
			// Реквизиты регистра
			Если Не ЗначениеЗаполнено(СтрокаНДФЛ.Контрагент) Тогда
				НезаполненныеПоля.Добавить("НДФЛ: не заполнен Контрагент");
			КонецЕсли;
			Если Не ЗначениеЗаполнено(СтрокаНДФЛ.БанковскийСчетКонтрагента) Тогда
				НезаполненныеПоля.Добавить("НДФЛ: не заполнен Банковский счет контрагента");
			КонецЕсли;
			Если Не ЗначениеЗаполнено(СтрокаНДФЛ.СтатьяДДС) Тогда
				НезаполненныеПоля.Добавить("НДФЛ: не заполнена Статья ДДС");
			КонецЕсли;
			Если Не ЗначениеЗаполнено(СтрокаНДФЛ.ТипНалога) Тогда
				НезаполненныеПоля.Добавить("НДФЛ: не заполнен Тип налога");
			КонецЕсли;
			Если Не ЗначениеЗаполнено(СтрокаНДФЛ.КодБК) Тогда
				НезаполненныеПоля.Добавить("НДФЛ: не заполнен Код БК");
			КонецЕсли;
		КонецЕсли;
		
		Результат = Новый Структура;
		Результат.Вставить("Найден",             Истина);
		Результат.Вставить("НастройкаВыполнена", НезаполненныеПоля.Количество() = 0);
		Результат.Вставить("НезаполненныеПоля",  НезаполненныеПоля);
		
		Ответ.УстановитьТелоИзСтроки(
			гкм_ОбменДанными.ЗначениеВСтрокуJSON(Результат),
			КодировкаТекста.UTF8);
		
	Исключение
		
		Ответ = Новый HTTPСервисОтвет(500);
		ОшибкаСтруктура = Новый Структура("Ошибка",
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Ответ.УстановитьТелоИзСтроки(
			гкм_ОбменДанными.ЗначениеВСтрокуJSON(ОшибкаСтруктура),
			КодировкаТекста.UTF8);
		
	КонецПопытки;
	
	Возврат Ответ;
	
КонецФункции

Функция ЗаписатьСоответствиеЗарплатныхПроектовPOST(Запрос)
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	Попытка
		
		ДанныеЗапроса = гкм_ОбменДанными.ЗначениеИзСтрокиJSON(
			Запрос.ПолучитьТелоКакСтроку(), Истина);
		
		ИдПроекта    	= ДанныеЗапроса["ИдентификаторЗарплатногоПроекта"];
		Наименование 	= ДанныеЗапроса["Наименование"];
		ОрганизацияИНН	= ДанныеЗапроса["ОрганизацияИНН"];
		ПрямаяВыплата 	= ДанныеЗапроса["ПрямаяВыплата"];
		
		Если Не ЗначениеЗаполнено(ИдПроекта) Тогда
			Ответ = Новый HTTPСервисОтвет(400);
			ОшибкаСтруктура = Новый Структура("Ошибка",
				"Отсутствует обязательное поле 'ИдентификаторЗарплатногоПроекта'");
			Ответ.УстановитьТелоИзСтроки(
				гкм_ОбменДанными.ЗначениеВСтрокуJSON(ОшибкаСтруктура),
				КодировкаТекста.UTF8);
			Возврат Ответ;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ОрганизацияИНН) Тогда
			Ответ = Новый HTTPСервисОтвет(400);
			ОшибкаСтруктура = Новый Структура("Ошибка",
				"Отсутствует обязательное поле 'ОрганизацияИНН'");
			Ответ.УстановитьТелоИзСтроки(
				гкм_ОбменДанными.ЗначениеВСтрокуJSON(ОшибкаСтруктура),
				КодировкаТекста.UTF8);
			Возврат Ответ;
		КонецЕсли;
		
		// Ищем организацию по ИНН
		ЗапросОрг = Новый Запрос;
		ЗапросОрг.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Организации.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.Организации КАК Организации
			|ГДЕ
			|	Организации.ИНН = &ИНН
			|	И НЕ Организации.ПометкаУдаления";
		
		ЗапросОрг.УстановитьПараметр("ИНН", ОрганизацияИНН);
		
		РезультатОрг = ЗапросОрг.Выполнить();
		Если РезультатОрг.Пустой() Тогда
			Ответ = Новый HTTPСервисОтвет(400);
			ОшибкаСтруктура = Новый Структура("Ошибка",
				"Организация не найдена в УТ по ИНН: " + ОрганизацияИНН);
			Ответ.УстановитьТелоИзСтроки(
				гкм_ОбменДанными.ЗначениеВСтрокуJSON(ОшибкаСтруктура),
				КодировкаТекста.UTF8);
			Возврат Ответ;
		КонецЕсли;
		
		Организация = РезультатОрг.Выгрузить()[0].Ссылка;
		
		// Создаём две записи в регистре — Зарплата и НДФЛ
		// Справочник ЗарплатныйПроект оставляем пустым — администратор привяжет вручную
		ТипыВыплат = Новый Массив;
		ТипыВыплат.Добавить(Перечисления.гкм_ТипыВыплатыЗУП.Зарплата);
		ТипыВыплат.Добавить(Перечисления.гкм_ТипыВыплатыЗУП.НДФЛ);
		
		Для Каждого ТипВыплаты Из ТипыВыплат Цикл
			
			НаборЗаписей = РегистрыСведений.гкм_НастройкиЗарплатныхПроектовЗУП.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Организация.Установить(Организация);
			НаборЗаписей.Отбор.ТипВыплаты.Установить(ТипВыплаты);
			НаборЗаписей.Отбор.ИдентификаторЗарплатногоПроектаЗУП.Установить(ИдПроекта);
			НаборЗаписей.Прочитать();
			
			// Не перезаписываем если уже есть — администратор мог донастроить
			Если НаборЗаписей.Количество() > 0 Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяЗапись = НаборЗаписей.Добавить();
			НоваяЗапись.Организация                         = Организация;
			НоваяЗапись.ТипВыплаты                          = ТипВыплаты;
			НоваяЗапись.ИдентификаторЗарплатногоПроектаЗУП  = ИдПроекта;
			НоваяЗапись.НаименованиеЗарплатногоПроектаЗУП   = ?(ЗначениеЗаполнено(Наименование), Наименование, ИдПроекта);
			
			НаборЗаписей.Записать();
			
		КонецЦикла;
		
		Результат = Новый Структура("Успех", Истина);
		Ответ.УстановитьТелоИзСтроки(
			гкм_ОбменДанными.ЗначениеВСтрокуJSON(Результат),
			КодировкаТекста.UTF8);
		
	Исключение
		
		Ответ = Новый HTTPСервисОтвет(500);
		ОшибкаСтруктура = Новый Структура("Ошибка",
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Ответ.УстановитьТелоИзСтроки(
			гкм_ОбменДанными.ЗначениеВСтрокуJSON(ОшибкаСтруктура),
			КодировкаТекста.UTF8);
		
	КонецПопытки;
	
	Возврат Ответ;
	
КонецФункции

Функция ПолучитьЗарплатныеПроектыGET(Запрос)
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	Попытка
		
		ИдПроекта = Запрос.ПараметрыЗапроса.Получить("id");
		
		Если Не ЗначениеЗаполнено(ИдПроекта) Тогда
			Ответ = Новый HTTPСервисОтвет(400);
			ОшибкаСтруктура = Новый Структура("Ошибка",
				"Отсутствует обязательный параметр 'id'");
			Ответ.УстановитьТелоИзСтроки(
				гкм_ОбменДанными.ЗначениеВСтрокуJSON(ОшибкаСтруктура),
				КодировкаТекста.UTF8);
			Возврат Ответ;
		КонецЕсли;
		
		// Получаем данные из регистра с разворотом на справочник
		ЗапросПроекта = Новый Запрос;
		ЗапросПроекта.Текст =
			"ВЫБРАТЬ
			|	Настройки.ТипВыплаты КАК ТипВыплаты,
			|	Настройки.ЗарплатныйПроект.Наименование КАК Наименование,
			|	Настройки.ЗарплатныйПроект.НомерДоговора КАК НомерДоговора,
			|	Настройки.ЗарплатныйПроект.ДатаДоговора КАК ДатаДоговора,
			|	Настройки.ЗарплатныйПроект.ПрямаяВыплата КАК ПрямаяВыплата,
			|	Настройки.ЗарплатныйПроект КАК ПроектСсылка
			|ИЗ
			|	РегистрСведений.гкм_НастройкиЗарплатныхПроектовЗУП КАК Настройки
			|ГДЕ
			|	Настройки.ИдентификаторЗарплатногоПроектаЗУП = &ИдПроекта
			|	И НЕ Настройки.ЗарплатныйПроект = ЗНАЧЕНИЕ(Справочник.гкм_ЗарплатныеПроекты.ПустаяСсылка)";
		
		ЗапросПроекта.УстановитьПараметр("ИдПроекта", ИдПроекта);
		
		ТаблицаПроекта = ЗапросПроекта.Выполнить().Выгрузить();
		
		Если ТаблицаПроекта.Количество() = 0 Тогда
			Результат = Новый Структура;
			Результат.Вставить("Найден", Ложь);
			Ответ.УстановитьТелоИзСтроки(
				гкм_ОбменДанными.ЗначениеВСтрокуJSON(Результат),
				КодировкаТекста.UTF8);
			Возврат Ответ;
		КонецЕсли;
		
		// Берём общие данные из первой строки — они одинаковы для всех типов выплат
		ПерваяСтрока = ТаблицаПроекта[0];
		
		// Получаем шаблоны назначений платежей из ТЧ справочника
		ЗапросШаблонов = Новый Запрос;
		ЗапросШаблонов.Текст =
			"ВЫБРАТЬ
			|	ШаблоныНазначения.ТипВыплаты КАК ТипВыплаты,
			|	ШаблоныНазначения.Шаблон     КАК Шаблон
			|ИЗ
			|	Справочник.гкм_ЗарплатныеПроекты.ШаблонНазначенияПлатежа КАК ШаблоныНазначения
			|ГДЕ
			|	ШаблоныНазначения.Ссылка = &ПроектСсылка";
		
		ЗапросШаблонов.УстановитьПараметр("ПроектСсылка", ПерваяСтрока.ПроектСсылка);
		
		ТаблицаШаблонов = ЗапросШаблонов.Выполнить().Выгрузить();
		
		// Собираем шаблоны в соответствие
		Шаблоны = Новый Соответствие;
		Для Каждого СтрокаШаблона Из ТаблицаШаблонов Цикл
			Шаблоны.Вставить(Строка(СтрокаШаблона.ТипВыплаты), СтрокаШаблона.Шаблон);
		КонецЦикла;
		
		// Формируем ответ
		Результат = Новый Структура;
		Результат.Вставить("Найден",          Истина);
		Результат.Вставить("Наименование",    ПерваяСтрока.Наименование);
		Результат.Вставить("НомерДоговора",   ПерваяСтрока.НомерДоговора);
		Результат.Вставить("ДатаДоговора",    Формат(ПерваяСтрока.ДатаДоговора, "ДФ=dd.MM.yyyy"));
		Результат.Вставить("ПрямаяВыплата",   ПерваяСтрока.ПрямаяВыплата);
		Результат.Вставить("Шаблоны",         Шаблоны);
		
		Ответ.УстановитьТелоИзСтроки(
			гкм_ОбменДанными.ЗначениеВСтрокуJSON(Результат),
			КодировкаТекста.UTF8);
		
	Исключение
		
		Ответ = Новый HTTPСервисОтвет(500);
		ОшибкаСтруктура = Новый Структура("Ошибка",
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Ответ.УстановитьТелоИзСтроки(
			гкм_ОбменДанными.ЗначениеВСтрокуJSON(ОшибкаСтруктура),
			КодировкаТекста.UTF8);
		
	КонецПопытки;
	
	Возврат Ответ;

КонецФункции

Функция СоздатьЗаявкиНаРасходДСPOST(Запрос)
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	Попытка
		
		ДанныеЗапроса = гкм_ОбменДанными.ЗначениеИзСтрокиJSON(
			Запрос.ПолучитьТелоКакСтроку(), Истина);
		
		// Разбираем входные данные
		ДанныеВедомости    			= ДанныеЗапроса["Ведомость"];
		МассивФизлиц       			= ДанныеЗапроса["Строки"];
		МассивФизлицНДФЛ   			= ДанныеЗапроса["СтрокиНДФЛ"];
		НазначениеЗарплата			= ДанныеЗапроса["НазначениеПлатежаЗарплата"];
		НазначениеНДФЛ     			= ДанныеЗапроса["НазначениеПлатежаНДФЛ"];
		ДополнительныеПараметры     = ДанныеЗапроса["ДополнительныеПараметры"];
		
		// Проверка дополнительных параметров
		Если ДополнительныеПараметры = Неопределено Тогда 
			Возврат ОтветОшибка(400, "Отсутствует обязательное поле 'ДополнительныеПараметры'");
		КонецЕсли;
		
		ПараметрыСоздания         = Новый Структура;
		ПараметрыСоздания.Вставить("ПроводитьДокумент",        	ДополнительныеПараметры["ПроводитьДокумент"] = Истина);
		ПараметрыСоздания.Вставить("СоздаватьЗаявкиНаЗарплату", ДополнительныеПараметры["СоздаватьЗаявкиНаЗарплату"] = Истина);
		ПараметрыСоздания.Вставить("СоздаватьЗаявкиНаНДФЛ",     ДополнительныеПараметры["СоздаватьЗаявкиНаНДФЛ"] = Истина);
		ПараметрыСоздания.Вставить("РежимТестирования",        	ДополнительныеПараметры["РежимТестирования"] = Истина);
		
		// Валидация обязательных полей
		Если ДанныеВедомости = Неопределено Тогда
			Возврат ОтветОшибка(400, "Отсутствует обязательное поле 'Ведомость'");
		КонецЕсли;
		
		Если МассивФизлиц = Неопределено
			Или ТипЗнч(МассивФизлиц) <> Тип("Массив")
			Или МассивФизлиц.Количество() = 0 Тогда
			Возврат ОтветОшибка(400, "Отсутствуют или пусты данные строк ведомости ('Строки')");
		КонецЕсли;
		
		ОрганизацияИНН       = ДанныеВедомости["ОрганизацияИНН"];
		ЗарплатныйПроектГУИД = ДанныеВедомости["ЗарплатныйПроектГУИД"];
		НомерВедомости       = ДанныеВедомости["Номер"];
		ДатаВедомостиСтрока  = ДанныеВедомости["Дата"];   // "yyyy-MM-dd"
		
		Если Не ЗначениеЗаполнено(ОрганизацияИНН) Тогда
			Возврат ОтветОшибка(400, "Отсутствует обязательное поле 'ОрганизацияИНН'");
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ЗарплатныйПроектГУИД) Тогда
			Возврат ОтветОшибка(400, "Отсутствует обязательное поле 'ЗарплатныйПроектГУИД'");
		КонецЕсли;
		
		// Находим организацию по ИНН
		ЗапросОрг = Новый Запрос;
		ЗапросОрг.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Организации.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.Организации КАК Организации
			|ГДЕ
			|	Организации.ИНН = &ИНН
			|	И НЕ Организации.ПометкаУдаления";
		ЗапросОрг.УстановитьПараметр("ИНН", ОрганизацияИНН);
		РезОрг = ЗапросОрг.Выполнить().Выгрузить();
		
		Если РезОрг.Количество() = 0 Тогда
			Возврат ОтветОшибка(400, "Организация не найдена по ИНН: " + ОрганизацияИНН);
		КонецЕсли;
		Организация = РезОрг[0].Ссылка;
		
		// Получаем настройки зарплатного проекта (записи Зарплата и НДФЛ)
		ЗапросНастроек = Новый Запрос;
		ЗапросНастроек.Текст =
			"ВЫБРАТЬ
			|	Настройки.ТипВыплаты                                  КАК ТипВыплаты,
			|	Настройки.Контрагент                                   КАК Контрагент,
			|	Настройки.БанковскийСчетКонтрагента                    КАК БанковскийСчетКонтрагента,
			|	Настройки.СтатьяДвиженияДенежныхСредств                КАК СтатьяДДС,
			|	Настройки.ТипНалога                                    КАК ТипНалога,
			|	Настройки.КодБК                                        КАК КодБК,
			|	Настройки.ЗарплатныйПроект.БанковскийСчетОрганизации   КАК БанковскийСчетОрганизации,
			|	Настройки.ЗарплатныйПроект.Подразделение               КАК Подразделение,
			|	Настройки.ЗарплатныйПроект.ЦентрРасходов               КАК гкм_ЦентрРасходов,
			|	Настройки.ЗарплатныйПроект.ОбъектСтроительства         КАК гкм_ОбъектСтроительства
			|ИЗ
			|	РегистрСведений.гкм_НастройкиЗарплатныхПроектовЗУП КАК Настройки
			|ГДЕ
			|	Настройки.Организация = &Организация
			|	И Настройки.ИдентификаторЗарплатногоПроектаЗУП = &ИдПроекта
			|	И Настройки.ТипВыплаты В (ЗНАЧЕНИЕ(Перечисление.гкм_ТипыВыплатыЗУП.Зарплата),
			|		ЗНАЧЕНИЕ(Перечисление.гкм_ТипыВыплатыЗУП.НДФЛ))";
		
		ЗапросНастроек.УстановитьПараметр("Организация", Организация);
		ЗапросНастроек.УстановитьПараметр("ИдПроекта",   ЗарплатныйПроектГУИД);
		
		ТаблицаНастроек = ЗапросНастроек.Выполнить().Выгрузить();
		
		НастройкаЗарплата = ТаблицаНастроек.Найти(
			Перечисления.гкм_ТипыВыплатыЗУП.Зарплата, "ТипВыплаты");
		НастройкаНДФЛ     = ТаблицаНастроек.Найти(
			Перечисления.гкм_ТипыВыплатыЗУП.НДФЛ, "ТипВыплаты");
		
		Если НастройкаЗарплата = Неопределено Тогда
			Возврат ОтветОшибка(400, "Не найдена настройка зарплатного проекта для типа 'Зарплата'");
		КонецЕсли;
		Если НастройкаНДФЛ = Неопределено Тогда
			Возврат ОтветОшибка(400, "Не найдена настройка зарплатного проекта для типа 'НДФЛ'");
		КонецЕсли;
		
		// Разбираем дату ведомости из строки "yyyy-MM-dd"
		ДатаВедомости = ПрочитатьДатуJSON(ДатаВедомостиСтрока, ФорматДатыJSON.ISO);
		
		МассивЗаявок  = Новый Массив;
		ПрямаяВыплата = ДанныеВедомости["ПрямаяВыплата"];
		
		Если ПрямаяВыплата = Истина Тогда
			
			// --- Режим прямой выплаты ---
			// Предзагружаем аналитику физлиц из регистра одним запросом
			АналитикаФизлиц = ПолучитьАналитикуФизлицИзРегистра(МассивФизлиц);
			
			// Сумма НДФЛ и аналитика для единой заявки НДФЛ
			СуммаНДФЛ = 0;
			Для Каждого Физлицо Из МассивФизлицНДФЛ Цикл
				СуммаНДФЛ = СуммаНДФЛ + Физлицо["Сумма"];
			КонецЦикла;
			
			АналитикаПлатежаНДФЛ = СформироватьАналитикуПлатежа(МассивФизлицНДФЛ);
			
			СуммаАналитикиНДФЛ = 0;
			Для Каждого СтрАналитики Из АналитикаПлатежаНДФЛ Цикл
				СуммаАналитикиНДФЛ = СуммаАналитикиНДФЛ + СтрАналитики.Сумма;
			КонецЦикла;
			Если Окр(СуммаАналитикиНДФЛ, 2) <> Окр(СуммаНДФЛ, 2) Тогда
				Возврат ОтветОшибка(400,
					"Сумма по аналитике платежа (НДФЛ): " + СуммаАналитикиНДФЛ
					+ " не совпадает с суммой НДФЛ: " + СуммаНДФЛ
					+ ". Возможно, не все физлица сопоставлены с подразделениями.");
			КонецЕсли;
			
			НачатьТранзакцию();
			Попытка
				
				// Заявки зарплаты — по одной на каждое физлицо
				Если ПараметрыСоздания.СоздаватьЗаявкиНаЗарплату Тогда
					Для Каждого Физлицо Из МассивФизлиц Цикл
						
						Ид = Физлицо["Идентификатор"];
						
						Если АналитикаФизлиц[Ид] = Неопределено Тогда
							ОтменитьТранзакцию();
							Возврат ОтветОшибка(400,
								"Не найдено соответствие аналитики для физлица: " + Физлицо["Наименование"]);
						КонецЕсли;
						
						РезультатПоискаКА = НайтиКонтрагентаИСчет(
							Физлицо["Наименование"],
							Физлицо["НомерЛицевогоСчета"]
						);
						Если Не РезультатПоискаКА.Успех Тогда
							ОтменитьТранзакцию();
							Возврат ОтветОшибка(400, РезультатПоискаКА.Ошибка);
						КонецЕсли;
						
						НазначениеФизлица = СтрЗаменить(НазначениеЗарплата, "[ФИО]", Физлицо["Наименование"]);
						НазначениеФизлица = СтрЗаменить(НазначениеФизлица,  "[НомерЛицевогоСчета]", Физлицо["НомерЛицевогоСчета"]);
						
						ЗаявкаЗарплатаФизлица = СоздатьЗаявкуЗарплатаПрямая(
							Организация,
							НастройкаЗарплата,
							Физлицо["Сумма"],
							АналитикаФизлиц[Ид],
							РезультатПоискаКА.Контрагент,
							РезультатПоискаКА.БанковскийСчет,
							НомерВедомости,
							ДатаВедомости,
							НазначениеФизлица,
							ПараметрыСоздания
						);
						МассивЗаявок.Добавить(ОписаниеЗаявки(ЗаявкаЗарплатаФизлица, "Зарплата"));
						
					КонецЦикла;
				КонецЕсли;	
				
				// НДФЛ — одна заявка на всю сумму, аналитика в ТЧ гкм_АналитикаПлатежа
				Если ПараметрыСоздания.СоздаватьЗаявкиНаНДФЛ Тогда
					ЗаявкаНДФЛ = СоздатьЗаявкуНДФЛ(
						Организация,
						НастройкаНДФЛ,
						СуммаНДФЛ,
						АналитикаПлатежаНДФЛ,
						НомерВедомости,
						ДатаВедомости,
						НазначениеНДФЛ,
						ПараметрыСоздания
					);
					МассивЗаявок.Добавить(ОписаниеЗаявки(ЗаявкаНДФЛ, "НДФЛ"));
				КонецЕсли;
				
				Если ПараметрыСоздания.РежимТестирования Тогда 
					ОтменитьТранзакцию();
				Иначе                
					ЗафиксироватьТранзакцию();
				КонецЕсли;
				
			Исключение
				ОтменитьТранзакцию();
				ВызватьИсключение;
			КонецПопытки;
			
		Иначе
			
			// --- Режим банковского проекта ---
			СуммаЗарплата = 0;
			СуммаЗарплата = 0;
			Для Каждого Физлицо Из МассивФизлиц Цикл
				СуммаЗарплата = СуммаЗарплата + Физлицо["Сумма"];
			КонецЦикла;
			
			СуммаНДФЛ = 0;
			Для Каждого Физлицо Из МассивФизлицНДФЛ Цикл
				СуммаНДФЛ = СуммаНДФЛ + Физлицо["Сумма"];
			КонецЦикла;
			
			АналитикаПлатежаЗарплата = СформироватьАналитикуПлатежа(МассивФизлиц);
			АналитикаПлатежаНДФЛ     = СформироватьАналитикуПлатежа(МассивФизлицНДФЛ);
			
			СуммаАналитики = 0;
			Для Каждого СтрАналитики Из АналитикаПлатежаЗарплата Цикл
				СуммаАналитики = СуммаАналитики + СтрАналитики.Сумма;
			КонецЦикла;
			Если Окр(СуммаАналитики, 2) <> Окр(СуммаЗарплата, 2) Тогда
				Возврат ОтветОшибка(400,
					"Сумма по аналитике платежа (зарплата): " + СуммаАналитики
					+ " не совпадает с суммой ведомости: " + СуммаЗарплата
					+ ". Возможно, не все физлица сопоставлены с подразделениями.");
			КонецЕсли;
			
			СуммаАналитикиНДФЛ = 0;
			Для Каждого СтрАналитики Из АналитикаПлатежаНДФЛ Цикл
				СуммаАналитикиНДФЛ = СуммаАналитикиНДФЛ + СтрАналитики.Сумма;
			КонецЦикла;
			Если Окр(СуммаАналитикиНДФЛ, 2) <> Окр(СуммаНДФЛ, 2) Тогда
				Возврат ОтветОшибка(400,
					"Сумма по аналитике платежа (НДФЛ): " + СуммаАналитикиНДФЛ
					+ " не совпадает с суммой НДФЛ: " + СуммаНДФЛ
					+ ". Возможно, не все физлица сопоставлены с подразделениями.");
			КонецЕсли;
			
			// Создаём обе заявки в одной транзакции
			НачатьТранзакцию();
			Попытка
				
				Если ПараметрыСоздания.СоздаватьЗаявкиНаЗарплату Тогда
					ЗаявкаЗарплата = СоздатьЗаявкуЗарплата(
						Организация,
						НастройкаЗарплата,
						СуммаЗарплата,
						АналитикаПлатежаЗарплата,
						НомерВедомости,
						ДатаВедомости,
						НазначениеЗарплата,
						ПараметрыСоздания
					);
				КонецЕсли;
				
				Если ПараметрыСоздания.СоздаватьЗаявкиНаНДФЛ Тогда
					ЗаявкаНДФЛ = СоздатьЗаявкуНДФЛ(
						Организация,
						НастройкаНДФЛ,
						СуммаНДФЛ,
						АналитикаПлатежаНДФЛ,
						НомерВедомости,
						ДатаВедомости,
						НазначениеНДФЛ,
						ПараметрыСоздания
					); 
				КонецЕсли;
				
				Если ПараметрыСоздания.РежимТестирования Тогда 
					ОтменитьТранзакцию();
				Иначе                
					ЗафиксироватьТранзакцию();
				КонецЕсли;
				
			Исключение
				ОтменитьТранзакцию();
				ВызватьИсключение;
			КонецПопытки;
			
			Если ПараметрыСоздания.СоздаватьЗаявкиНаЗарплату И ЗаявкаЗарплата <> Неопределено Тогда
				МассивЗаявок.Добавить(ОписаниеЗаявки(ЗаявкаЗарплата, "Зарплата"));
			КонецЕсли;
			Если ПараметрыСоздания.СоздаватьЗаявкиНаНДФЛ И ЗаявкаНДФЛ <> Неопределено Тогда
				МассивЗаявок.Добавить(ОписаниеЗаявки(ЗаявкаНДФЛ, "НДФЛ"));
			КонецЕсли;
			
		КонецЕсли;
		
		Результат = Новый Структура("Заявки", МассивЗаявок);
		Ответ.УстановитьТелоИзСтроки(
			гкм_ОбменДанными.ЗначениеВСтрокуJSON(Результат), КодировкаТекста.UTF8);
		
	Исключение
		
		Ответ = Новый HTTPСервисОтвет(500);
		Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		ОшибкаСтруктура = Новый Структура("Ошибка",
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Ответ.УстановитьТелоИзСтроки(
			гкм_ОбменДанными.ЗначениеВСтрокуJSON(ОшибкаСтруктура), КодировкаТекста.UTF8);
		
	КонецПопытки;
	
	Возврат Ответ;
	
КонецФункции

// Создаёт заявку на расходование ДС по зарплате (банковский проект).
//
// Параметры:
//  Организация       - СправочникСсылка.Организации
//  НастройкаЗарплата - СтрокаТаблицыЗначений - строка настроек из регистра (тип Зарплата)
//  СуммаЗарплата     - Число
//  АналитикаПлатежа  - Массив из Структур (Подразделение, ЦентрРасходов, ОбъектСтроительства, Сумма)
//  НомерВедомости    - Строка
//  ДатаВедомости     - Дата
//  НазначениеПлатежа - Строка
//  ПараметрыСоздания  - Структура (ПроводитьДокумент, СоздаватьЗаявкуНаЗарплату, СоздаватьЗаявкуНаНДФЛ, ...)
//
// Возвращаемое значение:
//   ДокументСсылка.ЗаявкаНаРасходованиеДенежныхСредств
//
Функция СоздатьЗаявкуЗарплата(Организация,
							НастройкаЗарплата,
							СуммаЗарплата,
							АналитикаПлатежа,
							НомерВедомости,
							ДатаВедомости,
							НазначениеПлатежа,
							ПараметрыСоздания)
	
	Заявка = Документы.ЗаявкаНаРасходованиеДенежныхСредств.СоздатьДокумент();
	Заявка.Заполнить(Неопределено);
	Заявка.Дата                            	= ТекущаяДатаСеанса();
	Заявка.ЖелательнаяДатаПлатежа			= ДатаВедомости;
	Заявка.ДатаПлатежа 						= ДатаВедомости;
	Заявка.ПриоритетОплаты					= Справочники.ПриоритетыОплаты.ПолучитьВысшийПриоритет();
	Заявка.КтоЗаявил						= Пользователи.ТекущийПользователь();
	Заявка.Организация                     	= Организация;
	Заявка.Статус                          	= Перечисления.СтатусыЗаявокНаРасходованиеДенежныхСредств.НеСогласована;
	Заявка.ХозяйственнаяОперация           	= Перечисления.ХозяйственныеОперации.ВыплатаЗарплаты;
	Заявка.ХозяйственнаяОперацияПоЗарплате 	= Перечисления.ХозяйственныеОперации.ВыплатаЗарплатыПоЗарплатномуПроекту;
	Заявка.ФормаОплатыБезналичная         	= Истина;
	Заявка.ФормаОплатыЗаявки 				= Перечисления.ФормыОплаты.Безналичная;
	Заявка.СуммаДокумента                  	= СуммаЗарплата;
	Заявка.Валюта                          	= ЗначениеНастроекПовтИсп.ВалютаРегламентированногоУчетаОрганизации(Организация);
	Заявка.Контрагент                      	= НастройкаЗарплата.Контрагент;
	Заявка.БанковскийСчетКонтрагента       	= НастройкаЗарплата.БанковскийСчетКонтрагента;
	Заявка.БанковскийСчет                  	= НастройкаЗарплата.БанковскийСчетОрганизации;
	Заявка.СтатьяДвиженияДенежныхСредств   	= НастройкаЗарплата.СтатьяДДС;
	Заявка.Подразделение                   	= НастройкаЗарплата.Подразделение;
	Заявка.гкм_ЦентрРасходов               	= НастройкаЗарплата.гкм_ЦентрРасходов;
	Заявка.гкм_ОбъектСтроительства         	= НастройкаЗарплата.гкм_ОбъектСтроительства;
	Заявка.НазначениеПлатежа               	= НазначениеПлатежа;
	Заявка.НомерВедомостиНаВыплатуЗарплаты 	= НомерВедомости;
	Заявка.ДатаВедомостиНаВыплатуЗарплаты  	= ДатаВедомости;
	
	// Заполняем аналитику платежа
	Для Каждого СтрАналитики Из АналитикаПлатежа Цикл
		НоваяСтрока                     = Заявка.гкм_АналитикаПлатежа.Добавить();
		НоваяСтрока.Подразделение       = СтрАналитики.Подразделение;
		НоваяСтрока.ЦентрРасходов       = СтрАналитики.ЦентрРасходов;
		НоваяСтрока.ОбъектСтроительства = СтрАналитики.ОбъектСтроительства;
		НоваяСтрока.Сумма               = СтрАналитики.Сумма;
	КонецЦикла;
	
	РежимЗаписи = ?(ПараметрыСоздания.ПроводитьДокумент,
		РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись);
	Заявка.Записать(РежимЗаписи);
	
	Возврат Заявка;
	
КонецФункции
 
// Создаёт заявку на расходование ДС по НДФЛ (перечисление в бюджет).
//
// Параметры:
//  Организация       - СправочникСсылка.Организации
//  НастройкаНДФЛ     - СтрокаТаблицыЗначений - строка настроек из регистра (тип НДФЛ)
//  СуммаНДФЛ         - Число
//  АналитикаПлатежа  - Массив из Структур (Подразделение, ЦентрРасходов, ОбъектСтроительства, Сумма)
//  НомерВедомости    - Строка
//  ДатаВедомости     - Дата
//  НазначениеПлатежа - Строка
//  ПараметрыСоздания  - Структура (ПроводитьДокумент, СоздаватьЗаявкуНаЗарплату, СоздаватьЗаявкуНаНДФЛ, ...)
//
// Возвращаемое значение:
//   ДокументСсылка.ЗаявкаНаРасходованиеДенежныхСредств
//
Функция СоздатьЗаявкуНДФЛ(Организация,
