// Загружает аналитику физлиц (Подразделение, ЦентрРасходов, ОбъектСтроительства) одним запросом.
// Используется только в режиме прямой выплаты.
//
// Параметры:
//  МассивФизлиц - Массив из Соответствий с ключом "Идентификатор"
//
// Возвращаемое значение:
//   Структура - ключи: Идентификатор (Строка),
//               значения: Структура (Подразделение, ЦентрРасходов, ОбъектСтроительства)
//
Функция ПолучитьАналитикуФизлицИзРегистра(МассивФизлиц)
	
	СписокИд = Новый Массив;
	Для Каждого Физлицо Из МассивФизлиц Цикл
		СписокИд.Добавить(Физлицо["Идентификатор"]);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Соответствие.ИдентификаторФизлицаЗУП КАК Идентификатор,
		|	Соответствие.Подразделение            КАК Подразделение,
		|	Соответствие.ЦентрРасходов            КАК ЦентрРасходов,
		|	Соответствие.ОбъектСтроительства      КАК ОбъектСтроительства
		|ИЗ
		|	РегистрСведений.гкм_СоответствиеДанныхФизлицЗУП КАК Соответствие
		|ГДЕ
		|	Соответствие.ИдентификаторФизлицаЗУП В (&СписокИд)";
	Запрос.УстановитьПараметр("СписокИд", СписокИд);
	
	ТаблицаРезультата = Запрос.Выполнить().Выгрузить();
	
	АналитикаФизлиц = Новый Соответствие;
	Для Каждого Строка Из ТаблицаРезультата Цикл
		Аналитика = Новый Структура;
		Аналитика.Вставить("Подразделение",       Строка.Подразделение);
		Аналитика.Вставить("ЦентрРасходов",       Строка.ЦентрРасходов);
		Аналитика.Вставить("ОбъектСтроительства", Строка.ОбъектСтроительства);
		АналитикаФизлиц.Вставить(Строка.Идентификатор, Аналитика);
	КонецЦикла;
	
	Возврат АналитикаФизлиц;
	
КонецФункции

// Ищет контрагента по наименованию физлица и его банковский счёт по номеру лицевого счёта.
//
// Параметры:
//  НаименованиеФизлица - Строка
//  НомерЛицевогоСчета  - Строка
//
// Возвращаемое значение:
//   Структура:
//     * Успех          - Булево
//     * Ошибка         - Строка
//     * Контрагент     - СправочникСсылка.Контрагенты
//     * БанковскийСчет - СправочникСсылка.БанковскиеСчетаКонтрагентов
//
Функция НайтиКонтрагентаИСчет(НаименованиеФизлица, НомерЛицевогоСчета)
	
	Результат = Новый Структура("Успех, Ошибка, Контрагент, БанковскийСчет",
		Ложь, "", Неопределено, Неопределено);
	
	ЗапросКА = Новый Запрос;
	ЗапросКА.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Контрагенты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Наименование = &Наименование
		|	И НЕ Контрагенты.ПометкаУдаления";
	ЗапросКА.УстановитьПараметр("Наименование", НаименованиеФизлица);
	РезКА = ЗапросКА.Выполнить().Выгрузить();
	
	Если РезКА.Количество() = 0 Тогда
		Результат.Ошибка = "Контрагент не найден по наименованию: """ + НаименованиеФизлица + """";
		Возврат Результат;
	КонецЕсли;
	
	Контрагент = РезКА[0].Ссылка;
	
	ЗапросСчет = Новый Запрос;
	ЗапросСчет.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	БанковскиеСчета.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.БанковскиеСчетаКонтрагентов КАК БанковскиеСчета
		|ГДЕ
		|	БанковскиеСчета.Владелец = &Контрагент
		|	И БанковскиеСчета.НомерСчета = &НомерСчета
		|	И НЕ БанковскиеСчета.ПометкаУдаления";
	ЗапросСчет.УстановитьПараметр("Контрагент", Контрагент);
	ЗапросСчет.УстановитьПараметр("НомерСчета", НомерЛицевогоСчета);
	РезСчет = ЗапросСчет.Выполнить().Выгрузить();
	
	Если РезСчет.Количество() = 0 Тогда
		Результат.Ошибка = "Банковский счёт не найден для контрагента """
			+ НаименованиеФизлица + """, номер счёта: " + НомерЛицевогоСчета;
		Возврат Результат;
	КонецЕсли;
	
	Результат.Успех          = Истина;
	Результат.Контрагент     = Контрагент;
	Результат.БанковскийСчет = РезСчет[0].Ссылка;
	
	Возврат Результат;
	
КонецФункции
 
// Формирует массив аналитики платежа, группируя суммы физлиц по аналитике из регистра
// гкм_СоответствиеДанныхФизлицЗУП.
//
// Параметры:
//  МассивФизлиц - Массив из Соответствий с ключами "Идентификатор", "Сумма"
//
// Возвращаемое значение:
//   Массив из Структур - Подразделение, ЦентрРасходов, ОбъектСтроительства, Сумма
//
Функция СформироватьАналитикуПлатежа(МассивФизлиц)
	
	// Строим таблицу значений для параметра запроса
	КС = Новый КвалификаторыСтроки(36);
	КЧ = Новый КвалификаторыЧисла(15, 2);
	
	ТаблицаФизлиц = Новый ТаблицаЗначений;
	ТаблицаФизлиц.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка", КС));
	ТаблицаФизлиц.Колонки.Добавить("Сумма",         Новый ОписаниеТипов("Число", КЧ));
		
	Для Каждого Физлицо Из МассивФизлиц Цикл
		НоваяСтрока               = ТаблицаФизлиц.Добавить();
		НоваяСтрока.Идентификатор = Физлицо["Идентификатор"];
		НоваяСтрока.Сумма         = Физлицо["Сумма"];
	КонецЦикла;                                       
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	 "ВЫБРАТЬ
	 |	ВЫРАЗИТЬ(ТаблицаФизлиц.Идентификатор КАК СТРОКА(36)) КАК Идентификатор,
	 |	ТаблицаФизлиц.Сумма КАК Сумма
	 |ПОМЕСТИТЬ ТаблицаФизлиц
	 |ИЗ
	 |	&ТаблицаФизлиц КАК ТаблицаФизлиц
	 |;
	 |
	 |////////////////////////////////////////////////////////////////////////////////
	 |ВЫБРАТЬ
	 |	СУММА(ТаблицаФизлиц.Сумма) КАК Сумма,
	 |	гкм_СоответствиеДанныхФизлицЗУП.Подразделение КАК Подразделение,
	 |	гкм_СоответствиеДанныхФизлицЗУП.ЦентрРасходов КАК ЦентрРасходов,
	 |	гкм_СоответствиеДанныхФизлицЗУП.ОбъектСтроительства КАК ОбъектСтроительства
	 |ИЗ
	 |	ТаблицаФизлиц КАК ТаблицаФизлиц
	 |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.гкм_СоответствиеДанныхФизлицЗУП КАК гкм_СоответствиеДанныхФизлицЗУП
	 |		ПО ТаблицаФизлиц.Идентификатор = гкм_СоответствиеДанныхФизлицЗУП.ИдентификаторФизлицаЗУП
	 |
	 |СГРУППИРОВАТЬ ПО
	 |	гкм_СоответствиеДанныхФизлицЗУП.ЦентрРасходов,
	 |	гкм_СоответствиеДанныхФизлицЗУП.Подразделение,
	 |	гкм_СоответствиеДанныхФизлицЗУП.ОбъектСтроительства";
	
	Запрос.УстановитьПараметр("ТаблицаФизлиц", ТаблицаФизлиц);
	
	ТаблицаРезультата = Запрос.Выполнить().Выгрузить();
	
	АналитикаПлатежа = Новый Массив;
	Для Каждого Строка Из ТаблицаРезультата Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("Подразделение",       Строка.Подразделение);
		Элемент.Вставить("ЦентрРасходов",       Строка.ЦентрРасходов);
		Элемент.Вставить("ОбъектСтроительства", Строка.ОбъектСтроительства);
		Элемент.Вставить("Сумма",               Строка.Сумма);
		АналитикаПлатежа.Добавить(Элемент);
	КонецЦикла;
	
	Возврат АналитикаПлатежа;
	
КонецФункции
 
// Формирует структуру описания заявки для включения в ответ.
//
// Параметры:
//  ЗаявкаОбъект - ДокументОбъект.ЗаявкаНаРасходованиеДенежныхСредств
//  ТипВыплаты   - Строка ("Зарплата" или "НДФЛ")
//
// Возвращаемое значение:
//   Структура - Номер, Дата, ТипВыплаты, ГУИД, Сумма
//
Функция ОписаниеЗаявки(ЗаявкаОбъект, ТипВыплаты)
	
	Описание = Новый Структура;
	Описание.Вставить("Номер",         ЗаявкаОбъект.Номер);
	Описание.Вставить("Дата",          Формат(ЗаявкаОбъект.Дата, "ДФ=dd.MM.yyyy"));
	Описание.Вставить("ТипВыплаты",    ТипВыплаты);
	Описание.Вставить("ГУИД",          XMLСтрока(ЗаявкаОбъект.Ссылка.УникальныйИдентификатор()));
	Описание.Вставить("Сумма",         ЗаявкаОбъект.СуммаДокумента);
	Описание.Вставить("ОснованиеЗУП",  ЗаявкаОбъект.гкм_ОснованиеЗУП);
	
	Возврат Описание;
	
КонецФункции
 
// Функция - ПроверитьЗаявкиНаРасходДСPOST
// Принимает массив оснований ЗУП, возвращает для каждого номера связанных заявок
Функция ПроверитьЗаявкиНаРасходДСPOST(Запрос)
	
	Попытка
		ДанныеЗапроса = гкм_ОбменДанными.ЗначениеИзСтрокиJSON(
			Запрос.ПолучитьТелоКакСтроку(), Истина);
	Исключение
		Возврат ОтветОшибка(400, "Ошибка разбора JSON");
	КонецПопытки;
	
	Основания = ДанныеЗапроса["Основания"];
	
	Если Основания = Неопределено
		Или ТипЗнч(Основания) <> Тип("Массив")
		Или Основания.Количество() = 0 Тогда
		Возврат ОтветОшибка(400, "Не передан массив 'Основания'");
	КонецЕсли;
	
	// Динамически строим условие СТРНАЙТИ для каждого основания
	УсловияПоиска = Новый Массив;
	Для ИндексОснования = 0 По Основания.Количество() - 1 Цикл
		УсловияПоиска.Добавить(
			"СТРНАЙТИ(Заявка.гкм_ОснованиеЗУП, &Основание" + ИндексОснования + ") > 0");
	КонецЦикла;
	
	ЗапросБД = Новый Запрос;
	ЗапросБД.Текст =
		"ВЫБРАТЬ
		|	Заявка.Номер             КАК Номер,
		|	Заявка.гкм_ОснованиеЗУП КАК ОснованиеЗУП
		|ИЗ
		|	Документ.ЗаявкаНаРасходованиеДенежныхСредств КАК Заявка
		|ГДЕ
		|	НЕ Заявка.ПометкаУдаления
		|	И (" + СтрСоединить(УсловияПоиска, " ИЛИ ") + ")
		|УПОРЯДОЧИТЬ ПО
		|	Заявка.Номер";
	
	Для ИндексОснования = 0 По Основания.Количество() - 1 Цикл
		ЗапросБД.УстановитьПараметр("Основание" + ИндексОснования, Основания[ИндексОснования]);
	КонецЦикла;
	
	ТаблицаЗаявок = ЗапросБД.Выполнить().Выгрузить();
	
	// Группируем номера по основанию через СтрНайти
	СловарьРезультатов = Новый Соответствие;
	Для Каждого Строка Из ТаблицаЗаявок Цикл
		Для Каждого Основание Из Основания Цикл
			Если СтрНайти(Строка.ОснованиеЗУП, Основание) > 0 Тогда
				СписокНомеров = СловарьРезультатов[Основание];
				Если СписокНомеров = Неопределено Тогда
					СписокНомеров = Новый Массив;
					СловарьРезультатов.Вставить(Основание, СписокНомеров);
				КонецЕсли;
				СписокНомеров.Добавить(Строка.Номер);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	// Формируем ответ - массив структур {ОснованиеЗУП, Номера}
	Результаты = Новый Массив;
	Для Каждого Основание Из Основания Цикл
		ЗаписьРезультата = Новый Структура;
		ЗаписьРезультата.Вставить("ОснованиеЗУП", Основание);
		СписокНомеров = СловарьРезультатов[Основание];
		ЗаписьРезультата.Вставить("Номера",
			?(СписокНомеров <> Неопределено, СписокНомеров, Новый Массив));
		Результаты.Добавить(ЗаписьРезультата);
	КонецЦикла;
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.УстановитьТелоИзСтроки(
		гкм_ОбменДанными.ЗначениеВСтрокуJSON(Новый Структура("Результаты", Результаты)),
		"UTF-8");
	Возврат Ответ;
	
КонецФункции

// Проверяет наличие уже созданных заявок по данному основанию ЗУП.
// Проверяются только те типы выплат, флаги которых переданы как Истина.
//
// Параметры:
//  ОснованиеЗУП        - Строка - навигационная ссылка на документ ЗУП
//  ПроверятьЗарплату   - Булево
//  ПроверятьНДФЛ       - Булево
//  ПроверятьВзносыЕТ   - Булево
//  ПроверятьФСС        - Булево
//
// Возвращаемое значение:
//  Строка - текст ошибки если дубли найдены, иначе пустая строка
Функция ПроверитьДублиЗаявок(ОснованиеЗУП, ПроверятьЗарплату, ПроверятьНДФЛ,
	ПроверятьВзносыЕТ, ПроверятьФСС)
	
	Если Не ЗначениеЗаполнено(ОснованиеЗУП) Тогда
		Возврат "";
	КонецЕсли;
	
	// Собираем список хозяйственных операций для проверки
	ХозОперации = Новый Массив;
	Если ПроверятьЗарплату Тогда
		ХозОперации.Добавить(Перечисления.ХозяйственныеОперации.ВыплатаЗарплаты);
	КонецЕсли;
	Если ПроверятьНДФЛ Или ПроверятьВзносыЕТ Или ПроверятьФСС Тогда
		ХозОперации.Добавить(Перечисления.ХозяйственныеОперации.ПеречислениеВБюджет);
	КонецЕсли;
	
	Если ХозОперации.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Заявка.Номер              КАК Номер,
		|	Заявка.ХозяйственнаяОперация КАК ХозяйственнаяОперация
		|ИЗ
		|	Документ.ЗаявкаНаРасходованиеДенежныхСредств КАК Заявка
		|ГДЕ
		|	Заявка.гкм_ОснованиеЗУП = &ОснованиеЗУП
		|	И Заявка.ХозяйственнаяОперация В (&ХозОперации)
		|	И НЕ Заявка.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ОснованиеЗУП", ОснованиеЗУП);
	Запрос.УстановитьПараметр("ХозОперации",  ХозОперации);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если Результат.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	// Формируем понятное сообщение об ошибке
	НайденныеЗаявки = Новый Массив;
	Для Каждого Строка Из Результат Цикл
		Если Строка.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВыплатаЗарплаты
			И ПроверятьЗарплату Тогда
			НайденныеЗаявки.Добавить("№" + Строка.Номер + " (Зарплата)");
		ИначеЕсли Строка.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеречислениеВБюджет Тогда
			Если ПроверятьНДФЛ Тогда
				НайденныеЗаявки.Добавить("№" + Строка.Номер + " (НДФЛ/Взносы)");
			ИначеЕсли ПроверятьВзносыЕТ Или ПроверятьФСС Тогда
				НайденныеЗаявки.Добавить("№" + Строка.Номер + " (Взносы)");
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если НайденныеЗаявки.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат "По данному документу уже существуют заявки: "
		+ СтрСоединить(НайденныеЗаявки, ", ")
		+ ". Повторное создание не допускается.";
	
КонецФункции

// Формирует HTTP-ответ с ошибкой заданного кода.
//
// Параметры:
//  КодHTTP     - Число  - HTTP-код состояния (400, 500 и т.д.)
//  ТекстОшибки - Строка - Описание ошибки
//
// Возвращаемое значение:
//   HTTPСервисОтвет
//
Функция ОтветОшибка(КодHTTP, ТекстОшибки)
	
	ОтветОшибка = Новый HTTPСервисОтвет(КодHTTP);
	ОтветОшибка.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	ОтветОшибка.УстановитьТелоИзСтроки(
		гкм_ОбменДанными.ЗначениеВСтрокуJSON(Новый Структура("Ошибка", ТекстОшибки)),
		КодировкаТекста.UTF8);
	
	Возврат ОтветОшибка;
	
КонецФункции

// --> ГКМ: