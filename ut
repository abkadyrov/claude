	ДанныеОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Организация, "ИНН, КПП, НаименованиеСокращенное");
						
	Заявка = Документы.ЗаявкаНаРасходованиеДенежныхСредств.СоздатьДокумент();
	Заявка.Заполнить(Неопределено);
    Заявка.Дата                            	= ТекущаяДатаСеанса();
	Заявка.ЖелательнаяДатаПлатежа			= ДатаВедомости;
	Заявка.ДатаПлатежа 						= ДатаВедомости;
	Заявка.ПриоритетОплаты					= Справочники.ПриоритетыОплаты.ПолучитьВысшийПриоритет();
	Заявка.КтоЗаявил						= Пользователи.ТекущийПользователь();
	Заявка.Организация                     	= Организация;
	Заявка.Статус                          	= Перечисления.СтатусыЗаявокНаРасходованиеДенежныхСредств.НеСогласована;
	Заявка.ХозяйственнаяОперация           	= Перечисления.ХозяйственныеОперации.ПеречислениеВБюджет;
	Заявка.ФормаОплатыБезналичная          	= Истина;
	Заявка.ФормаОплатыЗаявки 				= Перечисления.ФормыОплаты.Безналичная;
	Заявка.СуммаДокумента                  	= СуммаНДФЛ;
	Заявка.Валюта                          	= ЗначениеНастроекПовтИсп.ВалютаРегламентированногоУчетаОрганизации(Организация);
	Заявка.Контрагент                      	= НастройкаНДФЛ.Контрагент;
	Заявка.БанковскийСчетКонтрагента       	= НастройкаНДФЛ.БанковскийСчетКонтрагента;
	Заявка.БанковскийСчет                  	= НастройкаНДФЛ.БанковскийСчетОрганизации;
	Заявка.СтатьяДвиженияДенежныхСредств   	= НастройкаНДФЛ.СтатьяДДС;
	Заявка.Подразделение                   	= НастройкаНДФЛ.Подразделение;
	Заявка.гкм_ЦентрРасходов               	= НастройкаНДФЛ.гкм_ЦентрРасходов;
	Заявка.гкм_ОбъектСтроительства         	= НастройкаНДФЛ.гкм_ОбъектСтроительства;
	Заявка.НазначениеПлатежа               	= НазначениеПлатежа;
	Заявка.НомерВедомостиНаВыплатуЗарплаты 	= НомерВедомости;
	Заявка.ДатаВедомостиНаВыплатуЗарплаты  	= ДатаВедомости;
	Заявка.ПеречислениеВБюджет            	= Истина;
	Заявка.ТипНалога                       	= НастройкаНДФЛ.ТипНалога;
	Заявка.КодБК                           	= НастройкаНДФЛ.КодБК;
	Заявка.КодОКАТО 						= СтроковыеФункцииКлиентСервер.ДополнитьСтроку("0", 11, " ", "Справа");
	Заявка.СтатусСоставителя 				= "01";
	Заявка.ПоказательОснования				= "0";
	Заявка.ПоказательПериода 				= "0";
	Заявка.ПоказательНомера 				= "0";
	Заявка.ПоказательДаты 					= "0"; 
	Заявка.ИННПлательщика 					= ДанныеОрганизации.ИНН;
	Заявка.КПППлательщика 					= ДанныеОрганизации.КПП;
	Заявка.ТекстПлательщика 				= ДанныеОрганизации.НаименованиеСокращенное;
	
	// Заполняем расшифровку платежа
	СтрокаРасшифровки = Заявка.РасшифровкаПлатежа.Добавить();
	СтрокаРасшифровки.СтатьяДвиженияДенежныхСредств = НастройкаНДФЛ.СтатьяДДС;
	СтрокаРасшифровки.Сумма 						= СуммаНДФЛ;
	СтрокаРасшифровки.СуммаВзаиморасчетов 			= СуммаНДФЛ;
	СтрокаРасшифровки.ВалютаВзаиморасчетов 			= Заявка.Валюта;
	СтрокаРасшифровки.КурсЧислительВзаиморасчетов 	= 1;
	СтрокаРасшифровки.КурсЗнаменательВзаиморасчетов = 1;
	
	// Заполняем аналитику платежа
	Для Каждого СтрАналитики Из АналитикаПлатежа Цикл
		НоваяСтрока                     = Заявка.гкм_АналитикаПлатежа.Добавить();
		НоваяСтрока.Подразделение       = СтрАналитики.Подразделение;
		НоваяСтрока.ЦентрРасходов       = СтрАналитики.ЦентрРасходов;
		НоваяСтрока.ОбъектСтроительства = СтрАналитики.ОбъектСтроительства;
		НоваяСтрока.Сумма               = СтрАналитики.Сумма;
	КонецЦикла;

	Заявка.Записать(РежимЗаписиДокумента.Запись);
	
	Возврат Заявка.Ссылка;
	
КонецФункции
 
// Формирует массив аналитики платежа, группируя суммы физлиц по аналитике из регистра
// гкм_СоответствиеДанныхФизлицЗУП.
//
// Параметры:
//  МассивФизлиц - Массив из Соответствий с ключами "Идентификатор", "Сумма"
//
// Возвращаемое значение:
//   Массив из Структур - Подразделение, ЦентрРасходов, ОбъектСтроительства, Сумма
//
Функция СформироватьАналитикуПлатежа(МассивФизлиц)
	
	// Строим таблицу значений для параметра запроса
	КЧ = Новый КвалификаторыЧисла(15, 2);
	КС = Новый КвалификаторыСтроки(36);
	
	ТаблицаФизлиц = Новый ТаблицаЗначений;
	ТаблицаФизлиц.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка", КЧ));
	ТаблицаФизлиц.Колонки.Добавить("Сумма",         Новый ОписаниеТипов("Число", КС));
		
	Для Каждого Физлицо Из МассивФизлиц Цикл
		НоваяСтрока               = ТаблицаФизлиц.Добавить();
		НоваяСтрока.Идентификатор = Физлицо["Идентификатор"];
		НоваяСтрока.Сумма         = Физлицо["Сумма"];
	КонецЦикла;                                       
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	 "ВЫБРАТЬ
	 |	ВЫРАЗИТЬ(ТаблицаФизлиц.Идентификатор КАК СТРОКА(36)) КАК Идентификатор,
	 |	ТаблицаФизлиц.Сумма КАК Сумма
	 |ПОМЕСТИТЬ ТаблицаФизлиц
	 |ИЗ
	 |	&ТаблицаФизлиц КАК ТаблицаФизлиц
	 |;
	 |
	 |////////////////////////////////////////////////////////////////////////////////
	 |ВЫБРАТЬ
	 |	СУММА(ТаблицаФизлиц.Сумма) КАК Сумма,
	 |	гкм_СоответствиеДанныхФизлицЗУП.Подразделение КАК Подразделение,
	 |	гкм_СоответствиеДанныхФизлицЗУП.ЦентрРасходов КАК ЦентрРасходов,
	 |	гкм_СоответствиеДанныхФизлицЗУП.ОбъектСтроительства КАК ОбъектСтроительства
	 |ИЗ
	 |	ТаблицаФизлиц КАК ТаблицаФизлиц
	 |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.гкм_СоответствиеДанныхФизлицЗУП КАК гкм_СоответствиеДанныхФизлицЗУП
	 |		ПО ТаблицаФизлиц.Идентификатор = гкм_СоответствиеДанныхФизлицЗУП.ИдентификаторФизлицаЗУП
	 |
	 |СГРУППИРОВАТЬ ПО
	 |	гкм_СоответствиеДанныхФизлицЗУП.ЦентрРасходов,
	 |	гкм_СоответствиеДанныхФизлицЗУП.Подразделение,
	 |	гкм_СоответствиеДанныхФизлицЗУП.ОбъектСтроительства";
	
	Запрос.УстановитьПараметр("ТаблицаФизлиц", ТаблицаФизлиц);
	
	ТаблицаРезультата = Запрос.Выполнить().Выгрузить();
	
	АналитикаПлатежа = Новый Массив;
	Для Каждого Строка Из ТаблицаРезультата Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("Подразделение",       Строка.Подразделение);
		Элемент.Вставить("ЦентрРасходов",       Строка.ЦентрРасходов);
		Элемент.Вставить("ОбъектСтроительства", Строка.ОбъектСтроительства);
		Элемент.Вставить("Сумма",               Строка.Сумма);
		АналитикаПлатежа.Добавить(Элемент);
	КонецЦикла;
	
	Возврат АналитикаПлатежа;
	
КонецФункции
 
// Формирует структуру описания заявки для включения в ответ.
//
// Параметры:
//  ЗаявкаСсылка - ДокументСсылка.ЗаявкаНаРасходованиеДенежныхСредств
//  ТипВыплаты   - Строка ("Зарплата" или "НДФЛ")
//
// Возвращаемое значение:
//   Структура - Номер, Дата, ТипВыплаты, ГУИД
//
Функция ОписаниеЗаявки(ЗаявкаСсылка, ТипВыплаты)
	
	Описание = Новый Структура;
	Описание.Вставить("Номер",      ЗаявкаСсылка.Номер);
	Описание.Вставить("Дата",       Формат(ЗаявкаСсылка.Дата, "ДФ=dd.MM.yyyy"));
	Описание.Вставить("ТипВыплаты", ТипВыплаты);
	Описание.Вставить("ГУИД",       XMLСтрока(ЗаявкаСсылка.УникальныйИдентификатор()));
	
	Возврат Описание;
	
КонецФункции
 
// Формирует HTTP-ответ с ошибкой заданного кода.
//
// Параметры:
//  КодHTTP     - Число  - HTTP-код состояния (400, 500 и т.д.)
//  ТекстОшибки - Строка - Описание ошибки
//
// Возвращаемое значение:
//   HTTPСервисОтвет
//
Функция ОтветОшибка(КодHTTP, ТекстОшибки)
	
	ОтветОшб = Новый HTTPСервисОтвет(КодHTTP);
	ОтветОшб.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	ОтветОшб.УстановитьТелоИзСтроки(
		гкм_ОбменДанными.ЗначениеВСтрокуJSON(Новый Структура("Ошибка", ТекстОшибки)),
		КодировкаТекста.UTF8);
	
	Возврат ОтветОшб;
	
КонецФункции
