	Заявка.Организация                     	= Организация;
	Заявка.Статус                          	= Перечисления.СтатусыЗаявокНаРасходованиеДенежныхСредств.НеСогласована;
	Заявка.ХозяйственнаяОперация           	= Перечисления.ХозяйственныеОперации.ПеречислениеВБюджет;
	Заявка.ФормаОплатыБезналичная          	= Истина;
	Заявка.ФормаОплатыЗаявки 				= Перечисления.ФормыОплаты.Безналичная;
	Заявка.СуммаДокумента                  	= СуммаНДФЛ;
	Заявка.Валюта                          	= ЗначениеНастроекПовтИсп.ВалютаРегламентированногоУчетаОрганизации(Организация);
	Заявка.Контрагент                      	= НастройкаНДФЛ.Контрагент;
	Заявка.БанковскийСчетКонтрагента       	= НастройкаНДФЛ.БанковскийСчетКонтрагента;
	Заявка.БанковскийСчет                  	= НастройкаНДФЛ.БанковскийСчетОрганизации;
	Заявка.СтатьяДвиженияДенежныхСредств   	= НастройкаНДФЛ.СтатьяДДС;
	Заявка.Подразделение                   	= НастройкаНДФЛ.Подразделение;
	Заявка.гкм_ЦентрРасходов               	= НастройкаНДФЛ.гкм_ЦентрРасходов;
	Заявка.гкм_ОбъектСтроительства         	= НастройкаНДФЛ.гкм_ОбъектСтроительства;
	Заявка.НазначениеПлатежа               	= НазначениеПлатежа;
	Заявка.НомерВедомостиНаВыплатуЗарплаты 	= НомерВедомости;
	Заявка.ДатаВедомостиНаВыплатуЗарплаты  	= ДатаВедомости;
	Заявка.ПеречислениеВБюджет            	= Истина;
	Заявка.ТипНалога                       	= НастройкаНДФЛ.ТипНалога;
	Заявка.КодБК                           	= НастройкаНДФЛ.КодБК;
	Заявка.КодОКАТО 						= СтроковыеФункцииКлиентСервер.ДополнитьСтроку("0", 11, " ", "Справа");
	Заявка.СтатусСоставителя 				= "01";
	Заявка.ПоказательОснования				= "0";
	Заявка.ПоказательПериода 				= "0";
	Заявка.ПоказательНомера 				= "0";
	Заявка.ПоказательДаты 					= "0"; 
	Заявка.ИННПлательщика 					= ДанныеОрганизации.ИНН;
	Заявка.КПППлательщика 					= ДанныеОрганизации.КПП;
	Заявка.ТекстПлательщика 				= ДанныеОрганизации.НаименованиеСокращенное;
	
	// Заполняем расшифровку платежа
	СтрокаРасшифровки = Заявка.РасшифровкаПлатежа.Добавить();
	СтрокаРасшифровки.СтатьяДвиженияДенежныхСредств = НастройкаНДФЛ.СтатьяДДС;
	СтрокаРасшифровки.Сумма 						= СуммаНДФЛ;
	СтрокаРасшифровки.СуммаВзаиморасчетов 			= СуммаНДФЛ;
	СтрокаРасшифровки.ВалютаВзаиморасчетов 			= Заявка.Валюта;
	СтрокаРасшифровки.КурсЧислительВзаиморасчетов 	= 1;
	СтрокаРасшифровки.КурсЗнаменательВзаиморасчетов = 1;
	
	// Заполняем аналитику платежа
	Для Каждого СтрАналитики Из АналитикаПлатежа Цикл
		НоваяСтрока                     = Заявка.гкм_АналитикаПлатежа.Добавить();
		НоваяСтрока.Подразделение       = СтрАналитики.Подразделение;
		НоваяСтрока.ЦентрРасходов       = СтрАналитики.ЦентрРасходов;
		НоваяСтрока.ОбъектСтроительства = СтрАналитики.ОбъектСтроительства;
		НоваяСтрока.Сумма               = СтрАналитики.Сумма;
	КонецЦикла;

	РежимЗаписи = ?(ПараметрыСоздания.ПроводитьДокумент,
		РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись);
	Заявка.Записать(РежимЗаписи);
	
	Возврат Заявка;
	
КонецФункции

