    Заявка.Дата                            	= ТекущаяДатаСеанса();
	Заявка.ЖелательнаяДатаПлатежа			= ДатаВедомости;
	Заявка.ДатаПлатежа 						= ДатаВедомости;
	Заявка.ПриоритетОплаты					= Справочники.ПриоритетыОплаты.ПолучитьВысшийПриоритет();
