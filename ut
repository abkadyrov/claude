Функция ПроверитьСоответствиеЗарплатныхПроектовPOST(Запрос)
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	Попытка
		
		ДанныеЗапроса = гкм_ОбменДанными.ЗначениеИзСтрокиJSON(
			Запрос.ПолучитьТелоКакСтроку(), Истина);
		
		ИдПроекта     = ДанныеЗапроса["ИдентификаторЗарплатногоПроекта"];
		ОрганизацияИНН = ДанныеЗапроса["ОрганизацияИНН"];
		ТипИсточника   = ДанныеЗапроса["ТипИсточника"];
		Если Не ЗначениеЗаполнено(ТипИсточника) Тогда
			ТипИсточника = "Ведомость";
		КонецЕсли;
		
		// Для отражения зарплаты ИдПроекта не нужен
		Если ТипИсточника = "Ведомость" И Не ЗначениеЗаполнено(ИдПроекта) Тогда
			Возврат ОтветОшибка(400, "Отсутствует обязательное поле 'ИдентификаторЗарплатногоПроекта'");
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ОрганизацияИНН) Тогда
			Возврат ОтветОшибка(400, "Отсутствует обязательное поле 'ОрганизацияИНН'");
		КонецЕсли;
		
		// Получаем записи по типам выплат в зависимости от источника
		ЗапросДанных = Новый Запрос;
		
		Если ТипИсточника = "ОтражениеЗарплаты" Тогда
			
			ЗапросДанных.Текст =
				"ВЫБРАТЬ
				|	Настройки.ТипВыплаты                           КАК ТипВыплаты,
				|	Настройки.ЗарплатныйПроект                     КАК ЗарплатныйПроект,
				|	Настройки.Контрагент                           КАК Контрагент,
				|	Настройки.БанковскийСчетКонтрагента            КАК БанковскийСчетКонтрагента,
				|	Настройки.СтатьяДвиженияДенежныхСредств        КАК СтатьяДДС,
				|	Настройки.ТипНалога                            КАК ТипНалога,
				|	Настройки.КодБК                                КАК КодБК,
				|	Настройки.КодОКАТО                             КАК КодОКАТО,
				|	Настройки.СтатусСоставителя                    КАК СтатусСоставителя,
				|	Настройки.ЗарплатныйПроект.Подразделение       КАК Подразделение,
				|	Настройки.ЗарплатныйПроект.ЦентрРасходов       КАК ЦентрРасходов,
				|	Настройки.ЗарплатныйПроект.ОбъектСтроительства КАК ОбъектСтроительства,
				|	Настройки.БанковскийСчетОрганизации                  КАК БанковскийСчетОрганизации,
				|	Настройки.ЗарплатныйПроект.ПрямаяВыплата             КАК ПрямаяВыплата
				|ИЗ
				|	РегистрСведений.гкм_НастройкиЗарплатныхПроектовЗУП КАК Настройки
				|ГДЕ
				|	Настройки.Организация.ИНН = &ИНН
				|	И Настройки.ИдентификаторЗарплатногоПроектаЗУП = """"
				|	И Настройки.ТипВыплаты В (ЗНАЧЕНИЕ(Перечисление.гкм_ТипыВыплатыЗУП.ВзносыПоЕдиномуТарифу),
				|		ЗНАЧЕНИЕ(Перечисление.гкм_ТипыВыплатыЗУП.ФССНесчастныеСлучаи))";
			ЗапросДанных.УстановитьПараметр("ИНН", ОрганизацияИНН);
			
		Иначе
			
			ЗапросДанных.Текст =
				"ВЫБРАТЬ
				|	Настройки.ТипВыплаты                           КАК ТипВыплаты,
				|	Настройки.ЗарплатныйПроект                     КАК ЗарплатныйПроект,
				|	Настройки.Контрагент                           КАК Контрагент,
				|	Настройки.БанковскийСчетКонтрагента            КАК БанковскийСчетКонтрагента,
				|	Настройки.СтатьяДвиженияДенежныхСредств        КАК СтатьяДДС,
				|	Настройки.ТипНалога                            КАК ТипНалога,
				|	Настройки.КодБК                                КАК КодБК,
				|	Настройки.КодОКАТО                             КАК КодОКАТО,
				|	Настройки.СтатусСоставителя                    КАК СтатусСоставителя,
				|	Настройки.ЗарплатныйПроект.Подразделение       КАК Подразделение,
				|	Настройки.ЗарплатныйПроект.ЦентрРасходов       КАК ЦентрРасходов,
				|	Настройки.ЗарплатныйПроект.ОбъектСтроительства КАК ОбъектСтроительства,
				|	Настройки.БанковскийСчетОрганизации                  КАК БанковскийСчетОрганизации,
				|	Настройки.ЗарплатныйПроект.ПрямаяВыплата             КАК ПрямаяВыплата
				|ИЗ
				|	РегистрСведений.гкм_НастройкиЗарплатныхПроектовЗУП КАК Настройки
				|ГДЕ
				|	Настройки.Организация.ИНН = &ИНН
				|	И Настройки.ИдентификаторЗарплатногоПроектаЗУП = &ИдПроекта
				|	И Настройки.ТипВыплаты В (ЗНАЧЕНИЕ(Перечисление.гкм_ТипыВыплатыЗУП.Зарплата),
				|		ЗНАЧЕНИЕ(Перечисление.гкм_ТипыВыплатыЗУП.НДФЛ))";
			ЗапросДанных.УстановитьПараметр("ИНН",       ОрганизацияИНН);
			ЗапросДанных.УстановитьПараметр("ИдПроекта", ИдПроекта);
			
		КонецЕсли;
		
		Выборка = ЗапросДанных.Выполнить().Выгрузить();
		
		// Проект не найден совсем
		Если Выборка.Количество() = 0 Тогда
			Результат = Новый Структура;
			Результат.Вставить("Найден",             Ложь);
			Результат.Вставить("НастройкаВыполнена", Ложь);
			Результат.Вставить("НезаполненныеПоля",  Новый Массив);
			Ответ.УстановитьТелоИзСтроки(
				гкм_ОбменДанными.ЗначениеВСтрокуJSON(Результат),
				КодировкаТекста.UTF8);
			Возврат Ответ;
		КонецЕсли;
		
		НезаполненныеПоля = Новый Массив;
		
		Если ТипИсточника = "ОтражениеЗарплаты" Тогда
			
			// Проверка записи ВзносыПоЕдиномуТарифу
			СтрокаЕТ = Выборка.Найти(Перечисления.гкм_ТипыВыплатыЗУП.ВзносыПоЕдиномуТарифу, "ТипВыплаты");
			Если СтрокаЕТ = Неопределено Тогда
				НезаполненныеПоля.Добавить("ВзносыПоЕдиномуТарифу: запись не найдена");
			Иначе
				Если Не ЗначениеЗаполнено(СтрокаЕТ.ЗарплатныйПроект) Тогда
					НезаполненныеПоля.Добавить("ВзносыПоЕдиномуТарифу: не заполнен Зарплатный проект");
				КонецЕсли;
				Если Не ЗначениеЗаполнено(СтрокаЕТ.Контрагент) Тогда
					НезаполненныеПоля.Добавить("ВзносыПоЕдиномуТарифу: не заполнен Контрагент");
				КонецЕсли;
				Если Не ЗначениеЗаполнено(СтрокаЕТ.БанковскийСчетКонтрагента) Тогда
					НезаполненныеПоля.Добавить("ВзносыПоЕдиномуТарифу: не заполнен Банковский счет контрагента");
				КонецЕсли;
				Если Не ЗначениеЗаполнено(СтрокаЕТ.СтатьяДДС) Тогда
					НезаполненныеПоля.Добавить("ВзносыПоЕдиномуТарифу: не заполнена Статья ДДС");
				КонецЕсли;
				Если Не ЗначениеЗаполнено(СтрокаЕТ.БанковскийСчетОрганизации) Тогда
					НезаполненныеПоля.Добавить("ВзносыПоЕдиномуТарифу: не заполнен Банковский счет организации");
				КонецЕсли;
				Если Не ЗначениеЗаполнено(СтрокаЕТ.КодБК) Тогда
					НезаполненныеПоля.Добавить("ВзносыПоЕдиномуТарифу: не заполнен Код БК");
				КонецЕсли;
				Если Не ЗначениеЗаполнено(СтрокаЕТ.КодОКАТО) Тогда
					НезаполненныеПоля.Добавить("ВзносыПоЕдиномуТарифу: не заполнен Код ОКАТО");
				КонецЕсли;
				Если Не ЗначениеЗаполнено(СтрокаЕТ.СтатусСоставителя) Тогда
					НезаполненныеПоля.Добавить("ВзносыПоЕдиномуТарифу: не заполнен Статус составителя");
				КонецЕсли;
			КонецЕсли;
			
			// Проверка записи ФССНесчастныеСлучаи
			СтрокаФСС = Выборка.Найти(Перечисления.гкм_ТипыВыплатыЗУП.ФССНесчастныеСлучаи, "ТипВыплаты");
			Если СтрокаФСС = Неопределено Тогда
				НезаполненныеПоля.Добавить("ФССНесчастныеСлучаи: запись не найдена");
			Иначе
				Если Не ЗначениеЗаполнено(СтрокаФСС.ЗарплатныйПроект) Тогда
					НезаполненныеПоля.Добавить("ФССНесчастныеСлучаи: не заполнен Зарплатный проект");
				КонецЕсли;
				Если Не ЗначениеЗаполнено(СтрокаФСС.Контрагент) Тогда
					НезаполненныеПоля.Добавить("ФССНесчастныеСлучаи: не заполнен Контрагент");
				КонецЕсли;
				Если Не ЗначениеЗаполнено(СтрокаФСС.БанковскийСчетКонтрагента) Тогда
					НезаполненныеПоля.Добавить("ФССНесчастныеСлучаи: не заполнен Банковский счет контрагента");
				КонецЕсли;
				Если Не ЗначениеЗаполнено(СтрокаФСС.СтатьяДДС) Тогда
					НезаполненныеПоля.Добавить("ФССНесчастныеСлучаи: не заполнена Статья ДДС");
				КонецЕсли;
				Если Не ЗначениеЗаполнено(СтрокаФСС.БанковскийСчетОрганизации) Тогда
					НезаполненныеПоля.Добавить("ФССНесчастныеСлучаи: не заполнен Банковский счет организации");
				КонецЕсли;
				Если Не ЗначениеЗаполнено(СтрокаФСС.КодБК) Тогда
					НезаполненныеПоля.Добавить("ФССНесчастныеСлучаи: не заполнен Код БК");
				КонецЕсли;
				Если Не ЗначениеЗаполнено(СтрокаФСС.КодОКАТО) Тогда
					НезаполненныеПоля.Добавить("ФССНесчастныеСлучаи: не заполнен Код ОКАТО");
				КонецЕсли;
				Если Не ЗначениеЗаполнено(СтрокаФСС.СтатусСоставителя) Тогда
					НезаполненныеПоля.Добавить("ФССНесчастныеСлучаи: не заполнен Статус составителя");
				КонецЕсли;
			КонецЕсли;
			
		Иначе
			
			СтрокаЗарплата = Выборка.Найти(Перечисления.гкм_ТипыВыплатыЗУП.Зарплата, "ТипВыплаты");
			СтрокаНДФЛ     = Выборка.Найти(Перечисления.гкм_ТипыВыплатыЗУП.НДФЛ, "ТипВыплаты");
			
			// Флаг прямой выплаты берём из справочника зарплатных проектов
			ПрямаяВыплата = СтрокаЗарплата <> Неопределено
				И ЗначениеЗаполнено(СтрокаЗарплата.ЗарплатныйПроект)
				И СтрокаЗарплата.ПрямаяВыплата;
			
			// Проверка записи Зарплата
			Если СтрокаЗарплата = Неопределено Тогда
				НезаполненныеПоля.Добавить("Зарплата: запись не найдена");
			Иначе
				Если Не ЗначениеЗаполнено(СтрокаЗарплата.ЗарплатныйПроект) Тогда
					НезаполненныеПоля.Добавить("Зарплата: не заполнен Зарплатный проект");
				Иначе
					Если Не ЗначениеЗаполнено(СтрокаЗарплата.Подразделение) Тогда
						НезаполненныеПоля.Добавить("Зарплата: не заполнено Подразделение");
					КонецЕсли;
					Если Не ЗначениеЗаполнено(СтрокаЗарплата.ЦентрРасходов) Тогда
						НезаполненныеПоля.Добавить("Зарплата: не заполнен Центр расходов");
					КонецЕсли;
					Если Не ЗначениеЗаполнено(СтрокаЗарплата.ОбъектСтроительства) Тогда
						НезаполненныеПоля.Добавить("Зарплата: не заполнен Объект строительства");
					КонецЕсли;
					Если Не ЗначениеЗаполнено(СтрокаЗарплата.БанковскийСчетОрганизации) Тогда
						НезаполненныеПоля.Добавить("Зарплата: не заполнен Банковский счет организации");
					КонецЕсли;
				КонецЕсли;
				Если Не ПрямаяВыплата Тогда
					Если Не ЗначениеЗаполнено(СтрокаЗарплата.Контрагент) Тогда
						НезаполненныеПоля.Добавить("Зарплата: не заполнен Контрагент");
					КонецЕсли;
					Если Не ЗначениеЗаполнено(СтрокаЗарплата.БанковскийСчетКонтрагента) Тогда
						НезаполненныеПоля.Добавить("Зарплата: не заполнен Банковский счет контрагента");
					КонецЕсли;
				КонецЕсли;
				Если Не ЗначениеЗаполнено(СтрокаЗарплата.СтатьяДДС) Тогда
					НезаполненныеПоля.Добавить("Зарплата: не заполнена Статья ДДС");
				КонецЕсли;
			КонецЕсли;
			
			// Проверка записи НДФЛ
			Если СтрокаНДФЛ = Неопределено Тогда
				НезаполненныеПоля.Добавить("НДФЛ: запись не найдена");
			Иначе
				Если Не ЗначениеЗаполнено(СтрокаНДФЛ.ЗарплатныйПроект) Тогда
					НезаполненныеПоля.Добавить("НДФЛ: не заполнен Зарплатный проект");
				Иначе
					Если Не ЗначениеЗаполнено(СтрокаНДФЛ.Подразделение) Тогда
						НезаполненныеПоля.Добавить("НДФЛ: не заполнено Подразделение");
					КонецЕсли;
					Если Не ЗначениеЗаполнено(СтрокаНДФЛ.ЦентрРасходов) Тогда
						НезаполненныеПоля.Добавить("НДФЛ: не заполнен Центр расходов");
					КонецЕсли;
					Если Не ЗначениеЗаполнено(СтрокаНДФЛ.ОбъектСтроительства) Тогда
						НезаполненныеПоля.Добавить("НДФЛ: не заполнен Объект строительства");
					КонецЕсли;
					// БанковскийСчетОрганизации для НДФЛ не обязателен -
					// при незаполненном счёте заявки агрегируются без привязки к счёту
				КонецЕсли;
				Если Не ЗначениеЗаполнено(СтрокаНДФЛ.Контрагент) Тогда
					НезаполненныеПоля.Добавить("НДФЛ: не заполнен Контрагент");
				КонецЕсли;
				Если Не ЗначениеЗаполнено(СтрокаНДФЛ.БанковскийСчетКонтрагента) Тогда
					НезаполненныеПоля.Добавить("НДФЛ: не заполнен Банковский счет контрагента");
				КонецЕсли;
				Если Не ЗначениеЗаполнено(СтрокаНДФЛ.СтатьяДДС) Тогда
					НезаполненныеПоля.Добавить("НДФЛ: не заполнена Статья ДДС");
				КонецЕсли;
				Если Не ЗначениеЗаполнено(СтрокаНДФЛ.ТипНалога) Тогда
					НезаполненныеПоля.Добавить("НДФЛ: не заполнен Тип налога");
				КонецЕсли;
				Если Не ЗначениеЗаполнено(СтрокаНДФЛ.КодБК) Тогда
					НезаполненныеПоля.Добавить("НДФЛ: не заполнен Код БК");
				КонецЕсли;
				Если Не ЗначениеЗаполнено(СтрокаНДФЛ.КодОКАТО) Тогда
					НезаполненныеПоля.Добавить("НДФЛ: не заполнен Код ОКАТО");
				КонецЕсли;
				Если Не ЗначениеЗаполнено(СтрокаНДФЛ.СтатусСоставителя) Тогда
					НезаполненныеПоля.Добавить("НДФЛ: не заполнен Статус составителя");
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		Результат = Новый Структура;
		Результат.Вставить("Найден",             Истина);
		Результат.Вставить("НастройкаВыполнена", НезаполненныеПоля.Количество() = 0);
		Результат.Вставить("НезаполненныеПоля",  НезаполненныеПоля);
		
		Ответ.УстановитьТелоИзСтроки(
			гкм_ОбменДанными.ЗначениеВСтрокуJSON(Результат),
			КодировкаТекста.UTF8);
		
	Исключение
		
		Ответ = Новый HTTPСервисОтвет(500);
		ОшибкаСтруктура = Новый Структура("Ошибка",
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Ответ.УстановитьТелоИзСтроки(
			гкм_ОбменДанными.ЗначениеВСтрокуJSON(ОшибкаСтруктура),
			КодировкаТекста.UTF8);
		
	КонецПопытки;
	
	Возврат Ответ;
	
КонецФункции

Функция ЗаписатьСоответствиеЗарплатныхПроектовPOST(Запрос)
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	Попытка
		
		ДанныеЗапроса = гкм_ОбменДанными.ЗначениеИзСтрокиJSON(
			Запрос.ПолучитьТелоКакСтроку(), Истина);
		
		ИдПроекта    	= ДанныеЗапроса["ИдентификаторЗарплатногоПроекта"];
		Наименование 	= ДанныеЗапроса["Наименование"];
		ОрганизацияИНН	= ДанныеЗапроса["ОрганизацияИНН"];
		ПрямаяВыплата 	= ДанныеЗапроса["ПрямаяВыплата"];
		
		Если Не ЗначениеЗаполнено(ИдПроекта) Тогда
			Ответ = Новый HTTPСервисОтвет(400);
			ОшибкаСтруктура = Новый Структура("Ошибка",
				"Отсутствует обязательное поле 'ИдентификаторЗарплатногоПроекта'");
			Ответ.УстановитьТелоИзСтроки(
				гкм_ОбменДанными.ЗначениеВСтрокуJSON(ОшибкаСтруктура),
				КодировкаТекста.UTF8);
			Возврат Ответ;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ОрганизацияИНН) Тогда
			Ответ = Новый HTTPСервисОтвет(400);
			ОшибкаСтруктура = Новый Структура("Ошибка",
				"Отсутствует обязательное поле 'ОрганизацияИНН'");
			Ответ.УстановитьТелоИзСтроки(
				гкм_ОбменДанными.ЗначениеВСтрокуJSON(ОшибкаСтруктура),
				КодировкаТекста.UTF8);
			Возврат Ответ;
		КонецЕсли;
		
		// Ищем организацию по ИНН
		ЗапросОрг = Новый Запрос;
		ЗапросОрг.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Организации.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.Организации КАК Организации
			|ГДЕ
			|	Организации.ИНН = &ИНН
			|	И НЕ Организации.ПометкаУдаления";
		
		ЗапросОрг.УстановитьПараметр("ИНН", ОрганизацияИНН);
		
		РезультатОрг = ЗапросОрг.Выполнить();
		Если РезультатОрг.Пустой() Тогда
			Ответ = Новый HTTPСервисОтвет(400);
			ОшибкаСтруктура = Новый Структура("Ошибка",
				"Организация не найдена в УТ по ИНН: " + ОрганизацияИНН);
			Ответ.УстановитьТелоИзСтроки(
				гкм_ОбменДанными.ЗначениеВСтрокуJSON(ОшибкаСтруктура),
				КодировкаТекста.UTF8);
			Возврат Ответ;
		КонецЕсли;
		
		Организация = РезультатОрг.Выгрузить()[0].Ссылка;
		
		// Создаём две записи в регистре - Зарплата и НДФЛ
		// Справочник ЗарплатныйПроект оставляем пустым - администратор привяжет вручную
		ТипыВыплат = Новый Массив;
		ТипыВыплат.Добавить(Перечисления.гкм_ТипыВыплатыЗУП.Зарплата);
		ТипыВыплат.Добавить(Перечисления.гкм_ТипыВыплатыЗУП.НДФЛ);
		
		Для Каждого ТипВыплаты Из ТипыВыплат Цикл
			
			НаборЗаписей = РегистрыСведений.гкм_НастройкиЗарплатныхПроектовЗУП.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Организация.Установить(Организация);
			НаборЗаписей.Отбор.ТипВыплаты.Установить(ТипВыплаты);
			НаборЗаписей.Отбор.ИдентификаторЗарплатногоПроектаЗУП.Установить(ИдПроекта);
			НаборЗаписей.Прочитать();
			
			// Не перезаписываем если уже есть - администратор мог донастроить
			Если НаборЗаписей.Количество() > 0 Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяЗапись = НаборЗаписей.Добавить();
			НоваяЗапись.Организация                         = Организация;
			НоваяЗапись.ТипВыплаты                          = ТипВыплаты;
			НоваяЗапись.ИдентификаторЗарплатногоПроектаЗУП  = ИдПроекта;
			НоваяЗапись.НаименованиеЗарплатногоПроектаЗУП   = ?(ЗначениеЗаполнено(Наименование), Наименование, ИдПроекта);
			
			НаборЗаписей.Записать();
			
		КонецЦикла;
		
		Результат = Новый Структура("Успех", Истина);
		Ответ.УстановитьТелоИзСтроки(
			гкм_ОбменДанными.ЗначениеВСтрокуJSON(Результат),
			КодировкаТекста.UTF8);
		
	Исключение
		
		Ответ = Новый HTTPСервисОтвет(500);
		ОшибкаСтруктура = Новый Структура("Ошибка",
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Ответ.УстановитьТелоИзСтроки(
			гкм_ОбменДанными.ЗначениеВСтрокуJSON(ОшибкаСтруктура),
			КодировкаТекста.UTF8);
		
	КонецПопытки;
	
	Возврат Ответ;
	
КонецФункции

Функция ПолучитьЗарплатныеПроектыGET(Запрос)
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	Попытка
		
		ИдПроекта = Запрос.ПараметрыЗапроса.Получить("id");
		ИНН       = Запрос.ПараметрыЗапроса.Получить("inn");
		
		Если Не ЗначениеЗаполнено(ИНН) Тогда
			Ответ = Новый HTTPСервисОтвет(400);
			ОшибкаСтруктура = Новый Структура("Ошибка",
				"Отсутствует обязательный параметр 'inn'");
			Ответ.УстановитьТелоИзСтроки(
				гкм_ОбменДанными.ЗначениеВСтрокуJSON(ОшибкаСтруктура),
				КодировкаТекста.UTF8);
			Возврат Ответ;
		КонецЕсли;
		
		// Получаем данные из регистра
		ЗапросПроекта = Новый Запрос;
		
		Если ЗначениеЗаполнено(ИдПроекта) Тогда
			// Ведомость - ищем по GUID проекта и ИНН организации
			ЗапросПроекта.Текст =
				"ВЫБРАТЬ
				|	Настройки.ТипВыплаты КАК ТипВыплаты,
				|	Настройки.ЗарплатныйПроект.Наименование              КАК Наименование,
				|	Настройки.ЗарплатныйПроект.НомерДоговора             КАК НомерДоговора,
				|	Настройки.ЗарплатныйПроект.ДатаДоговора              КАК ДатаДоговора,
				|	Настройки.ЗарплатныйПроект.ПрямаяВыплата             КАК ПрямаяВыплата,
				|	ЕСТЬNULL(Настройки.БанковскийСчетОрганизации.НомерСчета, """") КАК БанковскийСчетОрганизации,
				|	Настройки.ЗарплатныйПроект КАК ПроектСсылка
				|ИЗ
				|	РегистрСведений.гкм_НастройкиЗарплатныхПроектовЗУП КАК Настройки
				|ГДЕ
				|	Настройки.Организация.ИНН = &ИНН
				|	И Настройки.ИдентификаторЗарплатногоПроектаЗУП = &ИдПроекта
				|	И НЕ Настройки.ЗарплатныйПроект = ЗНАЧЕНИЕ(Справочник.гкм_ЗарплатныеПроекты.ПустаяСсылка)";
			ЗапросПроекта.УстановитьПараметр("ИНН",       ИНН);
			ЗапросПроекта.УстановитьПараметр("ИдПроекта", ИдПроекта);
		Иначе
			// Отражение зарплаты - служебный проект, ищем по ИНН с пустым ИдПроектаЗУП
			ЗапросПроекта.Текст =
				"ВЫБРАТЬ
				|	Настройки.ТипВыплаты КАК ТипВыплаты,
				|	Настройки.ЗарплатныйПроект.Наименование КАК Наименование,
				|	Настройки.ЗарплатныйПроект.НомерДоговора КАК НомерДоговора,
				|	Настройки.ЗарплатныйПроект.ДатаДоговора КАК ДатаДоговора,
				|	Настройки.ЗарплатныйПроект.ПрямаяВыплата КАК ПрямаяВыплата,
				|	ЕСТЬNULL(Настройки.БанковскийСчетОрганизации.НомерСчета, """") КАК БанковскийСчетОрганизации,
				|	Настройки.ЗарплатныйПроект КАК ПроектСсылка
				|ИЗ
				|	РегистрСведений.гкм_НастройкиЗарплатныхПроектовЗУП КАК Настройки
				|ГДЕ
				|	Настройки.Организация.ИНН = &ИНН
				|	И Настройки.ИдентификаторЗарплатногоПроектаЗУП = """"
				|	И НЕ Настройки.ЗарплатныйПроект = ЗНАЧЕНИЕ(Справочник.гкм_ЗарплатныеПроекты.ПустаяСсылка)";
			ЗапросПроекта.УстановитьПараметр("ИНН", ИНН);
		КонецЕсли;
		
		ТаблицаПроекта = ЗапросПроекта.Выполнить().Выгрузить();
		
		Если ТаблицаПроекта.Количество() = 0 Тогда
			Результат = Новый Структура;
			Результат.Вставить("Найден", Ложь);
			Ответ.УстановитьТелоИзСтроки(
				гкм_ОбменДанными.ЗначениеВСтрокуJSON(Результат),
				КодировкаТекста.UTF8);
			Возврат Ответ;
		КонецЕсли;
		
		// Для поиска по id берём общие данные из первой строки
		Если ЗначениеЗаполнено(ИдПроекта) Тогда
		    ПерваяСтрока = ТаблицаПроекта[0];
		КонецЕсли;

		// Собираем шаблоны и банковские счета по типам выплат
		Шаблоны          = Новый Соответствие;
		БанковскиеСчета  = Новый Соответствие;
		
		// Уникальные ссылки на проекты для одного запроса шаблонов
		ТаблицаПроектовСсылок = Новый ТаблицаЗначений;
		ТаблицаПроектовСсылок.Колонки.Добавить("ПроектСсылка",
			Новый ОписаниеТипов("СправочникСсылка.гкм_ЗарплатныеПроекты"));
		
		Для Каждого СтрокаПроекта Из ТаблицаПроекта Цикл
			
			Если Не ЗначениеЗаполнено(СтрокаПроекта.ПроектСсылка) Тогда
				Продолжить;
			КонецЕсли;
			
			// Банковский счет организации по типу выплаты - из ресурса регистра
			БанковскиеСчета.Вставить(
				Строка(СтрокаПроекта.ТипВыплаты),
				СтрокаПроекта.БанковскийСчетОрганизации);
			
			НоваяСтрока = ТаблицаПроектовСсылок.Добавить();
			НоваяСтрока.ПроектСсылка = СтрокаПроекта.ПроектСсылка;
			
		КонецЦикла;
		
		Если ТаблицаПроектовСсылок.Количество() > 0 Тогда
			
			ЗапросШаблонов = Новый Запрос;
			ЗапросШаблонов.Текст =
				"ВЫБРАТЬ
				|	ПроектыСсылки.ПроектСсылка КАК ПроектСсылка
				|ПОМЕСТИТЬ ВТ_ПроектыСсылки
				|ИЗ
				|	&ТаблицаПроектовСсылок КАК ПроектыСсылки
				|;
				|ВЫБРАТЬ
				|	ШаблоныНазначения.ТипВыплаты КАК ТипВыплаты,
				|	ШаблоныНазначения.Шаблон     КАК Шаблон
				|ИЗ
				|	Справочник.гкм_ЗарплатныеПроекты.ШаблонНазначенияПлатежа КАК ШаблоныНазначения
				|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ПроектыСсылки КАК ВТ_ПроектыСсылки
				|		ПО ШаблоныНазначения.Ссылка = ВТ_ПроектыСсылки.ПроектСсылка";
			ЗапросШаблонов.УстановитьПараметр("ТаблицаПроектовСсылок", ТаблицаПроектовСсылок);
			ТаблицаШаблонов = ЗапросШаблонов.Выполнить().Выгрузить();
			
			Для Каждого СтрокаШаблона Из ТаблицаШаблонов Цикл
				Шаблоны.Вставить(Строка(СтрокаШаблона.ТипВыплаты), СтрокаШаблона.Шаблон);
			КонецЦикла;
			
		КонецЕсли;
		
		// Формируем ответ
		Результат = Новый Структура;
		Результат.Вставить("Найден",  Истина);
		Результат.Вставить("Шаблоны", Шаблоны);
		
		Если ЗначениеЗаполнено(ИдПроекта) Тогда
			// Для поиска по id - добавляем реквизиты проекта
			Результат.Вставить("Наименование",             ПерваяСтрока.Наименование);
			Результат.Вставить("НомерДоговора",            ПерваяСтрока.НомерДоговора);
			Результат.Вставить("ДатаДоговора",             Формат(ПерваяСтрока.ДатаДоговора, "ДФ=dd.MM.yyyy"));
			Результат.Вставить("ПрямаяВыплата",            ПерваяСтрока.ПрямаяВыплата);
			Результат.Вставить("БанковскиеСчета", БанковскиеСчета);
		КонецЕсли;		
		
		Ответ.УстановитьТелоИзСтроки(
			гкм_ОбменДанными.ЗначениеВСтрокуJSON(Результат),
			КодировкаТекста.UTF8);
		
	Исключение
		
		Ответ = Новый HTTPСервисОтвет(500);
		ОшибкаСтруктура = Новый Структура("Ошибка",
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Ответ.УстановитьТелоИзСтроки(
			гкм_ОбменДанными.ЗначениеВСтрокуJSON(ОшибкаСтруктура),
			КодировкаТекста.UTF8);
		
	КонецПопытки;
	
	Возврат Ответ;

КонецФункции

Функция СоздатьЗаявкиНаРасходДСPOST(Запрос)
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	Попытка
		
		ДанныеЗапроса = гкм_ОбменДанными.ЗначениеИзСтрокиJSON(
			Запрос.ПолучитьТелоКакСтроку(), Истина);
		
		// Тип источника определяет логику обработки
		ТипИсточника = ДанныеЗапроса["ТипИсточника"];
		Если Не ЗначениеЗаполнено(ТипИсточника) Тогда
			ТипИсточника = "Ведомость"; // по умолчанию для обратной совместимости
		КонецЕсли;
		
		// Параметры создания заявок
		ДополнительныеПараметры = ДанныеЗапроса["ДополнительныеПараметры"];
		Если ДополнительныеПараметры = Неопределено Тогда
			Возврат ОтветОшибка(400, "Отсутствует обязательное поле 'ДополнительныеПараметры'");
		КонецЕсли;
		
		ПараметрыСоздания = Новый Структура;
		ПараметрыСоздания.Вставить("ПроводитьДокумент",        	
			ДополнительныеПараметры["ПроводитьДокумент"]        = Истина);
		ПараметрыСоздания.Вставить("СоздаватьЗаявкиНаЗарплату", 
			ДополнительныеПараметры["СоздаватьЗаявкиНаЗарплату"] = Истина);
		ПараметрыСоздания.Вставить("СоздаватьЗаявкиНаНДФЛ",     
			ДополнительныеПараметры["СоздаватьЗаявкиНаНДФЛ"]     = Истина);
		ПараметрыСоздания.Вставить("РежимТестирования",        	
			ДополнительныеПараметры["РежимТестирования"]        = Истина);
		
		Если ТипИсточника = "ОтражениеЗарплаты" Тогда
			Попытка
				Возврат СоздатьЗаявкиОтраженияЗарплаты(ДанныеЗапроса, ПараметрыСоздания);
			Исключение
				Возврат ОтветОшибка(400, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЕсли;
		
		// --- Режим: Ведомость (одиночная или пакет) ---
		// Поддерживаем оба формата: Ведомости (массив) и Ведомость (одиночная, обратная совместимость)
		МассивЭлементовПакета = ДанныеЗапроса["Ведомости"];
		Если МассивЭлементовПакета = Неопределено Тогда
			// Обратная совместимость - оборачиваем одиночную ведомость в массив
			ОдиночнаяВедомость = ДанныеЗапроса["Ведомость"];
			Если ОдиночнаяВедомость = Неопределено Тогда
				Возврат ОтветОшибка(400, "Отсутствует поле 'Ведомости' или 'Ведомость'");
			КонецЕсли;
			ЭлПакета = Новый Структура;
			ЭлПакета.Вставить("Ведомость",                 ОдиночнаяВедомость);
			ЭлПакета.Вставить("Строки",                    ДанныеЗапроса["Строки"]);
			ЭлПакета.Вставить("СтрокиНДФЛ",                ДанныеЗапроса["СтрокиНДФЛ"]);
			ЭлПакета.Вставить("НазначениеПлатежаЗарплата", ДанныеЗапроса["НазначениеПлатежаЗарплата"]);
			ЭлПакета.Вставить("НазначениеПлатежаНДФЛ",     ДанныеЗапроса["НазначениеПлатежаНДФЛ"]);
			МассивЭлементовПакета = Новый Массив;
			МассивЭлементовПакета.Добавить(ЭлПакета);
		КонецЕсли;
		
		Если ТипЗнч(МассивЭлементовПакета) <> Тип("Массив") Или МассивЭлементовПакета.Количество() = 0 Тогда
			Возврат ОтветОшибка(400, "Поле 'Ведомости' должно быть непустым массивом");
		КонецЕсли;
		
		Попытка
			Возврат СоздатьЗаявкиПакетВедомостейВТранзакции(МассивЭлементовПакета, ПараметрыСоздания, Ответ);
		Исключение
			Возврат ОтветОшибка(400, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		
	Исключение
		
		Ответ = Новый HTTPСервисОтвет(500);
		Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		ОшибкаСтруктура = Новый Структура("Ошибка",
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Ответ.УстановитьТелоИзСтроки(
			гкм_ОбменДанными.ЗначениеВСтрокуJSON(ОшибкаСтруктура), КодировкаТекста.UTF8);
		
	КонецПопытки;
	
	Возврат Ответ;
	
КонецФункции

// Функция - СоздатьЗаявкиПакетВедомостейВТранзакции
// Создаёт все заявки по пакету ведомостей (зарплата + НДФЛ) в одной транзакции.
// При любой ошибке - откат всей транзакции.
//
// Параметры:
//  МассивЭлементовПакета - Массив - каждый элемент: Структура(Ведомость, Строки, СтрокиНДФЛ,
//                          НазначениеПлатежаЗарплата, НазначениеПлатежаНДФЛ)
//  ПараметрыСоздания     - Структура
//  Ответ                 - HTTPСервисОтвет
//
Функция СоздатьЗаявкиПакетВедомостейВТранзакции(МассивЭлементовПакета, ПараметрыСоздания, Ответ)
	
	МассивЗаявок   = Новый Массив;
	КешОрганизаций = Новый Соответствие;
	КешНастроек    = Новый Соответствие;
	
	// --- Предварительная валидация до транзакции ---
	Для Каждого ЭлПакета Из МассивЭлементовПакета Цикл
		
		ДанныеВедомости    = ЭлПакета["Ведомость"];
		МассивФизлиц       = ЭлПакета["Строки"];
		
		Если ДанныеВедомости = Неопределено Тогда
			Возврат ОтветОшибка(400, "Элемент пакета не содержит поле 'Ведомость'");
		КонецЕсли;
		
		Если ПараметрыСоздания.СоздаватьЗаявкиНаЗарплату
			И ЭлПакета["ТолькоНДФЛ"] <> Истина Тогда
			Если МассивФизлиц = Неопределено
				Или ТипЗнч(МассивФизлиц) <> Тип("Массив")
				Или МассивФизлиц.Количество() = 0 Тогда
				Возврат ОтветОшибка(400, "Отсутствуют строки ведомости ('Строки') для: "
					+ ДанныеВедомости["ОснованиеЗУП"]);
			КонецЕсли;
		КонецЕсли;
		
		ОрганизацияИНН       = ДанныеВедомости["ОрганизацияИНН"];
		ЗарплатныйПроектГУИД = ДанныеВедомости["ЗарплатныйПроектГУИД"];
		
		Если Не ЗначениеЗаполнено(ОрганизацияИНН) Тогда
			Возврат ОтветОшибка(400, "Отсутствует 'ОрганизацияИНН' для: " + ДанныеВедомости["ОснованиеЗУП"]);
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ЗарплатныйПроектГУИД) Тогда
			Возврат ОтветОшибка(400, "Отсутствует 'ЗарплатныйПроектГУИД' для: " + ДанныеВедомости["ОснованиеЗУП"]);
		КонецЕсли;
		
		// Кеш организаций
		Если КешОрганизаций[ОрганизацияИНН] = Неопределено Тогда
			Орг = НайтиОрганизациюПоИНН(ОрганизацияИНН);
			Если Орг = Неопределено Тогда
				Возврат ОтветОшибка(400, "Организация не найдена по ИНН: " + ОрганизацияИНН);
			КонецЕсли;
			КешОрганизаций.Вставить(ОрганизацияИНН, Орг);
		КонецЕсли;
		
		// Кеш настроек
		КлючНастроек = ОрганизацияИНН + "|" + ЗарплатныйПроектГУИД;
		Если КешНастроек[КлючНастроек] = Неопределено Тогда
			Орг             = КешОрганизаций[ОрганизацияИНН];
			ТаблицаНастроек = ПолучитьНастройкиЗарплатногоПроекта(
				Орг, "Ведомость", ЗарплатныйПроектГУИД,
				Перечисления.гкм_ТипыВыплатыЗУП.Зарплата,
				Перечисления.гкм_ТипыВыплатыЗУП.НДФЛ
			);
			НастройкаЗарплата = ТаблицаНастроек.Найти(Перечисления.гкм_ТипыВыплатыЗУП.Зарплата, "ТипВыплаты");
			НастройкаНДФЛ     = ТаблицаНастроек.Найти(Перечисления.гкм_ТипыВыплатыЗУП.НДФЛ,     "ТипВыплаты");
			Если НастройкаЗарплата = Неопределено Тогда
				Возврат ОтветОшибка(400, "Не найдена настройка 'Зарплата' для: " + КлючНастроек);
			КонецЕсли;
			Если НастройкаНДФЛ = Неопределено Тогда
				Возврат ОтветОшибка(400, "Не найдена настройка 'НДФЛ' для: " + КлючНастроек);
			КонецЕсли;
			КешНастроек.Вставить(КлючНастроек, Новый Структура("Зарплата, НДФЛ",
				НастройкаЗарплата, НастройкаНДФЛ));
		КонецЕсли;
		
		// Проверяем дубли зарплаты и НДФЛ в зависимости от типа элемента
		ОснованиеЗУП = ДанныеВедомости["ОснованиеЗУП"];
		ТолькоНДФЛ   = ЭлПакета["ТолькоНДФЛ"] = Истина;
		ОшибкаДублей = ПроверитьДублиЗаявок(
			ОснованиеЗУП,
			?(Не ТолькоНДФЛ, ПараметрыСоздания.СоздаватьЗаявкиНаЗарплату, Ложь),
			?(ТолькоНДФЛ,    Истина, Ложь),
			Ложь, Ложь
		);
		Если ЗначениеЗаполнено(ОшибкаДублей) Тогда
			Возврат ОтветОшибка(400, ОшибкаДублей);
		КонецЕсли;
		
	КонецЦикла;
	
	// --- Единая транзакция для всего пакета ---
	НачатьТранзакцию();
	Попытка
		
		Для Каждого ЭлПакета Из МассивЭлементовПакета Цикл
			
			ДанныеВедомости    = ЭлПакета["Ведомость"];
			МассивФизлиц       = ЭлПакета["Строки"];
			МассивФизлицНДФЛ   = ?(ЭлПакета["СтрокиНДФЛ"] <> Неопределено, ЭлПакета["СтрокиНДФЛ"], Новый Массив);
			НазначениеЗарплата = ЭлПакета["НазначениеПлатежаЗарплата"];
			НазначениеНДФЛ     = ЭлПакета["НазначениеПлатежаНДФЛ"];
			
			ОрганизацияИНН       = ДанныеВедомости["ОрганизацияИНН"];
			ЗарплатныйПроектГУИД = ДанныеВедомости["ЗарплатныйПроектГУИД"];
			НомерВедомости       = ДанныеВедомости["Номер"];
			ДатаВедомостиСтрока  = ДанныеВедомости["Дата"];
			ОснованиеЗУП         = ДанныеВедомости["ОснованиеЗУП"];
			ПрямаяВыплата        = ДанныеВедомости["ПрямаяВыплата"];
			
			ДатаВедомости = ПрочитатьДатуJSON(ДатаВедомостиСтрока, ФорматДатыJSON.ISO);
			
			Организация   = КешОрганизаций[ОрганизацияИНН];
			КлючНастроек  = ОрганизацияИНН + "|" + ЗарплатныйПроектГУИД;
			Настройки     = КешНастроек[КлючНастроек];
			НастройкаЗарплата = Настройки.Зарплата;
			НастройкаНДФЛ     = Настройки.НДФЛ;
			
			Если ПрямаяВыплата = Истина Тогда
				
				// --- Прямая выплата ---
				АналитикаФизлиц = ПолучитьАналитикуФизлицИзРегистра(МассивФизлиц);
				
				СуммаНДФЛ = 0;
				Для Каждого Физлицо Из МассивФизлицНДФЛ Цикл
					СуммаНДФЛ = СуммаНДФЛ + Физлицо["Сумма"];
				КонецЦикла;
				
				АналитикаПлатежаНДФЛ = СформироватьАналитикуПлатежа(МассивФизлицНДФЛ);
				
				СуммаАналитикиНДФЛ = 0;
				Для Каждого СтрАналитики Из АналитикаПлатежаНДФЛ Цикл
					СуммаАналитикиНДФЛ = СуммаАналитикиНДФЛ + СтрАналитики.Сумма;
				КонецЦикла;
				Если Окр(СуммаАналитикиНДФЛ, 2) <> Окр(СуммаНДФЛ, 2) Тогда
					ТекстИсключения = "Сумма по аналитике платежа (НДФЛ): " + СуммаАналитикиНДФЛ
						+ " не совпадает с суммой НДФЛ: " + СуммаНДФЛ
						+ ". Ведомость: " + ОснованиеЗУП;
					ВызватьИсключение ТекстИсключения;
				КонецЕсли;
				
				Если ПараметрыСоздания.СоздаватьЗаявкиНаЗарплату Тогда
					Для Каждого Физлицо Из МассивФизлиц Цикл
						
						Ид = Физлицо["Идентификатор"];
						Если АналитикаФизлиц[Ид] = Неопределено Тогда
							ТекстИсключения = "Не найдено соответствие аналитики для физлица: " + Физлицо["Наименование"];
							ВызватьИсключение ТекстИсключения;
						КонецЕсли;
						
						РезультатПоискаКА = НайтиКонтрагентаИСчет(
							Физлицо["Наименование"], Физлицо["НомерЛицевогоСчета"]);
						Если Не РезультатПоискаКА.Успех Тогда
							ТекстИсключения = РезультатПоискаКА.Ошибка;
							ВызватьИсключение ТекстИсключения;
						КонецЕсли;
						
						НазначениеФизлица = СтрЗаменить(НазначениеЗарплата, "[ФИО]", Физлицо["Наименование"]);
						НазначениеФизлица = СтрЗаменить(НазначениеФизлица, "[НомерЛицевогоСчета]", Физлицо["НомерЛицевогоСчета"]);
						
						ДанныеЗаполнения = Новый Структура;
						ДанныеЗаполнения.Вставить("Номер",             НомерВедомости);
						ДанныеЗаполнения.Вставить("Дата",              ДатаВедомости);
						ДанныеЗаполнения.Вставить("НазначениеПлатежа", НазначениеФизлица);
						ДанныеЗаполнения.Вставить("ОснованиеЗУП",      ОснованиеЗУП);
						ДанныеЗаполнения.Вставить("Сумма",             Физлицо["Сумма"]);
						ДанныеЗаполнения.Вставить("Контрагент",        РезультатПоискаКА.Контрагент);
						ДанныеЗаполнения.Вставить("БанковскийСчет",    РезультатПоискаКА.БанковскийСчет);
						
						ЗаявкаЗарплатаФизлица = СоздатьЗаявкуЗарплатаПрямая(
							Организация, НастройкаЗарплата, АналитикаФизлиц[Ид],
							ДанныеЗаполнения, ПараметрыСоздания);
						МассивЗаявок.Добавить(ОписаниеЗаявки(ЗаявкаЗарплатаФизлица, "Зарплата"));
						
					КонецЦикла;
				КонецЕсли;
				
				Если ПараметрыСоздания.СоздаватьЗаявкиНаНДФЛ Или ЭлПакета["ТолькоНДФЛ"] = Истина Тогда
					ДанныеЗаполнения = Новый Структура;
					ДанныеЗаполнения.Вставить("Номер",             НомерВедомости);
					ДанныеЗаполнения.Вставить("Дата",              ДатаВедомости);
					ДанныеЗаполнения.Вставить("НазначениеПлатежа", НазначениеНДФЛ);
					ДанныеЗаполнения.Вставить("ОснованиеЗУП",      ОснованиеЗУП);
					ДанныеЗаполнения.Вставить("Сумма",             СуммаНДФЛ);
					ЗаявкаНДФЛ = СоздатьЗаявкуНДФЛ(
						Организация, НастройкаНДФЛ, АналитикаПлатежаНДФЛ,
						ДанныеЗаполнения, ПараметрыСоздания);
					МассивЗаявок.Добавить(ОписаниеЗаявки(ЗаявкаНДФЛ, "НДФЛ"));
				КонецЕсли;
				
			Иначе
				
				// --- Банковский проект ---
				// Для элементов ТолькоНДФЛ проверку суммы зарплаты пропускаем
				Если ЭлПакета["ТолькоНДФЛ"] <> Истина Тогда
					СуммаЗарплата = 0;
					Для Каждого Физлицо Из МассивФизлиц Цикл
						СуммаЗарплата = СуммаЗарплата + Физлицо["Сумма"];
					КонецЦикла;
					
					АналитикаПлатежаЗарплата = СформироватьАналитикуПлатежа(МассивФизлиц);
					
					СуммаАналитики = 0;
					Для Каждого СтрАналитики Из АналитикаПлатежаЗарплата Цикл
						СуммаАналитики = СуммаАналитики + СтрАналитики.Сумма;
					КонецЦикла;
					Если Окр(СуммаАналитики, 2) <> Окр(СуммаЗарплата, 2) Тогда
						ТекстИсключения = "Сумма по аналитике платежа (зарплата): " + СуммаАналитики
							+ " не совпадает с суммой ведомости: " + СуммаЗарплата
							+ ". Ведомость: " + ОснованиеЗУП;
						ВызватьИсключение ТекстИсключения;
					КонецЕсли;
				Иначе
					СуммаЗарплата            = 0;
					АналитикаПлатежаЗарплата = Новый Массив;
				КонецЕсли;
				
				СуммаНДФЛ = 0;
				Для Каждого Физлицо Из МассивФизлицНДФЛ Цикл
					СуммаНДФЛ = СуммаНДФЛ + Физлицо["Сумма"];
				КонецЦикла;
				
				АналитикаПлатежаНДФЛ = СформироватьАналитикуПлатежа(МассивФизлицНДФЛ);
				
				СуммаАналитикиНДФЛ = 0;
				Для Каждого СтрАналитики Из АналитикаПлатежаНДФЛ Цикл
					СуммаАналитикиНДФЛ = СуммаАналитикиНДФЛ + СтрАналитики.Сумма;
				КонецЦикла;
				Если Окр(СуммаАналитикиНДФЛ, 2) <> Окр(СуммаНДФЛ, 2) Тогда
					ТекстИсключения = "Сумма по аналитике платежа (НДФЛ): " + СуммаАналитикиНДФЛ
						+ " не совпадает с суммой НДФЛ: " + СуммаНДФЛ
						+ ". Ведомость: " + ОснованиеЗУП;
					ВызватьИсключение ТекстИсключения;
				КонецЕсли;
				
				Если ПараметрыСоздания.СоздаватьЗаявкиНаЗарплату И ЭлПакета["ТолькоНДФЛ"] <> Истина Тогда
					ДанныеЗаполнения = Новый Структура;
					ДанныеЗаполнения.Вставить("Номер",             НомерВедомости);
					ДанныеЗаполнения.Вставить("Дата",              ДатаВедомости);
					ДанныеЗаполнения.Вставить("НазначениеПлатежа", НазначениеЗарплата);
					ДанныеЗаполнения.Вставить("ОснованиеЗУП",      ОснованиеЗУП);
					ДанныеЗаполнения.Вставить("Сумма",             СуммаЗарплата);
					ЗаявкаЗарплата = СоздатьЗаявкуЗарплата(
						Организация, НастройкаЗарплата, АналитикаПлатежаЗарплата,
						ДанныеЗаполнения, ПараметрыСоздания);
					МассивЗаявок.Добавить(ОписаниеЗаявки(ЗаявкаЗарплата, "Зарплата"));
				КонецЕсли;
				
				Если ПараметрыСоздания.СоздаватьЗаявкиНаНДФЛ Или ЭлПакета["ТолькоНДФЛ"] = Истина Тогда
					ДанныеЗаполнения = Новый Структура;
					ДанныеЗаполнения.Вставить("Номер",             НомерВедомости);
					ДанныеЗаполнения.Вставить("Дата",              ДатаВедомости);
					ДанныеЗаполнения.Вставить("НазначениеПлатежа", НазначениеНДФЛ);
					ДанныеЗаполнения.Вставить("ОснованиеЗУП",      ОснованиеЗУП);
					ДанныеЗаполнения.Вставить("Сумма",             СуммаНДФЛ);
					ЗаявкаНДФЛ = СоздатьЗаявкуНДФЛ(
						Организация, НастройкаНДФЛ, АналитикаПлатежаНДФЛ,
						ДанныеЗаполнения, ПараметрыСоздания);
					МассивЗаявок.Добавить(ОписаниеЗаявки(ЗаявкаНДФЛ, "НДФЛ"));
				КонецЕсли;
				
			КонецЕсли; // ПрямаяВыплата
			
		КонецЦикла; // МассивЭлементовПакета
		
		Если ПараметрыСоздания.РежимТестирования Тогда
			ОтменитьТранзакцию();
		Иначе
			ЗафиксироватьТранзакцию();
		КонецЕсли;
		
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Результат = Новый Структура("Заявки", МассивЗаявок);
	Ответ.УстановитьТелоИзСтроки(
		гкм_ОбменДанными.ЗначениеВСтрокуJSON(Результат), КодировкаТекста.UTF8);
	Возврат Ответ;
	
КонецФункции

// Функция - Получить подразделения
// Возвращает список подразделений из регистра соответствия подразделений и центров расходов.
//
// Возвращаемое значение:
//  Массив из Структур - ГУИД (Строка, XML-представление ссылки), Наименование (Строка)
//
Функция ПолучитьПодразделения()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Соответствие.Подразделение КАК ГУИД,
		|	Соответствие.Подразделение.Наименование КАК Наименование
		|ИЗ
		|	РегистрСведений.гкм_СоответствиеПодразделенийИЦентровРасходов КАК Соответствие
		|ГДЕ
		|	НЕ Соответствие.Подразделение.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Соответствие.Подразделение.Наименование";
	
	Возврат ВыгрузитьВМассивСтруктур(Запрос);
	
КонецФункции

// Функция - Получить центры расходов
// Возвращает список пар подразделение - центр расходов из регистра соответствия.
//
// Возвращаемое значение:
//  Массив из Структур:
//   ПодразделениеГУИД (Строка) - XML-представление ссылки на подразделение
//   ПодразделениеНаименование (Строка)
//   ЦентрРасходовГУИД (Строка) - XML-представление ссылки на центр расходов
//   ЦентрРасходовНаименование (Строка)
//
Функция ПолучитьЦентрыРасходов()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Соответствие.Подразделение КАК ПодразделениеГУИД,
		|	Соответствие.Подразделение.Наименование КАК ПодразделениеНаименование,
		|	Соответствие.ЦентрРасходов КАК ЦентрРасходовГУИД,
		|	Соответствие.ЦентрРасходов.Наименование КАК ЦентрРасходовНаименование
		|ИЗ
		|	РегистрСведений.гкм_СоответствиеПодразделенийИЦентровРасходов КАК Соответствие
		|ГДЕ
		|	НЕ Соответствие.Подразделение.ПометкаУдаления
		|	И НЕ Соответствие.ЦентрРасходов.ПометкаУдаления";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Массив = Новый Массив;
	Для Каждого Строка Из Результат Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("ПодразделениеГУИД",         XMLСтрока(Строка.ПодразделениеГУИД));
		Элемент.Вставить("ПодразделениеНаименование", Строка.ПодразделениеНаименование);
		Элемент.Вставить("ЦентрРасходовГУИД",         XMLСтрока(Строка.ЦентрРасходовГУИД));
		Элемент.Вставить("ЦентрРасходовНаименование", Строка.ЦентрРасходовНаименование);
		Массив.Добавить(Элемент);
	КонецЦикла;
	
	Возврат Массив;
	
КонецФункции

// Функция - Получить объекты строительства
// Возвращает список объектов строительства из справочника гкм_ОбъектыСтроительства.
//
// Возвращаемое значение:
//  Массив из Структур - ГУИД (Строка, XML-представление ссылки), Наименование (Строка)
//
Функция ПолучитьОбъектыСтроительства()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ОбъектыСтроительства.Ссылка КАК ГУИД,
		|	ОбъектыСтроительства.Наименование КАК Наименование
		|ИЗ
		|	Справочник.гкм_ОбъектыСтроительства КАК ОбъектыСтроительства
		|ГДЕ
		|	НЕ ОбъектыСтроительства.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	ОбъектыСтроительства.Наименование";
	
	Возврат ВыгрузитьВМассивСтруктур(Запрос);
	
КонецФункции

// Функция - Выгрузить в массив структур
// Выгружает результат запроса в массив структур с ключами ГУИД и Наименование.
// Вспомогательная функция для ПолучитьПодразделения и ПолучитьОбъектыСтроительства.
//
// Параметры:
//  Запрос - Запрос - подготовленный запрос, возвращающий поля ГУИД и Наименование
//
// Возвращаемое значение:
//  Массив из Структур - ГУИД (Строка, XML-представление ссылки), Наименование (Строка)
//
Функция ВыгрузитьВМассивСтруктур(Запрос)
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Массив = Новый Массив;
	Для Каждого Строка Из Результат Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("ГУИД",        XMLСтрока(Строка.ГУИД));
		Элемент.Вставить("Наименование", Строка.Наименование);
		Массив.Добавить(Элемент);
	КонецЦикла;
	
	Возврат Массив;
	
КонецФункции

// Функция - Получить незамапленные физлица
// Определяет идентификаторы физлиц из переданного списка,
// для которых отсутствует запись в регистре соответствия данных физлиц ЗУП.
//
// Параметры:
//  СписокИд - Массив - идентификаторы физлиц ЗУП (Строка)
//
// Возвращаемое значение:
//  Массив - идентификаторы физлиц (Строка), не имеющих записи в регистре
//
Функция ПолучитьНезамапленныеФизлица(СписокИд)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Соответствие.ИдентификаторФизлицаЗУП КАК Идентификатор
		|ИЗ
		|	РегистрСведений.гкм_СоответствиеДанныхФизлицЗУП КАК Соответствие
		|ГДЕ
		|	Соответствие.ИдентификаторФизлицаЗУП В (&СписокИд)";
	
	Запрос.УстановитьПараметр("СписокИд", СписокИд);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	// Собираем кто уже замаплен
	ЗамапленныеИд = Новый Массив;
	Для Каждого Строка Из Результат Цикл
		ЗамапленныеИд.Добавить(Строка.Идентификатор);
	КонецЦикла;
	
	// Вычитаем замапленных из входящего списка
	НезамапленныеИд = Новый Массив;
	Для Каждого Ид Из СписокИд Цикл
		Если ЗамапленныеИд.Найти(Ид) = Неопределено Тогда
			НезамапленныеИд.Добавить(Ид);
		КонецЕсли;
	КонецЦикла;
	
	Возврат НезамапленныеИд;
	
КонецФункции

// Процедура - Записать маппинг физлиц
// Записывает соответствие физлиц ЗУП подразделениям, центрам расходов
// и объектам строительства УТ. Операция идемпотентна - повторный вызов перезапишет существующую запись.
//
// Параметры:
//  МассивФизлиц - Массив из Соответствий со следующими ключами:
//   Идентификатор (Строка) - идентификатор физлица в ЗУП, обязательный
//   Наименование (Строка) - ФИО физлица
//   ПодразделениеГУИД (Строка) - ГУИД подразделения УТ, обязательный
//   ЦентрРасходовГУИД (Строка) - ГУИД центра расходов УТ, обязательный
//   ОбъектСтроительстваГУИД (Строка) - ГУИД объекта строительства УТ, необязательный
//
// Возвращаемое значение:
//  Массив - строки с описанием ошибок записи; пустой массив если все записи сохранены успешно
//
Функция ЗаписатьМаппингФизлиц(МассивФизлиц)
	
	ОшибкиЗаписи = Новый Массив;
	
	Для Каждого Физлицо Из МассивФизлиц Цикл
		
		Попытка
			
			ИдФизлица               = Физлицо["Идентификатор"];
			НаимФизлица             = Физлицо["Наименование"];
			ПодразделениеГУИД       = Физлицо["ПодразделениеГУИД"];
			ЦентрРасходовГУИД       = Физлицо["ЦентрРасходовГУИД"];
			ОбъектСтроительстваГУИД = Физлицо["ОбъектСтроительстваГУИД"];
			БазаИсточник            = Физлицо["БазаИсточник"];

			// Проверяем обязательные поля
			Если Не ЗначениеЗаполнено(ИдФизлица) Тогда
				ОшибкиЗаписи.Добавить("Пустой идентификатор физлица");
				Продолжить;
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(ПодразделениеГУИД) Тогда
				ОшибкиЗаписи.Добавить(НаимФизлица + ": не заполнено подразделение");
				Продолжить;
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(ЦентрРасходовГУИД) Тогда
				ОшибкиЗаписи.Добавить(НаимФизлица + ": не заполнен центр расходов");
				Продолжить;
			КонецЕсли;
			
			// Получаем ссылку на подразделение по ГУИД
			Подразделение = Справочники.СтруктураПредприятия.ПолучитьСсылку(
				Новый УникальныйИдентификатор(ПодразделениеГУИД));
			
			Если Не ЗначениеЗаполнено(Подразделение) Тогда
				ОшибкиЗаписи.Добавить(НаимФизлица
					+ ": подразделение не найдено в УТ (" + ПодразделениеГУИД + ")");
				Продолжить;
			КонецЕсли;
			
			// Получаем ссылку на центр расходов по ГУИД
			ЦентрРасходов = Справочники.гкм_ЦентрыРасходов.ПолучитьСсылку(
				Новый УникальныйИдентификатор(ЦентрРасходовГУИД));
			
			Если Не ЗначениеЗаполнено(ЦентрРасходов) Тогда
				ОшибкиЗаписи.Добавить(НаимФизлица
					+ ": центр расходов не найден в УТ (" + ЦентрРасходовГУИД + ")");
				Продолжить;
			КонецЕсли;
			
			// Получаем ссылку на объект строительства по ГУИД (необязательное поле)
			ОбъектСтроительства = Справочники.гкм_ОбъектыСтроительства.ПустаяСсылка();
			Если ЗначениеЗаполнено(ОбъектСтроительстваГУИД) Тогда
				ОбъектСтроительства = Справочники.гкм_ОбъектыСтроительства.ПолучитьСсылку(
					Новый УникальныйИдентификатор(ОбъектСтроительстваГУИД));
			КонецЕсли;
			
			// Записываем в регистр - идемпотентно, перезапишет если уже есть
			НаборЗаписей = РегистрыСведений.гкм_СоответствиеДанныхФизлицЗУП.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ИдентификаторФизлицаЗУП.Установить(ИдФизлица);
			
			НоваяЗапись = НаборЗаписей.Добавить();
			НоваяЗапись.ИдентификаторФизлицаЗУП = ИдФизлица;
			НоваяЗапись.НаименованиеФизлицаЗУП  = НаимФизлица;
			НоваяЗапись.Подразделение           = Подразделение;
			НоваяЗапись.ЦентрРасходов           = ЦентрРасходов;
			НоваяЗапись.ОбъектСтроительства     = ОбъектСтроительства;
			НоваяЗапись.БазаИсточник           	= БазаИсточник;
			
			НаборЗаписей.Записать();
			
		Исключение
			ОшибкиЗаписи.Добавить(
				НаимФизлица + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат ОшибкиЗаписи;
	
КонецФункции

// Создаёт заявки на расходование ДС из документа ОтражениеЗарплатыВБухучете.
// Создаёт 2 заявки: ВзносыПоЕдиномуТарифу и ФССНесчастныеСлучаи.
//
// Параметры:
//  ДанныеЗапроса     - Соответствие - разобранное тело HTTP-запроса
//  ПараметрыСоздания - Структура
//
// Возвращаемое значение:
//   HTTPСервисОтвет
//
Функция СоздатьЗаявкиОтраженияЗарплаты(ДанныеЗапроса, ПараметрыСоздания)
	
	ДанныеДокумента  = ДанныеЗапроса["Документ"];
	МассивФизлицЕТ   = ДанныеЗапроса["СтрокиЕТ"];
	МассивФизлицФСС  = ДанныеЗапроса["СтрокиФСС"];
	НазначениеЕТ     = ДанныеЗапроса["НазначениеЕТ"];
	НазначениеФСС    = ДанныеЗапроса["НазначениеФСС"];
	
	Если ДанныеДокумента = Неопределено Тогда
		Возврат ОтветОшибка(400, "Отсутствует обязательное поле 'Документ'");
	КонецЕсли;
	
	ОрганизацияИНН  = ДанныеДокумента["ОрганизацияИНН"];
	НомерДокумента  = ДанныеДокумента["Номер"];
	ДатаДокСтрока   = ДанныеДокумента["Дата"];
	ОснованиеЗУП    = ДанныеДокумента["ОснованиеЗУП"];
	
	Если Не ЗначениеЗаполнено(ОрганизацияИНН) Тогда
		Возврат ОтветОшибка(400, "Отсутствует обязательное поле 'ОрганизацияИНН'");
	КонецЕсли;
	
	Организация = НайтиОрганизациюПоИНН(ОрганизацияИНН);
	Если Организация = Неопределено Тогда
		Возврат ОтветОшибка(400, "Организация не найдена по ИНН: " + ОрганизацияИНН);
	КонецЕсли;
	
	// Настройки ищем по организации без привязки к ЗарплатномуПроектуЗУП
	ТаблицаНастроек = ПолучитьНастройкиЗарплатногоПроекта(
		Организация, "ОтражениеЗарплаты", "",
		Перечисления.гкм_ТипыВыплатыЗУП.ВзносыПоЕдиномуТарифу,
		Перечисления.гкм_ТипыВыплатыЗУП.ФССНесчастныеСлучаи
	);
	
	НастройкаЕТ  = ТаблицаНастроек.Найти(
		Перечисления.гкм_ТипыВыплатыЗУП.ВзносыПоЕдиномуТарифу, "ТипВыплаты");
	НастройкаФСС = ТаблицаНастроек.Найти(
		Перечисления.гкм_ТипыВыплатыЗУП.ФССНесчастныеСлучаи, "ТипВыплаты");
	
	Если НастройкаЕТ = Неопределено Тогда
		Возврат ОтветОшибка(400, "Не найдена настройка для типа 'ВзносыПоЕдиномуТарифу'");
	КонецЕсли;
	Если НастройкаФСС = Неопределено Тогда
		Возврат ОтветОшибка(400, "Не найдена настройка для типа 'ФССНесчастныеСлучаи'");
	КонецЕсли;
	
	ДатаДокумента = Дата(
		Число(Сред(ДатаДокСтрока, 1, 4)),
		Число(Сред(ДатаДокСтрока, 6, 2)),
		Число(Сред(ДатаДокСтрока, 9, 2))
	);
	
	МассивЗаявок = Новый Массив;
	
	// Проверяем дубли перед созданием
	ОшибкаДублей = ПроверитьДублиЗаявок(
		ОснованиеЗУП,
		Ложь, Ложь,
		МассивФизлицЕТ  <> Неопределено И МассивФизлицЕТ.Количество()  > 0,
		МассивФизлицФСС <> Неопределено И МассивФизлицФСС.Количество() > 0
	);
	Если ЗначениеЗаполнено(ОшибкаДублей) Тогда
		Возврат ОтветОшибка(400, ОшибкаДублей);
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		
		// Заявка ВзносыПоЕдиномуТарифу
		Если МассивФизлицЕТ <> Неопределено И МассивФизлицЕТ.Количество() > 0 Тогда
			
			СуммаЕТ = 0;
			Для Каждого Физлицо Из МассивФизлицЕТ Цикл
				СуммаЕТ = СуммаЕТ + Физлицо["Сумма"];
			КонецЦикла;
			
			АналитикаЕТ = СформироватьАналитикуПлатежа(МассивФизлицЕТ);
			
			СуммаАналитикиЕТ = 0;
			Для Каждого СтрА Из АналитикаЕТ Цикл
				СуммаАналитикиЕТ = СуммаАналитикиЕТ + СтрА.Сумма;
			КонецЦикла;
			Если Окр(СуммаАналитикиЕТ, 2) <> Окр(СуммаЕТ, 2) Тогда
				ТекстИсключения = "Сумма аналитики (ЕТ): " + СуммаАналитикиЕТ
					+ " не совпадает с суммой взносов: " + СуммаЕТ;
				ВызватьИсключение ТекстИсключения;
			КонецЕсли;
			
			ДанныеЗаполнения = Новый Структура;
			ДанныеЗаполнения.Вставить("Номер",             НомерДокумента);
			ДанныеЗаполнения.Вставить("Дата",              ДатаДокумента);
			ДанныеЗаполнения.Вставить("НазначениеПлатежа", ?(ЗначениеЗаполнено(НазначениеЕТ),
				НазначениеЕТ, НастройкаЕТ.НазначениеПлатежа));
			ДанныеЗаполнения.Вставить("ОснованиеЗУП",      ОснованиеЗУП);
			ДанныеЗаполнения.Вставить("Сумма",             СуммаЕТ);
			
			ЗаявкаЕТ = СоздатьЗаявкуВзносов(
				Организация, НастройкаЕТ, АналитикаЕТ,
				ДанныеЗаполнения, ПараметрыСоздания);
			МассивЗаявок.Добавить(ОписаниеЗаявки(ЗаявкаЕТ, "ВзносыПоЕдиномуТарифу"));
			
		КонецЕсли;
		
		// Заявка ФССНесчастныеСлучаи
		Если МассивФизлицФСС <> Неопределено И МассивФизлицФСС.Количество() > 0 Тогда
			
			СуммаФСС = 0;
			Для Каждого Физлицо Из МассивФизлицФСС Цикл
				СуммаФСС = СуммаФСС + Физлицо["Сумма"];
			КонецЦикла;
			
			АналитикаФСС = СформироватьАналитикуПлатежа(МассивФизлицФСС);
			
			СуммаАналитикиФСС = 0;
			Для Каждого СтрА Из АналитикаФСС Цикл
				СуммаАналитикиФСС = СуммаАналитикиФСС + СтрА.Сумма;
			КонецЦикла;
			Если Окр(СуммаАналитикиФСС, 2) <> Окр(СуммаФСС, 2) Тогда
				ТекстИсключения = "Сумма аналитики (ФСС): " + СуммаАналитикиФСС
					+ " не совпадает с суммой взносов: " + СуммаФСС;
				ВызватьИсключение ТекстИсключения;
			КонецЕсли;
			
			ДанныеЗаполнения = Новый Структура;
			ДанныеЗаполнения.Вставить("Номер",             НомерДокумента);
			ДанныеЗаполнения.Вставить("Дата",              ДатаДокумента);
			ДанныеЗаполнения.Вставить("НазначениеПлатежа", ?(ЗначениеЗаполнено(НазначениеФСС),
				НазначениеФСС, НастройкаФСС.НазначениеПлатежа));
			ДанныеЗаполнения.Вставить("ОснованиеЗУП",      ОснованиеЗУП);
			ДанныеЗаполнения.Вставить("Сумма",             СуммаФСС);
			
			ЗаявкаФСС = СоздатьЗаявкуВзносов(
				Организация, НастройкаФСС, АналитикаФСС,
				ДанныеЗаполнения, ПараметрыСоздания);
			МассивЗаявок.Добавить(ОписаниеЗаявки(ЗаявкаФСС, "ФССНесчастныеСлучаи"));
			
		КонецЕсли;
		
		Если ПараметрыСоздания.РежимТестирования Тогда 
			ОтменитьТранзакцию();
		Иначе
			ЗафиксироватьТранзакцию();
		КонецЕсли;	
		
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Результат = Новый Структура("Заявки", МассивЗаявок);
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(
		гкм_ОбменДанными.ЗначениеВСтрокуJSON(Результат), КодировкаТекста.UTF8);
	Возврат Ответ;
	
КонецФункции

// Создаёт заявку на расходование ДС по социальным взносам.
//
// Параметры:
//  Организация       - СправочникСсылка.Организации
//  Настройка         - СтрокаТаблицыЗначений
//  Сумма             - Число
//  АналитикаПлатежа  - Массив из Структур
//  НомерДокумента    - Строка
//  ДатаДокумента     - Дата
//  ТипВыплаты        - Строка (для назначения платежа)
//  ПараметрыСоздания - Структура
//
// Возвращаемое значение:
//   ДокументОбъект.ЗаявкаНаРасходованиеДенежныхСредств
//
Функция СоздатьЗаявкуВзносов(Организация, Настройка, АналитикаПлатежа,
	ДанныеЗаполнения, ПараметрыСоздания)
	
	ДанныеОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		Организация, "ИНН, КПП, НаименованиеСокращенное");  
		
	ВалютаРегламентированногоУчета = ЗначениеНастроекПовтИсп.ВалютаРегламентированногоУчетаОрганизации(Организация);
	
	Заявка = Документы.ЗаявкаНаРасходованиеДенежныхСредств.СоздатьДокумент();
	Заявка.Заполнить(Неопределено);
	Заявка.Дата                            	= ТекущаяДатаСеанса();
	Заявка.ЖелательнаяДатаПлатежа			= Макс(ДанныеЗаполнения.Дата, НачалоДня(Заявка.Дата));
	Заявка.ДатаПлатежа             			= Заявка.ЖелательнаяДатаПлатежа;
	Заявка.ПриоритетОплаты					= Справочники.ПриоритетыОплаты.ПолучитьВысшийПриоритет();
	Заявка.КтоЗаявил						= Пользователи.ТекущийПользователь();
	Заявка.Организация                     	= Организация;
	Заявка.Статус                          	= Перечисления.СтатусыЗаявокНаРасходованиеДенежныхСредств.НеСогласована;
	Заявка.ХозяйственнаяОперация           	= Перечисления.ХозяйственныеОперации.ПеречислениеВБюджет;
	Заявка.ФормаОплатыБезналичная          	= Истина;
	Заявка.ФормаОплатыНаличная             	= Ложь;
	Заявка.ФормаОплатыЗаявки 				= Перечисления.ФормыОплаты.Безналичная;
	Заявка.СуммаДокумента                  	= ДанныеЗаполнения.Сумма;
	Заявка.Валюта                          	= ВалютаРегламентированногоУчета;
	Заявка.Контрагент                      	= Настройка.Контрагент;
	Заявка.БанковскийСчетКонтрагента       	= Настройка.БанковскийСчетКонтрагента;
	Заявка.БанковскийСчет                  	= Настройка.БанковскийСчетОрганизации;
	Заявка.СтатьяДвиженияДенежныхСредств   	= Настройка.СтатьяДДС;
	Заявка.Подразделение                   	= Настройка.Подразделение;
	Заявка.гкм_ЦентрРасходов               	= Настройка.гкм_ЦентрРасходов;
	Заявка.гкм_ОбъектСтроительства         	= Настройка.гкм_ОбъектСтроительства;
	Заявка.НазначениеПлатежа               	= ДанныеЗаполнения.НазначениеПлатежа;
	Заявка.гкм_ОснованиеЗУП               	= ДанныеЗаполнения.ОснованиеЗУП;
	Заявка.ПеречислениеВБюджет            	= Истина;
	Заявка.ТипНалога                       	= Настройка.ТипНалога;
	Заявка.КодБК                           	= Настройка.КодБК;
    Заявка.КодОКАТО 						= СтроковыеФункцииКлиентСервер.ДополнитьСтроку(Настройка.КодОКАТО, 11, " ", "Справа"); 
	Заявка.СтатусСоставителя 				= Настройка.СтатусСоставителя;
	Заявка.ПоказательОснования				= "0";
	Заявка.ПоказательПериода 				= "0";
	Заявка.ПоказательНомера 				= "0";
	Заявка.ПоказательДаты 					= "0";
	Заявка.ИННПлательщика 					= ДанныеОрганизации.ИНН;
	Заявка.КПППлательщика 					= ДанныеОрганизации.КПП;
	Заявка.ТекстПлательщика 				= ДанныеОрганизации.НаименованиеСокращенное;
	
	// Расшифровка платежа
	СтрокаРасшифровки = Заявка.РасшифровкаПлатежа.Добавить();
	СтрокаРасшифровки.СтатьяДвиженияДенежныхСредств = Настройка.СтатьяДДС;
	СтрокаРасшифровки.Сумма 						= ДанныеЗаполнения.Сумма;
	СтрокаРасшифровки.СуммаВзаиморасчетов 			= ДанныеЗаполнения.Сумма;
	СтрокаРасшифровки.ВалютаВзаиморасчетов 			= Заявка.Валюта;
	СтрокаРасшифровки.КурсЧислительВзаиморасчетов 	= 1;
	СтрокаРасшифровки.КурсЗнаменательВзаиморасчетов = 1;
	
	// Аналитика платежа
	Для Каждого СтрАналитики Из АналитикаПлатежа Цикл
		НоваяСтрока                     = Заявка.гкм_АналитикаПлатежа.Добавить();
		НоваяСтрока.Подразделение       = СтрАналитики.Подразделение;
		НоваяСтрока.ЦентрРасходов       = СтрАналитики.ЦентрРасходов;
		НоваяСтрока.ОбъектСтроительства = СтрАналитики.ОбъектСтроительства;
		НоваяСтрока.Сумма               = СтрАналитики.Сумма;
	КонецЦикла;
	
	РежимЗаписи = ?(ПараметрыСоздания.ПроводитьДокумент,
		РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись);
	Заявка.Записать(РежимЗаписи);
	
	Возврат Заявка;
	
КонецФункции

// Ищет организацию по ИНН.
//
// Параметры:
//  ОрганизацияИНН - Строка
//
// Возвращаемое значение:
//   СправочникСсылка.Организации или Неопределено
//
Функция НайтиОрганизациюПоИНН(ОрганизацияИНН)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Организации.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	Организации.ИНН = &ИНН
		|	И НЕ Организации.ПометкаУдаления";
	Запрос.УстановитьПараметр("ИНН", ОрганизацияИНН);
	Рез = Запрос.Выполнить().Выгрузить();
	
	Возврат ?(Рез.Количество() > 0, Рез[0].Ссылка, Неопределено);
	
КонецФункции

// Получает настройки зарплатного проекта из регистра.
// Для ТипИсточника = "Ведомость" - ищет по ИдПроекта.
// Для ТипИсточника = "ОтражениеЗарплаты" - ищет по организации (ИдПроекта = "").
//
// Параметры:
//  Организация   - СправочникСсылка.Организации
//  ТипИсточника  - Строка ("Ведомость" или "ОтражениеЗарплаты")
//  ИдПроекта     - Строка - GUID зарплатного проекта ЗУП (для Ведомости)
//  ТипВыплаты1   - ПеречислениеСсылка.гкм_ТипыВыплатыЗУП
//  ТипВыплаты2   - ПеречислениеСсылка.гкм_ТипыВыплатыЗУП
//
// Возвращаемое значение:
//   ТаблицаЗначений
//
Функция ПолучитьНастройкиЗарплатногоПроекта(Организация, ТипИсточника, ИдПроекта,
	ТипВыплаты1, ТипВыплаты2)
	
	Запрос = Новый Запрос;
	
	Если ТипИсточника = "ОтражениеЗарплаты" Тогда
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Настройки.ТипВыплаты                                  КАК ТипВыплаты,
			|	Настройки.Контрагент                                   КАК Контрагент,
			|	Настройки.БанковскийСчетКонтрагента                    КАК БанковскийСчетКонтрагента,
			|	Настройки.СтатьяДвиженияДенежныхСредств                КАК СтатьяДДС,
			|	Настройки.ТипНалога                                    КАК ТипНалога,
			|	Настройки.КодБК                                        КАК КодБК,
			|	Настройки.КодОКАТО                                     КАК КодОКАТО,
			|	Настройки.СтатусСоставителя                            КАК СтатусСоставителя,
			|	Настройки.БанковскийСчетОрганизации                    КАК БанковскийСчетОрганизации,
			|	Настройки.ЗарплатныйПроект.Подразделение               КАК Подразделение,
			|	Настройки.ЗарплатныйПроект.ЦентрРасходов               КАК гкм_ЦентрРасходов,
			|	Настройки.ЗарплатныйПроект.ОбъектСтроительства         КАК гкм_ОбъектСтроительства,
			|	Настройки.ЗарплатныйПроект.ПрямаяВыплата               КАК ПрямаяВыплата,
			|	Настройки.НаименованиеЗарплатногоПроектаЗУП            КАК НазначениеПлатежа
			|ИЗ
			|	РегистрСведений.гкм_НастройкиЗарплатныхПроектовЗУП КАК Настройки
			|ГДЕ
			|	Настройки.Организация = &Организация
			|	И Настройки.ИдентификаторЗарплатногоПроектаЗУП = """"
			|	И Настройки.ТипВыплаты В (&ТипыВыплат)";
		
	Иначе
		
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Настройки.ТипВыплаты                                  КАК ТипВыплаты,
			|	Настройки.Контрагент                                   КАК Контрагент,
			|	Настройки.БанковскийСчетКонтрагента                    КАК БанковскийСчетКонтрагента,
			|	Настройки.СтатьяДвиженияДенежныхСредств                КАК СтатьяДДС,
			|	Настройки.ТипНалога                                    КАК ТипНалога,
			|	Настройки.КодБК                                        КАК КодБК,
			|	Настройки.КодОКАТО                                     КАК КодОКАТО,
			|	Настройки.СтатусСоставителя                            КАК СтатусСоставителя,
			|	Настройки.БанковскийСчетОрганизации                    КАК БанковскийСчетОрганизации,
			|	Настройки.ЗарплатныйПроект.Подразделение               КАК Подразделение,
			|	Настройки.ЗарплатныйПроект.ЦентрРасходов               КАК гкм_ЦентрРасходов,
			|	Настройки.ЗарплатныйПроект.ОбъектСтроительства         КАК гкм_ОбъектСтроительства,
			|	Настройки.ЗарплатныйПроект.ПрямаяВыплата               КАК ПрямаяВыплата,
			|	Настройки.НаименованиеЗарплатногоПроектаЗУП            КАК НазначениеПлатежа
			|ИЗ
			|	РегистрСведений.гкм_НастройкиЗарплатныхПроектовЗУП КАК Настройки
			|ГДЕ
			|	Настройки.Организация = &Организация
			|	И Настройки.ИдентификаторЗарплатногоПроектаЗУП = &ИдПроекта
			|	И Настройки.ТипВыплаты В (&ТипыВыплат)";
		
		Запрос.УстановитьПараметр("ИдПроекта", ИдПроекта);
	КонецЕсли;
	
	ТипыВыплат = Новый Массив;
	ТипыВыплат.Добавить(ТипВыплаты1);
	ТипыВыплат.Добавить(ТипВыплаты2);
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ТипыВыплат",  ТипыВыплат);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Создаёт заявку на расходование ДС по зарплате (банковский проект).
//
// Параметры:
//  Организация        - СправочникСсылка.Организации
//  НастройкаЗарплата  - СтрокаТаблицыЗначений - строка настроек из регистра (тип Зарплата)
//  АналитикаПлатежа   - Массив из Структур (Подразделение, ЦентрРасходов, ОбъектСтроительства, Сумма)
//  ДанныеЗаполнения   - Структура (Номер, Дата, НазначениеПлатежа, ОснованиеЗУП, Сумма)
//  ПараметрыСоздания  - Структура (ПроводитьДокумент, ...)
//
// Возвращаемое значение:
//   ДокументОбъект.ЗаявкаНаРасходованиеДенежныхСредств
//
Функция СоздатьЗаявкуЗарплата(Организация,
							НастройкаЗарплата,
							АналитикаПлатежа,
							ДанныеЗаполнения,
							ПараметрыСоздания)
	
	ВалютаРегламентированногоУчета = ЗначениеНастроекПовтИсп.ВалютаРегламентированногоУчетаОрганизации(Организация);
							
	Заявка = Документы.ЗаявкаНаРасходованиеДенежныхСредств.СоздатьДокумент();
	Заявка.Заполнить(Неопределено);
	Заявка.Дата                            	= ТекущаяДатаСеанса();
	Заявка.ЖелательнаяДатаПлатежа			= Макс(ДанныеЗаполнения.Дата, НачалоДня(Заявка.Дата));
	Заявка.ДатаПлатежа             			= Заявка.ЖелательнаяДатаПлатежа;
    Заявка.ПриоритетОплаты					= Справочники.ПриоритетыОплаты.ПолучитьВысшийПриоритет();
	Заявка.КтоЗаявил						= Пользователи.ТекущийПользователь();
	Заявка.Организация                     	= Организация;
	Заявка.Статус                          	= Перечисления.СтатусыЗаявокНаРасходованиеДенежныхСредств.НеСогласована;
	Заявка.ХозяйственнаяОперация           	= Перечисления.ХозяйственныеОперации.ВыплатаЗарплаты;
	Заявка.ХозяйственнаяОперацияПоЗарплате 	= Перечисления.ХозяйственныеОперации.ВыплатаЗарплатыПоЗарплатномуПроекту;
	Заявка.ФормаОплатыБезналичная         	= Истина;
	Заявка.ФормаОплатыНаличная            	= Ложь;
	Заявка.ФормаОплатыЗаявки 				= Перечисления.ФормыОплаты.Безналичная;
	Заявка.СуммаДокумента                  	= ДанныеЗаполнения.Сумма;
	Заявка.Валюта                          	= ВалютаРегламентированногоУчета;
	Заявка.Контрагент                      	= НастройкаЗарплата.Контрагент;
	Заявка.БанковскийСчетКонтрагента       	= НастройкаЗарплата.БанковскийСчетКонтрагента;
	Заявка.БанковскийСчет                  	= НастройкаЗарплата.БанковскийСчетОрганизации;
	Заявка.СтатьяДвиженияДенежныхСредств   	= НастройкаЗарплата.СтатьяДДС;
	Заявка.Подразделение                   	= НастройкаЗарплата.Подразделение;
	Заявка.гкм_ЦентрРасходов               	= НастройкаЗарплата.гкм_ЦентрРасходов;
	Заявка.гкм_ОбъектСтроительства         	= НастройкаЗарплата.гкм_ОбъектСтроительства;
	Заявка.НазначениеПлатежа               	= ДанныеЗаполнения.НазначениеПлатежа;
	Заявка.НомерВедомостиНаВыплатуЗарплаты 	= ДанныеЗаполнения.Номер;
	Заявка.ДатаВедомостиНаВыплатуЗарплаты  	= ДанныеЗаполнения.Дата;
	Заявка.гкм_ОснованиеЗУП               	= ДанныеЗаполнения.ОснованиеЗУП;
	
	// Заполняем аналитику платежа
	Для Каждого СтрАналитики Из АналитикаПлатежа Цикл
		НоваяСтрока                     = Заявка.гкм_АналитикаПлатежа.Добавить();
		НоваяСтрока.Подразделение       = СтрАналитики.Подразделение;
		НоваяСтрока.ЦентрРасходов       = СтрАналитики.ЦентрРасходов;
		НоваяСтрока.ОбъектСтроительства = СтрАналитики.ОбъектСтроительства;
		НоваяСтрока.Сумма               = СтрАналитики.Сумма;
	КонецЦикла;
	
	РежимЗаписи = ?(ПараметрыСоздания.ПроводитьДокумент,
		РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись);
	Заявка.Записать(РежимЗаписи);
	
	Возврат Заявка;
	
КонецФункции
 
