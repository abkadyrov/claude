		КонецЕсли;
	КонецЦикла;
	
	Если СписокВыбора.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Сначала выберите подразделение.");
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ЦентрРасходовВыбран", ЭтотОбъект,
		ТекущиеДанные
	);
	
