// Сохраняет сопоставление физлиц с аналитикой (подразделение, центр расходов, объект).
&НаСервере
Функция СохранитьМаппингСервер()
	
	Результат = Новый Структура("Успех, Ошибка", Ложь, "");
	
	Попытка
		
		ТаблицаФизлиц = РеквизитФормыВЗначение("НесопоставленныеФизлица");
		БазаИсточник = Макс(НСтр(СтрокаСоединенияИнформационнойБазы(), "Ref"), 
			НСтр(СтрокаСоединенияИнформационнойБазы(), "File")); 
		
		МассивДляОтправки = Новый Массив;
		Для Каждого Строка Из ТаблицаФизлиц Цикл
			Элемент = Новый Структура;
			Элемент.Вставить("Идентификатор",           Строка.Идентификатор);
			Элемент.Вставить("Наименование",            Строка.Наименование);
			Элемент.Вставить("ПодразделениеГУИД",       Строка.ПодразделениеГУИД);
			Элемент.Вставить("ЦентрРасходовГУИД",       Строка.ЦентрРасходовГУИД);
			Элемент.Вставить("ОбъектСтроительстваГУИД", Строка.ОбъектСтроительстваГУИД);
			Элемент.Вставить("БазаИсточник", 			БазаИсточник);
			МассивДляОтправки.Добавить(Элемент);
		КонецЦикла;
		
		Тело = Новый Структура("Физлица", МассивДляОтправки);
		
		ПараметрыЗапроса = НовыеПараметрыЗапросаУТ();
		ПараметрыЗапроса.АдресРесурса  = ПолучитьАдресРесурсаУТ("/v1/individuals/save");
		ПараметрыЗапроса.Метод         = "POST";
		ПараметрыЗапроса.ТелоЗапроса   = ЗначениеВСтрокуJSON(Тело);
		ПараметрыЗапроса.СобытиеЖурналаРегистрации = "ВыгрузкаВедомостиВУТ.СохранениеМаппинга";
		
		РезультатЗапроса = ВыполнитьЗапрос(ПараметрыЗапроса);
		
		Если Не РезультатЗапроса.Успешно Тогда
			Результат.Ошибка = РезультатЗапроса.ТекстОшибки;
			Возврат Результат;
		КонецЕсли;
		
		Если РезультатЗапроса.КодСостояния <> КодСостоянияОК() Тогда
			Результат.Ошибка = "HTTP " + РезультатЗапроса.КодСостояния
				+ ": " + РезультатЗапроса.Ответ.ПолучитьТелоКакСтроку();
			Возврат Результат;
		КонецЕсли;
		
		ОтветДанные = ЗначениеИзСтрокиJSON(
			РезультатЗапроса.Ответ.ПолучитьТелоКакСтроку());
		
		Если ОтветДанные["Ошибки"] <> Неопределено
			И ОтветДанные["Ошибки"].Количество() > 0 Тогда
			Результат.Ошибка = СтрСоединить(ОтветДанные["Ошибки"], Символы.ПС);
			Возврат Результат;
		КонецЕсли;
		
		Результат.Успех = Истина;
		
	Исключение
		Результат.Ошибка = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Читает данные ведомости из ЗУП: физлица зарплаты и НДФЛ, реквизиты документа.
&НаСервереБезКонтекста
Функция ПолучитьДанныеВедомостиСервер(ДокументИсточник)
	
	// Запрос строк зарплаты
	ЗапросЗарплата = Новый Запрос;
	ЗапросЗарплата.Текст =
		"ВЫБРАТЬ
		|	ВедомостьЗарплата.ФизическоеЛицо КАК ФизическоеЛицо,
		|	СУММА(ВедомостьЗарплата.КВыплате) КАК Сумма,
		|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ВедомостьЗарплата.ФизическоеЛицо) КАК ИдентификаторФизлица,
		|	ВедомостьЗарплата.НомерЛицевогоСчета КАК НомерЛицевогоСчета
		|ИЗ
		|	Документ.ВедомостьНаВыплатуЗарплатыВБанк.Зарплата КАК ВедомостьЗарплата
		|ГДЕ
		|	ВедомостьЗарплата.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ВедомостьЗарплата.НомерЛицевогоСчета,
		|	ВедомостьЗарплата.ФизическоеЛицо";
	
	ЗапросЗарплата.УстановитьПараметр("Ссылка", ДокументИсточник);
	
	ТаблицаЗарплата = ЗапросЗарплата.Выполнить().Выгрузить(); 
	
	// Формируем массив физлиц
	Физлица = Новый Массив;
	Для Каждого Строка Из ТаблицаЗарплата Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("Идентификатор",      Строка(Строка.ИдентификаторФизлица));
		Элемент.Вставить("Наименование",       Строка(Строка.ФизическоеЛицо));
		Элемент.Вставить("Сумма",              Строка.Сумма);
		Элемент.Вставить("НомерЛицевогоСчета", Строка.НомерЛицевогоСчета);
		Физлица.Добавить(Элемент);
	КонецЦикла;
	
	// Запрос строк НДФЛ из отдельной ТЧ (аналогично строкам зарплаты)
	ЗапросНДФЛ = Новый Запрос;
	ЗапросНДФЛ.Текст =
		"ВЫБРАТЬ
		|	ВедомостьНДФЛ.ФизическоеЛицо КАК ФизическоеЛицо,
		|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ВедомостьНДФЛ.ФизическоеЛицо) КАК ИдентификаторФизлица,
		|	СУММА(ВедомостьНДФЛ.Сумма
		|		+ ВедомостьНДФЛ.СуммаСПревышения
		|		+ ВедомостьНДФЛ.СуммаСПревышенияПоСтавке18
		|		+ ВедомостьНДФЛ.СуммаСПревышенияПоСтавке20
		|		+ ВедомостьНДФЛ.СуммаСПревышенияПоСтавке22) КАК Сумма
		|ИЗ
		|	Документ.ВедомостьНаВыплатуЗарплатыВБанк.НДФЛ КАК ВедомостьНДФЛ
		|ГДЕ
		|	ВедомостьНДФЛ.Ссылка = &Ссылка
		|СГРУППИРОВАТЬ ПО
		|	ВедомостьНДФЛ.ФизическоеЛицо";
	
	ЗапросНДФЛ.УстановитьПараметр("Ссылка", ДокументИсточник);
	
	ТаблицаНДФЛ = ЗапросНДФЛ.Выполнить().Выгрузить();
	
	// Формируем массив физлиц НДФЛ
	ФизлицаНДФЛ = Новый Массив;
	Для Каждого Строка Из ТаблицаНДФЛ Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("Идентификатор", Строка(Строка.ИдентификаторФизлица));
		Элемент.Вставить("Наименование",  Строка(Строка.ФизическоеЛицо));
		Элемент.Вставить("Сумма",         Строка.Сумма);
		ФизлицаНДФЛ.Добавить(Элемент);
	КонецЦикла;
	
	ДокОбъект = ДокументИсточник.ПолучитьОбъект();
	
	АдресОрганизации = ПолучитьАдресОрганизации(ДокОбъект.Организация);
	
	Результат = Новый Структура;
	Результат.Вставить("Физлица",         Физлица);
	Результат.Вставить("ФизлицаНДФЛ",     ФизлицаНДФЛ);
	Результат.Вставить("СуммаПоДокументу", ТаблицаЗарплата.Итог("Сумма"));
	Результат.Вставить("СуммаНДФЛ", ТаблицаНДФЛ.Итог("Сумма"));
	Результат.Вставить("НомерВедомости",          	ДокОбъект.Номер);
	Результат.Вставить("ДатаВедомости",           	ДокОбъект.Дата);
	Результат.Вставить("ДатаВедомостиТекст",      	Формат(ДокОбъект.Дата, "ДЛФ=D") + " г.");
	Результат.Вставить("ПериодРегистрации",       НРег(Формат(ДокОбъект.ПериодРегистрации, "ДФ='MMMM yyyy'")) + " г.");
	Результат.Вставить("ПериодРегистрацииДата",   ДокОбъект.ПериодРегистрации);
	Результат.Вставить("ВидДокументаОснования",   	XMLСтрока(ДокОбъект.СпособВыплаты.ВидДокументаОснования));
	Результат.Вставить("НаименованиеОрганизации", 	ДокОбъект.Организация.Наименование);
	Результат.Вставить("АдресОрганизации",         	АдресОрганизации);
	Результат.Вставить("ОрганизацияГУИД",          	Строка(ДокОбъект.Организация.УникальныйИдентификатор()));
	Результат.Вставить("ОрганизацияИНН",           	ДокОбъект.Организация.ИНН);
	Результат.Вставить("ЗарплатныйПроектГУИД",     	Строка(ДокОбъект.ЗарплатныйПроект.УникальныйИдентификатор()));
	Результат.Вставить("ЗарплатныйПроектНаим",     	Строка(ДокОбъект.ЗарплатныйПроект));
	Результат.Вставить("ПрямаяВыплата",            	
		Не ДокОбъект.ЗарплатныйПроект.ИспользоватьЭлектронныйДокументооборотСБанком);
	
	Возврат Результат;
	
КонецФункции
 
// Возвращает строковое представление юридического адреса организации.
&НаСервереБезКонтекста
Функция ПолучитьАдресОрганизации(Организация)
	
	МассивОрганизаций = Новый  Массив;
	МассивОрганизаций.Добавить(Организация);
	
	АдресаОрганизаций = УправлениеКонтактнойИнформациейЗарплатаКадры.АдресаОрганизаций(
		МассивОрганизаций, ТекущаяДатаСеанса());
	
	ОписаниеЮридическогоАдреса = УправлениеКонтактнойИнформациейЗарплатаКадры.АдресОрганизации(АдресаОрганизаций,
		Организация, Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации);

	Возврат ОписаниеЮридическогоАдреса.Представление;
	
КонецФункции

// Устанавливает видимость полей формы в зависимости от режима выгрузки
&НаСервере
Процедура УстановитьВидимостьПоРежиму()
    РежимОтражения = РежимВыгрузки = 1;
    Элементы.Организация.Видимость                           = Не РежимОтражения;
    Элементы.Период.Видимость                                = Не РежимОтражения;
    Элементы.ТаблицаВедомостей.Видимость                    = Не РежимОтражения;
    Элементы.ЗаполнитьТаблицуВедомостей.Видимость           = Не РежимОтражения;
    Элементы.СоздаватьЗаявкиНаЗарплату.Видимость            = Не РежимОтражения;
    Элементы.СоздаватьЗаявкиНаНДФЛ.Видимость                = Не РежимОтражения;
    Элементы.ДокументИсточникОтражениеЗарплаты.Видимость    = РежимОтражения;
    Элементы.НазначениеПлатежаЕдиныйТариф.Видимость         = РежимОтражения;
    Элементы.НазначениеПлатежаФССНесчастныеСлучаи.Видимость = РежимОтражения;
КонецПроцедуры

// Читает данные документа ОтражениеЗарплатыВБухучете:
// суммирует ВзносыПоЕдиномуТарифу и ФССНесчастныеСлучаи в разрезе физлиц
&НаСервереБезКонтекста
Функция ПолучитьДанныеОтраженияЗарплатыСервер(ДокументИсточник)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ТЧ.ФизическоеЛицо) КАК Идентификатор,
		|	ТЧ.ФизическоеЛицо                          КАК ФизическоеЛицо,
		|	СУММА(ТЧ.ВзносыПоЕдиномуТарифу)            КАК ВзносыПоЕдиномуТарифу,
		|	СУММА(ТЧ.ФССНесчастныеСлучаи)              КАК ФССНесчастныеСлучаи
		|ИЗ
		|	Документ.ОтражениеЗарплатыВБухучете.НачисленнаяЗарплатаИВзносы КАК ТЧ
		|ГДЕ
		|	ТЧ.Ссылка = &Ссылка
		|СГРУППИРОВАТЬ ПО
		|	ТЧ.ФизическоеЛицо";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументИсточник);
	ТаблицаВзносов = Запрос.Выполнить().Выгрузить();
	
	ФизлицаЕТ  = Новый Массив;
	ФизлицаФСС = Новый Массив;
	
	Для Каждого Строка Из ТаблицаВзносов Цикл
		
		Ид          = Строка(Строка.Идентификатор);
		Наименование = Строка(Строка.ФизическоеЛицо);
		
		Если Строка.ВзносыПоЕдиномуТарифу <> 0 Тогда
			Элемент = Новый Структура;
			Элемент.Вставить("Идентификатор", Ид);
			Элемент.Вставить("Наименование",  Наименование);
			Элемент.Вставить("Сумма",         Строка.ВзносыПоЕдиномуТарифу);
			ФизлицаЕТ.Добавить(Элемент);
		КонецЕсли;
		
		Если Строка.ФССНесчастныеСлучаи <> 0 Тогда
			Элемент = Новый Структура;
			Элемент.Вставить("Идентификатор", Ид);
			Элемент.Вставить("Наименование",  Наименование);
			Элемент.Вставить("Сумма",         Строка.ФССНесчастныеСлучаи);
			ФизлицаФСС.Добавить(Элемент);
		КонецЕсли;
		
	КонецЦикла;
	
	ДокОбъект = ДокументИсточник.ПолучитьОбъект();
	
	Результат = Новый Структура;
	Результат.Вставить("ФизлицаЕТ",           ФизлицаЕТ);
	Результат.Вставить("ФизлицаФСС",          ФизлицаФСС);
	Результат.Вставить("НомерДокумента",       ДокОбъект.Номер);
	Результат.Вставить("ДатаДокумента",        ДокОбъект.Дата);
	Результат.Вставить("ОрганизацияИНН",       ДокОбъект.Организация.ИНН);
	Результат.Вставить("ПериодРегистрации",    НРег(Формат(ДокОбъект.ПериодРегистрации, "ДФ='MMMM yyyy'")) + " г.");
	
	Возврат Результат;
	
КонецФункции

// Подготавливает данные отражения зарплаты и помещает во временное хранилище.
&НаСервере
Функция ПодготовитьДанныеОтраженияСервер(Знач ДокументИсточник)
	
	Результат = Новый Структура("Успех, АдресДанных, НазначениеЕТ, НазначениеФСС, Ошибка",
		Ложь, "", "", "", "");
	
	Попытка
		ДанныеОтражения = ПолучитьДанныеОтраженияЗарплатыСервер(ДокументИсточник);
		
		// Получаем шаблоны назначений платежей из УТ по ИНН организации
		ПараметрыЗапроса = НовыеПараметрыЗапросаУТ();
		ПараметрыЗапроса.АдресРесурса = ПолучитьАдресРесурсаУТ(
			"/v1/payrollproject/get?inn=" + ДанныеОтражения.ОрганизацияИНН);
		ПараметрыЗапроса.Метод = "GET";
		ПараметрыЗапроса.СобытиеЖурналаРегистрации = "ВыгрузкаВедомостиВУТ.ПолучениеШаблоновВзносов";
		
		РезультатЗапроса = ВыполнитьЗапрос(ПараметрыЗапроса);
		
		Если РезультатЗапроса.Успешно
			И РезультатЗапроса.КодСостояния = КодСостоянияОК() Тогда
			
			ДанныеПроекта = ЗначениеИзСтрокиJSON(
				РезультатЗапроса.Ответ.ПолучитьТелоКакСтроку(), Истина);
			
			Если ДанныеПроекта["Найден"] = Истина Тогда
				Шаблоны = ДанныеПроекта["Шаблоны"];
				Если ТипЗнч(Шаблоны) = Тип("Соответствие") Тогда
					
					// Подставляем только [Период] - остальные плейсхолдеры не применимы для взносов
					ШаблонЕТ  = ?(Шаблоны["Взносы по единому тарифу"] <> Неопределено,
						Шаблоны["Взносы по единому тарифу"], "");
					ШаблонФСС = ?(Шаблоны["ФСС несчастные случаи"] <> Неопределено,
						Шаблоны["ФСС несчастные случаи"], "");
					
					ДанныеОтражения.Вставить("НазначениеЕТ",
						СтрЗаменить(ШаблонЕТ,  "[Период]", ДанныеОтражения.ПериодРегистрации));
					ДанныеОтражения.Вставить("НазначениеФСС",
						СтрЗаменить(ШаблонФСС, "[Период]", ДанныеОтражения.ПериодРегистрации));
					
					Результат.НазначениеЕТ  = ДанныеОтражения.НазначениеЕТ;
					Результат.НазначениеФСС = ДанныеОтражения.НазначениеФСС;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Результат.АдресДанных = ПоместитьВоВременноеХранилище(
			ДанныеОтражения, УникальныйИдентификатор);
		Результат.Успех = Истина;
	Исключение
		Результат.Ошибка = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Проверяет наличие и заполненность настроек взносов в УТ для данной организации.
&НаСервере
Функция ПроверитьНастройкиВзносовСервер(Знач АдресДанныхОтражения)
	
	Результат = Новый Структура(
		"HTTPУспех, НастройкаВыполнена, НезаполненныеПоля, Ошибка",
		Ложь, Ложь, Новый Массив, ""
	);
	
	Попытка
		
		ДанныеОтражения = ПолучитьИзВременногоХранилища(АдресДанныхОтражения);
		
		Тело = Новый Структура(
			"ОрганизацияИНН, ТипИсточника",
			ДанныеОтражения.ОрганизацияИНН,
			"ОтражениеЗарплаты"
		);
		
		ПараметрыЗапроса = НовыеПараметрыЗапросаУТ();
		ПараметрыЗапроса.АдресРесурса  = ПолучитьАдресРесурсаУТ("/v1/payrollproject/check");
		ПараметрыЗапроса.Метод         = "POST";
		ПараметрыЗапроса.ТелоЗапроса   = ЗначениеВСтрокуJSON(Тело);
		ПараметрыЗапроса.СобытиеЖурналаРегистрации = "ВыгрузкаВедомостиВУТ.ПроверкаНастроекВзносов";
		
		РезультатЗапроса = ВыполнитьЗапрос(ПараметрыЗапроса);
		
		Если Не РезультатЗапроса.Успешно Тогда
			Результат.Ошибка = РезультатЗапроса.ТекстОшибки;
			Возврат Результат;
		КонецЕсли;
		
		Если РезультатЗапроса.КодСостояния <> КодСостоянияОК() Тогда
			Результат.Ошибка = "HTTP " + РезультатЗапроса.КодСостояния
				+ ": " + РезультатЗапроса.Ответ.ПолучитьТелоКакСтроку();
			Возврат Результат;
		КонецЕсли;
		
		ОтветДанные = ЗначениеИзСтрокиJSON(
			РезультатЗапроса.Ответ.ПолучитьТелоКакСтроку());
		
		Результат.HTTPУспех          = Истина;
		Результат.НастройкаВыполнена = ОтветДанные["НастройкаВыполнена"];
		Результат.НезаполненныеПоля  = ?(ОтветДанные["НезаполненныеПоля"] <> Неопределено,
			ОтветДанные["НезаполненныеПоля"], Новый Массив);
		
	Исключение
		Результат.Ошибка = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Проверяет сопоставление физлиц из отражения зарплаты.
&НаСервере
Функция ПроверитьСопоставлениеОтраженияСервер(Знач АдресДанныхОтражения)
	
	Результат = Новый Структура(
		"HTTPУспех, ЕстьНесопоставленные, Физлица, Ошибка",
		Ложь, Ложь, Новый Массив, ""
	);
	
	Попытка
		
		ДанныеОтражения = ПолучитьИзВременногоХранилища(АдресДанныхОтражения);
		
		// Объединяем физлиц из обоих массивов без дублей
		СловарьФизлиц = Новый Соответствие;
		Для Каждого Физлицо Из ДанныеОтражения.ФизлицаЕТ Цикл
			СловарьФизлиц.Вставить(Физлицо.Идентификатор,
				Новый Структура("Идентификатор, Наименование",
					Физлицо.Идентификатор, Физлицо.Наименование));
		КонецЦикла;
		Для Каждого Физлицо Из ДанныеОтражения.ФизлицаФСС Цикл
			СловарьФизлиц.Вставить(Физлицо.Идентификатор,
				Новый Структура("Идентификатор, Наименование",
					Физлицо.Идентификатор, Физлицо.Наименование));
		КонецЦикла;
		
		МассивДляПроверки = Новый Массив;
		Для Каждого КЗ Из СловарьФизлиц Цикл
			МассивДляПроверки.Добавить(КЗ.Значение);
		КонецЦикла;
		
		Тело = Новый Структура("Физлица", МассивДляПроверки);
		
		ПараметрыЗапроса = НовыеПараметрыЗапросаУТ();
		ПараметрыЗапроса.АдресРесурса  = ПолучитьАдресРесурсаУТ("/v1/individuals/check");
		ПараметрыЗапроса.Метод         = "POST";
		ПараметрыЗапроса.ТелоЗапроса   = ЗначениеВСтрокуJSON(Тело);
		ПараметрыЗапроса.СобытиеЖурналаРегистрации = "ВыгрузкаВедомостиВУТ.ПроверкаСопоставленияОтражения";
		
		РезультатЗапроса = ВыполнитьЗапрос(ПараметрыЗапроса);
		
		Если Не РезультатЗапроса.Успешно Тогда
			Результат.Ошибка = РезультатЗапроса.ТекстОшибки;
			Возврат Результат;
		КонецЕсли;
		
		Если РезультатЗапроса.КодСостояния <> КодСостоянияОК() Тогда
			Результат.Ошибка = "HTTP " + РезультатЗапроса.КодСостояния
				+ ": " + РезультатЗапроса.Ответ.ПолучитьТелоКакСтроку();
			Возврат Результат;
		КонецЕсли;
		
		ОтветДанные = ЗначениеИзСтрокиJSON(
			РезультатЗапроса.Ответ.ПолучитьТелоКакСтроку());
		
		Результат.HTTPУспех            = Истина;
		Результат.ЕстьНесопоставленные = ОтветДанные["ЕстьНесопоставленные"];
		Результат.Физлица              = ОтветДанные["Физлица"];
		
	Исключение
		Результат.Ошибка = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Выгружает данные документа ОтражениеЗарплатыВБухучете в УТ как заявки на соц. отчисления
&НаСервере
Процедура ВыполнитьВыгрузкуОтраженияЗарплатыСервер(Знач АдресДанныхОтражения)
	
	Попытка
		
		ДанныеОтражения = ПолучитьИзВременногоХранилища(АдресДанныхОтражения);
		
		Если ДанныеОтражения.ФизлицаЕТ.Количество() = 0
			И ДанныеОтражения.ФизлицаФСС.Количество() = 0 Тогда
			РезультатВыгрузки = "Нет данных для выгрузки: суммы взносов равны нулю.";
			Возврат;
		КонецЕсли;
		
		ДополнительныеПараметры = Новый Структура(
			"ПроводитьДокумент, РежимТестирования",
			ПроводитьЗаявки, РежимТестирования);
		
		Тело = Новый Структура;
		Тело.Вставить("ТипИсточника",    "ОтражениеЗарплаты");
		Тело.Вставить("Документ",        Новый Структура(
			"Номер, Дата, ОрганизацияИНН, ОснованиеЗУП",
			ДанныеОтражения.НомерДокумента,
			ДанныеОтражения.ДатаДокумента,
			ДанныеОтражения.ОрганизацияИНН,
			Строка(ДокументИсточникОтражениеЗарплаты)
		));
		Тело.Вставить("СтрокиЕТ",                  ДанныеОтражения.ФизлицаЕТ);
		Тело.Вставить("СтрокиФСС",                 ДанныеОтражения.ФизлицаФСС);
		Тело.Вставить("НазначениеЕТ",              НазначениеПлатежаЕдиныйТариф);
		Тело.Вставить("НазначениеФСС",             НазначениеПлатежаФССНесчастныеСлучаи);
		Тело.Вставить("ДополнительныеПараметры",   ДополнительныеПараметры);
		
		ПараметрыЗапроса = НовыеПараметрыЗапросаУТ();
		ПараметрыЗапроса.АдресРесурса  = ПолучитьАдресРесурсаУТ("/v1/paymentrequests/create");
		ПараметрыЗапроса.Метод         = "POST";
		ПараметрыЗапроса.ТелоЗапроса   = ЗначениеВСтрокуJSON(Тело);
		ПараметрыЗапроса.СобытиеЖурналаРегистрации = "ВыгрузкаВедомостиВУТ.ВыгрузкаОтраженияЗарплаты";
		
		РезультатЗапроса = ВыполнитьЗапрос(ПараметрыЗапроса);
		
		Если Не РезультатЗапроса.Успешно Тогда
			РезультатВыгрузки = "Ошибка: " + РезультатЗапроса.ТекстОшибки;
			Возврат;
		КонецЕсли;
		
		Если РезультатЗапроса.КодСостояния <> КодСостоянияОК() Тогда
			РезультатВыгрузки = "Ошибка выгрузки: HTTP " + РезультатЗапроса.КодСостояния
				+ Символы.ПС + РезультатЗапроса.Ответ.ПолучитьТелоКакСтроку();
			Возврат;
		КонецЕсли;
		
		ОтветДанные = ЗначениеИзСтрокиJSON(
			РезультатЗапроса.Ответ.ПолучитьТелоКакСтроку());
		
		МассивЗаявок     = ОтветДанные["Заявки"];
		ОбщаяСуммаЕТ     = 0;
		ОбщаяСуммаФСС    = 0;
		ТекстРезультата  = "";
		
		Для Каждого Заявка Из МассивЗаявок Цикл
			Сумма      = Заявка["Сумма"];
			ТипВыплаты = Заявка["ТипВыплаты"];
			Если ТипВыплаты = "ФССНесчастныеСлучаи" Тогда
				ОбщаяСуммаФСС = ОбщаяСуммаФСС + Сумма;
			Иначе
				ОбщаяСуммаЕТ = ОбщаяСуммаЕТ + Сумма;
			КонецЕсли;
			ТекстРезультата = ТекстРезультата
				+ "• " + Заявка["Номер"] + " от " + Заявка["Дата"]
				+ " на сумму " + Формат(Сумма, "ЧДЦ=2; ЧРГ= ") + " руб."
				+ " (" + ТипВыплаты + ")" + Символы.ПС;
		КонецЦикла;
		
		ТекстРезультата = "Создано заявок: " + МассивЗаявок.Количество() + Символы.ПС
			+ "Взносы по ЕТ: "         + Формат(ОбщаяСуммаЕТ,  "ЧДЦ=2; ЧРГ= ") + " руб." + Символы.ПС
			+ "ФСС (несч. случаи): "   + Формат(ОбщаяСуммаФСС, "ЧДЦ=2; ЧРГ= ") + " руб." + Символы.ПС
			+ Символы.ПС + ТекстРезультата;
		
		РезультатВыгрузки = ТекстРезультата;
		
	Исключение
		РезультатВыгрузки = "Ошибка: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
КонецПроцедуры

// Заполняет ТЧ ТаблицаВедомостей по организации и периоду.
// Для каждой найденной ведомости запрашивает данные зарплатного проекта из УТ (с кешем).
&НаСервере
Функция ЗаполнитьТаблицуВедомостейСервер(Знач Организация, Знач ДатаНачала, Знач ДатаОкончания)
	
	Результат = Новый Структура("Успех, Ошибка", Ложь, "");
	
	Попытка
		
		// Запрос ведомостей по организации и периоду
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Ведомость.Ссылка       КАК Ссылка,
			|	Ведомость.Номер        КАК Номер,
			|	Ведомость.Дата         КАК Дата
			|ИЗ
			|	Документ.ВедомостьНаВыплатуЗарплатыВБанк КАК Ведомость
			|ГДЕ
			|	Ведомость.Организация = &Организация
			|	И Ведомость.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
			|	И НЕ Ведомость.ПометкаУдаления
			|УПОРЯДОЧИТЬ ПО
			|	Ведомость.Дата";
		Запрос.УстановитьПараметр("Организация", Организация);
		Запрос.УстановитьПараметр("ДатаНачала",  ?(ЗначениеЗаполнено(ДатаНачала),  ДатаНачала,  '00010101'));
		Запрос.УстановитьПараметр("ДатаОкончания", ?(ЗначениеЗаполнено(ДатаОкончания), ДатаОкончания, '99991231'));
		
		ТаблицаВедомостей.Очистить();
		
		Выборка = Запрос.Выполнить().Выгрузить();
		
		МассивДокументов = Новый Массив;
		Для Каждого Строка Из Выборка Цикл
			МассивДокументов.Добавить(Строка.Ссылка);
		КонецЦикла;
		
		РезультатДобавления = ДобавитьВедомостиВТаблицуСервер(МассивДокументов);
		
		Если Не РезультатДобавления.Успех Тогда
			Результат.Ошибка = РезультатДобавления.Ошибка;
			Возврат Результат;
		КонецЕсли;
		
		Результат.Успех = Истина;
		
	Исключение
		Результат.Ошибка = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Проверяет зарплатные проекты для всех выбранных ведомостей (с кешем по ГУИД проекта).
// При первом не найденном или не донастроенном проекте останавливается и возвращает описание ошибки.
&НаСервере
Функция ПроверитьЗарплатныеПроектыВедомостейСервер(Знач МассивАдресов)
	
	Результат = Новый Структура(
		"HTTPУспех, Найден, НастройкаВыполнена, НезаполненныеПоля, ДокументПредставление, АдресДанных, Ошибка",
		Ложь, Истина, Истина, Новый Массив, "", "", ""
	);
	
	Попытка
		
		КешПроверок = Новый Соответствие; // ключ - ЗарплатныйПроектГУИД, значение - результат проверки
		
		Для Каждого Адрес Из МассивАдресов Цикл
			
			ДанныеВедомости = ПолучитьИзВременногоХранилища(Адрес);
			ГУИДПроекта     = ДанныеВедомости.ЗарплатныйПроектГУИД;
			
			РезультатПроверки = КешПроверок[ГУИДПроекта];
			Если РезультатПроверки = Неопределено Тогда
				
				Тело = Новый Структура;
				Тело.Вставить("ИдентификаторЗарплатногоПроекта", ГУИДПроекта);
				Тело.Вставить("ОрганизацияИНН",       ДанныеВедомости.ОрганизацияИНН);
				
				ПараметрыЗапроса = НовыеПараметрыЗапросаУТ();
				ПараметрыЗапроса.АдресРесурса  = ПолучитьАдресРесурсаУТ("/v1/payrollproject/check");
				ПараметрыЗапроса.Метод         = "POST";
				ПараметрыЗапроса.ТелоЗапроса   = ЗначениеВСтрокуJSON(Тело);
				ПараметрыЗапроса.СобытиеЖурналаРегистрации = "ВыгрузкаВедомостиВУТ.ПроверкаПроекта";
				
				РезультатЗапроса = ВыполнитьЗапрос(ПараметрыЗапроса);
				
				Если Не РезультатЗапроса.Успешно Тогда
					Результат.Ошибка = РезультатЗапроса.ТекстОшибки;
					Возврат Результат;
				КонецЕсли;
				
				Если РезультатЗапроса.КодСостояния <> КодСостоянияОК() Тогда
					Результат.Ошибка = "HTTP " + РезультатЗапроса.КодСостояния
						+ ": " + РезультатЗапроса.Ответ.ПолучитьТелоКакСтроку();
					Возврат Результат;
				КонецЕсли;
				
				ОтветДанные       = ЗначениеИзСтрокиJSON(РезультатЗапроса.Ответ.ПолучитьТелоКакСтроку());
				РезультатПроверки = Новый Структура(
					"Найден, НастройкаВыполнена, НезаполненныеПоля",
					ОтветДанные["Найден"],
					?(ОтветДанные["НастройкаВыполнена"] <> Неопределено, ОтветДанные["НастройкаВыполнена"], Истина),
					?(ОтветДанные["НезаполненныеПоля"] <> Неопределено, ОтветДанные["НезаполненныеПоля"], Новый Массив)
				);
				КешПроверок.Вставить(ГУИДПроекта, РезультатПроверки);
				
			КонецЕсли;
			
			// Останавливаемся на первой проблеме
			Если Не РезультатПроверки.Найден Тогда
				Результат.HTTPУспех             = Истина;
				Результат.Найден                = Ложь;
				Результат.ДокументПредставление = Строка(ДанныеВедомости.ОснованиеЗУП);
				Результат.АдресДанных           = Адрес;
				Возврат Результат;
			КонецЕсли;
			
			Если Не РезультатПроверки.НастройкаВыполнена Тогда
				Результат.HTTPУспех             = Истина;
				Результат.НастройкаВыполнена    = Ложь;
				Результат.НезаполненныеПоля     = РезультатПроверки.НезаполненныеПоля;
				Результат.ДокументПредставление = Строка(ДанныеВедомости.ОснованиеЗУП);
				Возврат Результат;
			КонецЕсли;
			
		КонецЦикла;
		
		Результат.HTTPУспех = Истина;
		
	Исключение
		Результат.Ошибка = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Обновляет назначения платежа для выбранных строк таблицы из УТ.
// Использует кеш по ЗарплатныйПроектГУИД чтобы не делать лишних запросов.
&НаСервере
Функция ОбновитьНазначениеПлатежаСервер()
	
	Результат = Новый Структура("Успех, Ошибка", Ложь, "");
	
	Попытка
		
		КешПроектов = Новый Соответствие;
		
		Для Каждого Строка Из ТаблицаВедомостей Цикл
			
			Если Не Строка.Выбрать Тогда
				Продолжить;
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(Строка.АдресДанных) Тогда
				Продолжить;
			КонецЕсли;
			
			ДанныеВедомости = ПолучитьИзВременногоХранилища(Строка.АдресДанных);
			ГУИДПроекта     = ДанныеВедомости.ЗарплатныйПроектГУИД;
			
			ДанныеПроекта = КешПроектов[ГУИДПроекта];
			Если ДанныеПроекта = Неопределено Тогда
				
				ПараметрыЗапроса = НовыеПараметрыЗапросаУТ();
				ПараметрыЗапроса.АдресРесурса = ПолучитьАдресРесурсаУТ(
					"/v1/payrollproject/get?id=" + ГУИДПроекта
					+ "&inn=" + ДанныеВедомости.ОрганизацияИНН);
				ПараметрыЗапроса.Метод = "GET";
				ПараметрыЗапроса.СобытиеЖурналаРегистрации = "ВыгрузкаВедомостиВУТ.ОбновлениеНазначений";
				
				РезультатЗапроса = ВыполнитьЗапрос(ПараметрыЗапроса);
				
				Если Не РезультатЗапроса.Успешно Тогда
					Результат.Ошибка = "Ошибка получения зарплатного проекта: "
						+ РезультатЗапроса.ТекстОшибки;
					Возврат Результат;
				КонецЕсли;
				
				Если РезультатЗапроса.КодСостояния <> КодСостоянияОК() Тогда
					Результат.Ошибка = "Ошибка получения зарплатного проекта: HTTP "
						+ РезультатЗапроса.КодСостояния + Символы.ПС
						+ РезультатЗапроса.Ответ.ПолучитьТелоКакСтроку();
					Возврат Результат;
				КонецЕсли;
				
				ДанныеПроекта = ЗначениеИзСтрокиJSON(
					РезультатЗапроса.Ответ.ПолучитьТелоКакСтроку(), Истина);
				
				КешПроектов.Вставить(ГУИДПроекта, ДанныеПроекта);
				
			КонецЕсли;
			
			Шаблоны         = ДанныеПроекта["Шаблоны"];
			БанковскиеСчета = ДанныеПроекта["БанковскиеСчета"];
			ШаблонЗарплата       = ?(ТипЗнч(Шаблоны) = Тип("Соответствие") И Шаблоны["Зарплата"] <> Неопределено, Шаблоны["Зарплата"], "");
			ШаблонНДФЛ          = ?(ТипЗнч(Шаблоны) = Тип("Соответствие") И Шаблоны["НДФЛ"]     <> Неопределено, Шаблоны["НДФЛ"],     "");
			НовыйСчетОрганизации = ?(ТипЗнч(БанковскиеСчета) = Тип("Соответствие") И БанковскиеСчета["НДФЛ"] <> Неопределено, БанковскиеСчета["НДФЛ"], "");
			
			Строка.НазначениеПлатежаЗарплата = ПодставитьПлейсхолдеры(ШаблонЗарплата, ДанныеВедомости, ДанныеПроекта);
			Строка.НазначениеПлатежаНДФЛ    = ПодставитьПлейсхолдеры(ШаблонНДФЛ,    ДанныеВедомости, ДанныеПроекта);
			
			// Обновляем назначения и счёт в данных ведомости во временном хранилище
			ДанныеВедомости.НазначениеЗарплата       = Строка.НазначениеПлатежаЗарплата;
			ДанныеВедомости.НазначениеНДФЛ           = Строка.НазначениеПлатежаНДФЛ;
			ДанныеВедомости.БанковскийСчетОрганизации = НовыйСчетОрганизации;
			ПоместитьВоВременноеХранилище(ДанныеВедомости, Строка.АдресДанных);
			
		КонецЦикла;
		
		Результат.Успех = Истина;
		
	Исключение
		Результат.Ошибка = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Добавляет переданные ведомости в ТЧ ТаблицаВедомостей.
// Загружает данные из УТ, подставляет плейсхолдеры, проверяет созданные заявки.
&НаСервере
Функция ДобавитьВедомостиВТаблицуСервер(Знач МассивДокументов)
	
	Результат = Новый Структура("Успех, Ошибка", Ложь, "");
	
	Попытка
		
		// Кеш данных проектов УТ: ключ - ЗарплатныйПроектГУИД, значение - данные из УТ
		КешПроектов = Новый Соответствие;
		
		// Сортируем документы чтобы строки добавлялись в нужном порядке
		СписокДокументов = Новый СписокЗначений;
		СписокДокументов.ЗагрузитьЗначения(МассивДокументов);
		СписокДокументов.СортироватьПоЗначению(НаправлениеСортировки.Возр);
		МассивДокументов = СписокДокументов.ВыгрузитьЗначения();
		
		Для Каждого Документ Из МассивДокументов Цикл
			
			// Читаем данные ведомости из ЗУП
			ДанныеВедомости = ПолучитьДанныеВедомостиСервер(Документ);
			
			// Получаем данные проекта из УТ (с кешем)
			ГУИДПроекта = ДанныеВедомости.ЗарплатныйПроектГУИД;
			
			ДанныеПроекта = КешПроектов[ГУИДПроекта];
			Если ДанныеПроекта = Неопределено Тогда
				
				ПараметрыЗапроса = НовыеПараметрыЗапросаУТ();
				ПараметрыЗапроса.АдресРесурса = ПолучитьАдресРесурсаУТ(
					"/v1/payrollproject/get?id=" + ГУИДПроекта
					+ "&inn=" + ДанныеВедомости.ОрганизацияИНН);
				ПараметрыЗапроса.Метод = "GET";
				ПараметрыЗапроса.СобытиеЖурналаРегистрации = "ВыгрузкаВедомостиВУТ.ПолучениеПроекта";
				
				РезультатЗапроса = ВыполнитьЗапрос(ПараметрыЗапроса);
				
				Если Не РезультатЗапроса.Успешно Тогда
					Результат.Ошибка = "Ошибка получения зарплатного проекта: "
						+ РезультатЗапроса.ТекстОшибки;
					Возврат Результат;
				КонецЕсли;
				
				Если РезультатЗапроса.КодСостояния <> КодСостоянияОК() Тогда
					Результат.Ошибка = "Ошибка получения зарплатного проекта: HTTP "
						+ РезультатЗапроса.КодСостояния + Символы.ПС
						+ РезультатЗапроса.Ответ.ПолучитьТелоКакСтроку();
					Возврат Результат;
				КонецЕсли;
				
				ДанныеПроекта = ЗначениеИзСтрокиJSON(
					РезультатЗапроса.Ответ.ПолучитьТелоКакСтроку(), Истина);
				
				КешПроектов.Вставить(ГУИДПроекта, ДанныеПроекта);
				
			КонецЕсли;
			
			// Подставляем плейсхолдеры
			Шаблоны         = ДанныеПроекта["Шаблоны"];
			БанковскиеСчета = ДанныеПроекта["БанковскиеСчета"];
			ШаблонЗарплата            = ?(ТипЗнч(Шаблоны) = Тип("Соответствие") И Шаблоны["Зарплата"] <> Неопределено, Шаблоны["Зарплата"], "");
			ШаблонНДФЛ               = ?(ТипЗнч(Шаблоны) = Тип("Соответствие") И Шаблоны["НДФЛ"]     <> Неопределено, Шаблоны["НДФЛ"],     "");
			БанковскийСчетОрганизации = ?(ТипЗнч(БанковскиеСчета) = Тип("Соответствие") И БанковскиеСчета["НДФЛ"] <> Неопределено, БанковскиеСчета["НДФЛ"], "");
			
			НазначениеЗарплата = ПодставитьПлейсхолдеры(ШаблонЗарплата, ДанныеВедомости, ДанныеПроекта);
			НазначениеНДФЛ    = ПодставитьПлейсхолдеры(ШаблонНДФЛ,    ДанныеВедомости, ДанныеПроекта);
			
			// Сохраняем данные ведомости во временное хранилище
			ДанныеВедомости.Вставить("НазначениеЗарплата",       НазначениеЗарплата);
			ДанныеВедомости.Вставить("НазначениеНДФЛ",           НазначениеНДФЛ);
			ДанныеВедомости.Вставить("БанковскийСчетОрганизации", БанковскийСчетОрганизации);
			ДанныеВедомости.Вставить("ОснованиеЗУП",             Строка(Документ));
			ДанныеВедомости.Вставить("ПрямаяВыплата",
				?(ДанныеПроекта["ПрямаяВыплата"] <> Неопределено, ДанныеПроекта["ПрямаяВыплата"], Ложь));
			
			АдресДанных = ПоместитьВоВременноеХранилище(ДанныеВедомости, УникальныйИдентификатор);
			
			// Добавляем строку в ТЧ если такого документа ещё нет
			СтрокаТЧ = Неопределено;
			Для Каждого Строка Из ТаблицаВедомостей Цикл
				Если Строка.ДокументИсточник = Документ Тогда
					СтрокаТЧ = Строка;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если СтрокаТЧ = Неопределено Тогда
				СтрокаТЧ = ТаблицаВедомостей.Добавить();
			КонецЕсли;
			
			СтрокаТЧ.Выбрать                  = Истина;
			СтрокаТЧ.ДокументИсточник         = Документ;
			СтрокаТЧ.НазначениеПлатежаЗарплата = НазначениеЗарплата;
			СтрокаТЧ.НазначениеПлатежаНДФЛ    = НазначениеНДФЛ;
			СтрокаТЧ.СуммаПоДокументу         = ДанныеВедомости.СуммаПоДокументу;
			СтрокаТЧ.СуммаНДФЛ               = ДанныеВедомости.СуммаНДФЛ;       
			СтрокаТЧ.АдресДанных              = АдресДанных;
			
		КонецЦикла;
		
		// Батчевая проверка наличия заявок в УТ - только по переданным документам
		// Собираем основания только для строк которые мы только что добавили/обновили
		СловарьДокументов = Новый Соответствие;
		Для Каждого Документ Из МассивДокументов Цикл
			СловарьДокументов.Вставить(Документ, Истина);
		КонецЦикла;
		
		Основания = Новый Массив;
		Для Каждого Строка Из ТаблицаВедомостей Цикл
			Если ЗначениеЗаполнено(Строка.АдресДанных)
				И СловарьДокументов[Строка.ДокументИсточник] <> Неопределено Тогда
				Данные = ПолучитьИзВременногоХранилища(Строка.АдресДанных);
				Основания.Добавить(Данные.ОснованиеЗУП);
			КонецЕсли;
		КонецЦикла;
		
		Если Основания.Количество() > 0 Тогда
			
			Тело = Новый Структура("Основания", Основания);
			ПараметрыЗапроса = НовыеПараметрыЗапросаУТ();
			ПараметрыЗапроса.АдресРесурса  = ПолучитьАдресРесурсаУТ("/v1/paymentrequests/check");
			ПараметрыЗапроса.Метод         = "POST";
			ПараметрыЗапроса.ТелоЗапроса   = ЗначениеВСтрокуJSON(Тело);
			ПараметрыЗапроса.СобытиеЖурналаРегистрации = "ВыгрузкаВедомостиВУТ.ПроверкаЗаявок";
			
			РезультатЗапроса = ВыполнитьЗапрос(ПараметрыЗапроса);
			
			Если РезультатЗапроса.Успешно И РезультатЗапроса.КодСостояния = КодСостоянияОК() Тогда
				
				ОтветДанные = ЗначениеИзСтрокиJSON(РезультатЗапроса.Ответ.ПолучитьТелоКакСтроку());
				Результаты  = ОтветДанные["Результаты"];
				
				// Строим соответствие Основание -> НомераЗаявок
				СловарьНомеров = Новый Соответствие;
				Если ТипЗнч(Результаты) = Тип("Массив") Тогда
					Для Каждого Запись Из Результаты Цикл
						Номера = Запись["Номера"];
						Если ТипЗнч(Номера) = Тип("Массив") И Номера.Количество() > 0 Тогда
							СловарьНомеров.Вставить(Запись["ОснованиеЗУП"], СтрСоединить(Номера, ", "));
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				
				// Заполняем колонку Заявка только для строк из текущего пакета
				Для Каждого Строка Из ТаблицаВедомостей Цикл
					Если Не ЗначениеЗаполнено(Строка.АдресДанных) Тогда
						Продолжить;
					КонецЕсли;
					Если СловарьДокументов[Строка.ДокументИсточник] = Неопределено Тогда
						Продолжить;
					КонецЕсли;
					Данные = ПолучитьИзВременногоХранилища(Строка.АдресДанных);
					НомераЗаявок = СловарьНомеров[Данные.ОснованиеЗУП];
					Строка.Заявка = ?(НомераЗаявок <> Неопределено, НомераЗаявок, "");
					// Если заявки уже созданы - снимаем флаг Выбрать
					Если НомераЗаявок <> Неопределено Тогда
						Строка.Выбрать = Ложь;
					КонецЕсли;
				КонецЦикла;
				
			КонецЕсли;
		КонецЕсли;
		
		Результат.Успех = Истина;
		
	Исключение
		Результат.Ошибка = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Проверяет сопоставление физлиц сразу по всем выбранным ведомостям одним запросом.
&НаСервере
Функция ПроверитьСопоставлениеВедомостейСервер(Знач МассивАдресов)
	
	Результат = Новый Структура(
		"HTTPУспех, ЕстьНесопоставленные, Физлица, Ошибка",
		Ложь, Ложь, Новый Массив, ""
	);
	
	Попытка
		
		// Собираем уникальных физлиц по всем выбранным ведомостям
		СловарьФизлиц = Новый Соответствие;
		Для Каждого Адрес Из МассивАдресов Цикл
			ДанныеВедомости = ПолучитьИзВременногоХранилища(Адрес);
			Для Каждого Физлицо Из ДанныеВедомости.Физлица Цикл
				СловарьФизлиц.Вставить(Физлицо["Идентификатор"],
					Новый Структура("Идентификатор, Наименование",
						Физлицо["Идентификатор"], Физлицо["Наименование"]));
			КонецЦикла;
		КонецЦикла;
		
		МассивДляПроверки = Новый Массив;
		Для Каждого КЗ Из СловарьФизлиц Цикл
			МассивДляПроверки.Добавить(КЗ.Значение);
		КонецЦикла;
		
		Тело = Новый Структура("Физлица", МассивДляПроверки);
		
		ПараметрыЗапроса = НовыеПараметрыЗапросаУТ();
		ПараметрыЗапроса.АдресРесурса  = ПолучитьАдресРесурсаУТ("/v1/individuals/check");
		ПараметрыЗапроса.Метод         = "POST";
		ПараметрыЗапроса.ТелоЗапроса   = ЗначениеВСтрокуJSON(Тело);
		ПараметрыЗапроса.СобытиеЖурналаРегистрации = "ВыгрузкаВедомостиВУТ.ПроверкаСопоставленияВедомостей";
		
		РезультатЗапроса = ВыполнитьЗапрос(ПараметрыЗапроса);
		
		Если Не РезультатЗапроса.Успешно Тогда
			Результат.Ошибка = РезультатЗапроса.ТекстОшибки;
			Возврат Результат;
		КонецЕсли;
		
		Если РезультатЗапроса.КодСостояния <> КодСостоянияОК() Тогда
			Результат.Ошибка = "HTTP " + РезультатЗапроса.КодСостояния
				+ ": " + РезультатЗапроса.Ответ.ПолучитьТелоКакСтроку();
			Возврат Результат;
		КонецЕсли;
		
		ОтветДанные = ЗначениеИзСтрокиJSON(РезультатЗапроса.Ответ.ПолучитьТелоКакСтроку());
		
		Результат.HTTPУспех            = Истина;
		Результат.ЕстьНесопоставленные = ОтветДанные["ЕстьНесопоставленные"];
		Результат.Физлица              = ОтветДанные["Физлица"];
		
	Исключение
		Результат.Ошибка = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Формирует пакет из всех выбранных ведомостей (зарплата + агрегированный НДФЛ)
// и отправляет одним POST-запросом в УТ для создания в единой транзакции.
&НаСервере
Процедура ВыполнитьВыгрузкуВыбранныхВедомостей(Знач МассивАдресов)
	
	Попытка
		
		ВсегоСозданоЗаявок   = 0;
		ТекстРезультата      = "";
		СловарьНомеровЗаявок = Новый Соответствие;
		
		// Формируем единый пакет: зарплата по каждой ведомости + агрегированный НДФЛ
		ЭлементыПакета = Новый Массив;
		АгрегацияНДФЛ  = Новый Соответствие;
		
		ДополнительныеПараметры = Новый Структура(
			"ПроводитьДокумент, СоздаватьЗаявкиНаЗарплату, СоздаватьЗаявкиНаНДФЛ, РежимТестирования",
			ПроводитьЗаявки, СоздаватьЗаявкиНаЗарплату, Ложь, РежимТестирования);
		
		// --- Собираем элементы пакета зарплаты и данные для агрегации НДФЛ ---
		Для Каждого Адрес Из МассивАдресов Цикл
			
			ДанныеВедомости = ПолучитьИзВременногоХранилища(Адрес);
			
			// Элемент пакета для зарплаты
			ЭлПакета = Новый Структура;
			ЭлПакета.Вставить("Ведомость", Новый Структура(
				"Номер, Дата, ОрганизацияГУИД, ОрганизацияИНН,
				|ЗарплатныйПроектГУИД, ЗарплатныйПроектНаим, ПрямаяВыплата, ОснованиеЗУП",
				ДанныеВедомости.НомерВедомости,
				Формат(ДанныеВедомости.ДатаВедомости, "ДФ=yyyy-MM-dd"),
				ДанныеВедомости.ОрганизацияГУИД,
				ДанныеВедомости.ОрганизацияИНН,
				ДанныеВедомости.ЗарплатныйПроектГУИД,
				ДанныеВедомости.ЗарплатныйПроектНаим,
				ДанныеВедомости.ПрямаяВыплата,
				ДанныеВедомости.ОснованиеЗУП
			));
			ЭлПакета.Вставить("Строки",                    ДанныеВедомости.Физлица);
			ЭлПакета.Вставить("СтрокиНДФЛ",                Новый Массив); // НДФЛ - отдельным элементом пакета
			ЭлПакета.Вставить("ТолькоНДФЛ",                Ложь);
			ЭлПакета.Вставить("НазначениеПлатежаЗарплата", ДанныеВедомости.НазначениеЗарплата);
			ЭлПакета.Вставить("НазначениеПлатежаНДФЛ",    "");
			ЭлементыПакета.Добавить(ЭлПакета);
			
			// Агрегация НДФЛ: ключ = счёт + ИНН + период
			Если СоздаватьЗаявкиНаНДФЛ Тогда
				Счет = ДанныеВедомости.БанковскийСчетОрганизации;
				Если Не ЗначениеЗаполнено(Счет) Тогда
					Счет = "БезСчета";
				КонецЕсли;
				МесяцВедомости = Формат(НачалоМесяца(ДанныеВедомости.ПериодРегистрацииДата), "ДФ=yyyy-MM");
				КлючАгрегации  = Счет + "|" + ДанныеВедомости.ОрганизацияИНН + "|" + МесяцВедомости;
				
				Агрегат = АгрегацияНДФЛ[КлючАгрегации];
				Если Агрегат = Неопределено Тогда
					Агрегат = Новый Структура(
						"БанковскийСчетОрганизации, СуммаНДФЛ, ФизлицаНДФЛ, НазначениеНДФЛ,
						|ОрганизацияГУИД, ОрганизацияИНН,
						|ЗарплатныйПроектГУИД, ЗарплатныйПроектНаим, ПрямаяВыплата, МассивОснований, МассивНомеров,
						|МаксДатаВедомости",
						Счет, 0, Новый Массив, ДанныеВедомости.НазначениеНДФЛ,
						ДанныеВедомости.ОрганизацияГУИД, ДанныеВедомости.ОрганизацияИНН,
						ДанныеВедомости.ЗарплатныйПроектГУИД, ДанныеВедомости.ЗарплатныйПроектНаим,
						ДанныеВедомости.ПрямаяВыплата, Новый Массив, Новый Массив,
						ДанныеВедомости.ДатаВедомости
					);
					АгрегацияНДФЛ.Вставить(КлючАгрегации, Агрегат);
				КонецЕсли;
				
				Агрегат.МассивОснований.Добавить(ДанныеВедомости.ОснованиеЗУП);
				Агрегат.МассивНомеров.Добавить(ДанныеВедомости.НомерВедомости);
				
				// Берём максимальную дату среди агрегированных ведомостей для даты заявки НДФЛ
				Если ДанныеВедомости.ДатаВедомости > Агрегат.МаксДатаВедомости Тогда
					Агрегат.МаксДатаВедомости = ДанныеВедомости.ДатаВедомости;
				КонецЕсли;
				
				Для Каждого Физлицо Из ДанныеВедомости.ФизлицаНДФЛ Цикл
					Агрегат.СуммаНДФЛ = Агрегат.СуммаНДФЛ + Физлицо["Сумма"];
					Агрегат.ФизлицаНДФЛ.Добавить(Физлицо);
				КонецЦикла;
			КонецЕсли;
			
		КонецЦикла;
		
		// --- Добавляем элементы пакета НДФЛ (только если галочка стоит) ---
		Если СоздаватьЗаявкиНаНДФЛ Тогда
			Для Каждого КЗ Из АгрегацияНДФЛ Цикл
				
				Агрегат = КЗ.Значение;
				Если Агрегат.ФизлицаНДФЛ.Количество() = 0 Тогда
					Продолжить;
				КонецЕсли;
				
				// Формируем ОснованиеЗУП для НДФЛ - отсортированные основания через "; "
				ОснованияСписок = Новый СписокЗначений;
				Для Каждого Осн Из Агрегат.МассивОснований Цикл
					ОснованияСписок.Добавить(Осн);
				КонецЦикла;
				ОснованияСписок.СортироватьПоЗначению();
				ОснованияМассив = Новый Массив;
				Для Каждого Эл Из ОснованияСписок Цикл
					ОснованияМассив.Добавить(Эл.Значение);
				КонецЦикла;
				ОснованиеЗУПНДФЛ = Лев(СтрСоединить(ОснованияМассив, "; "), 1000);
				
				ЭлПакетаНДФЛ = Новый Структура;
				ЭлПакетаНДФЛ.Вставить("Ведомость", Новый Структура(
					"Номер, Дата, ОрганизацияГУИД, ОрганизацияИНН,
					|ЗарплатныйПроектГУИД, ЗарплатныйПроектНаим, ПрямаяВыплата, ОснованиеЗУП",
					"", Формат(Агрегат.МаксДатаВедомости, "ДФ=yyyy-MM-dd"),
					Агрегат.ОрганизацияГУИД, Агрегат.ОрганизацияИНН,
					Агрегат.ЗарплатныйПроектГУИД, Агрегат.ЗарплатныйПроектНаим,
					Агрегат.ПрямаяВыплата, ОснованиеЗУПНДФЛ
				));
				ЭлПакетаНДФЛ.Вставить("Строки",                    Новый Массив);
				ЭлПакетаНДФЛ.Вставить("СтрокиНДФЛ",                Агрегат.ФизлицаНДФЛ);
				ЭлПакетаНДФЛ.Вставить("НазначениеПлатежаЗарплата", "");
				ЭлПакетаНДФЛ.Вставить("НазначениеПлатежаНДФЛ",    Агрегат.НазначениеНДФЛ);
				ЭлПакетаНДФЛ.Вставить("ТолькоНДФЛ",               Истина);
				ЭлементыПакета.Добавить(ЭлПакетаНДФЛ);
				
			КонецЦикла;
		КонецЕсли;
		
		// --- Один POST запрос с полным пакетом ---
		Тело = Новый Структура;
		Тело.Вставить("Ведомости",              ЭлементыПакета);
		Тело.Вставить("ДополнительныеПараметры", ДополнительныеПараметры);
		Тело.Вставить("ТипИсточника",            "Ведомость");
		
		ПараметрыЗапроса = НовыеПараметрыЗапросаУТ();
		ПараметрыЗапроса.АдресРесурса  = ПолучитьАдресРесурсаУТ("/v1/paymentrequests/create");
		ПараметрыЗапроса.Метод         = "POST";
		ПараметрыЗапроса.ТелоЗапроса   = ЗначениеВСтрокуJSON(Тело);
		ПараметрыЗапроса.СобытиеЖурналаРегистрации = "ВыгрузкаВедомостиВУТ.ВыгрузкаПакета";
		
		РезультатЗапроса = ВыполнитьЗапрос(ПараметрыЗапроса);
		
		Если Не РезультатЗапроса.Успешно Тогда
			РезультатВыгрузки = "Ошибка: " + РезультатЗапроса.ТекстОшибки;
			Возврат;
		КонецЕсли;
		
		Если РезультатЗапроса.КодСостояния <> КодСостоянияОК() Тогда
			РезультатВыгрузки = "Ошибка выгрузки: HTTP "
				+ РезультатЗапроса.КодСостояния
				+ Символы.ПС + РезультатЗапроса.Ответ.ПолучитьТелоКакСтроку();
			Возврат;
		КонецЕсли;
		
		ОтветДанные  = ЗначениеИзСтрокиJSON(РезультатЗапроса.Ответ.ПолучитьТелоКакСтроку());
		МассивЗаявок = ОтветДанные["Заявки"];
		ВсегоСозданоЗаявок = МассивЗаявок.Количество();
		
		// Строим словарь номеров и текст результата
		Для Каждого Заявка Из МассивЗаявок Цикл
			
			ТипВыплаты  = Заявка["ТипВыплаты"];
			Основание   = Заявка["ОснованиеЗУП"];
			
			Если ТипВыплаты = "Зарплата" Тогда
				// Ищем номер ведомости по основанию
				НомерВед = "";
				Для Каждого Адрес Из МассивАдресов Цикл
					Данных = ПолучитьИзВременногоХранилища(Адрес);
					Если Данных.ОснованиеЗУП = Основание Тогда
						НомерВед = Данных.НомерВедомости;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				ТекстРезультата = ТекстРезультата
					+ "• " + Заявка["Номер"] + " от " + Заявка["Дата"]
					+ " на сумму " + Формат(Заявка["Сумма"], "ЧДЦ=2; ЧРГ= ") + " руб."
					+ " (Зарплата, вед. " + НомерВед + ")" + Символы.ПС;
			Иначе
				// НДФЛ - ищем агрегат по основанию
				НомераВед = "";
				Для Каждого КЗ Из АгрегацияНДФЛ Цикл
					Агр = КЗ.Значение;
					ОснованиеАгр = Лев(СтрСоединить(Агр.МассивОснований, "; "), 1000);
					Если СтрНайти(Основание, Агр.МассивОснований[0]) > 0 Тогда
						НомераВед = СтрСоединить(Агр.МассивНомеров, "; ");
						Прервать;
					КонецЕсли;
				КонецЦикла;
				ТекстРезультата = ТекстРезультата
					+ "• " + Заявка["Номер"] + " от " + Заявка["Дата"]
					+ " на сумму " + Формат(Заявка["Сумма"], "ЧДЦ=2; ЧРГ= ") + " руб."
					+ " (НДФЛ, вед. " + НомераВед + ")" + Символы.ПС;
			КонецЕсли;
			
			// Словарь для обновления колонки Заявка
			Если ЗначениеЗаполнено(Основание) Тогда
				Если ТипВыплаты = "НДФЛ" Тогда
					// Для НДФЛ - заполняем для каждого входящего основания
					Для Каждого КЗ Из АгрегацияНДФЛ Цикл
						Если СтрНайти(Основание, КЗ.Значение.МассивОснований[0]) > 0 Тогда
							Для Каждого Осн Из КЗ.Значение.МассивОснований Цикл
								Список = СловарьНомеровЗаявок[Осн];
								Если Список = Неопределено Тогда
									Список = Новый Массив;
									СловарьНомеровЗаявок.Вставить(Осн, Список);
								КонецЕсли;
								Список.Добавить(Заявка["Номер"]);
							КонецЦикла;
							Прервать;
						КонецЕсли;
					КонецЦикла;
				Иначе
					Список = СловарьНомеровЗаявок[Основание];
					Если Список = Неопределено Тогда
						Список = Новый Массив;
						СловарьНомеровЗаявок.Вставить(Основание, Список);
					КонецЕсли;
					Список.Добавить(Заявка["Номер"]);
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
		// Обновляем колонку Заявка - сначала очищаем, потом заполняем из ответа
		Для Каждого Строка Из ТаблицаВедомостей Цикл
			Если Строка.Выбрать И ЗначениеЗаполнено(Строка.АдресДанных) Тогда
				Строка.Заявка = "";
			КонецЕсли;
		КонецЦикла;
		Для Каждого Строка Из ТаблицаВедомостей Цикл
			Если Не Строка.Выбрать Или Не ЗначениеЗаполнено(Строка.АдресДанных) Тогда
				Продолжить;
			КонецЕсли;
			Данные = ПолучитьИзВременногоХранилища(Строка.АдресДанных);
			НомераЗаявок = СловарьНомеровЗаявок[Данные.ОснованиеЗУП];
			Если НомераЗаявок <> Неопределено Тогда
				Строка.Заявка = СтрСоединить(НомераЗаявок, ", ");
			КонецЕсли;
		КонецЦикла;
		
		РезультатВыгрузки = "Создано заявок: " + ВсегоСозданоЗаявок + Символы.ПС
			+ Символы.ПС + ТекстРезультата;
		
	Исключение
		РезультатВыгрузки = "Ошибка: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
КонецПроцедуры

// Возвращает массив адресов данных из выбранных строк таблицы ведомостей
// Возвращает массив адресов данных из выбранных строк таблицы ведомостей.
&НаКлиенте
Функция ПолучитьВыбранныеСтрокиТаблицы()
	
	Выбранные = Новый Массив;
	Для Каждого Строка Из ТаблицаВедомостей Цикл
		Если Строка.Выбрать И ЗначениеЗаполнено(Строка.АдресДанных) Тогда
			Выбранные.Добавить(Строка.АдресДанных);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Выбранные;
	
КонецФункции

#КонецОбласти

#Область ВспомогательныеФункции

// Проверяет заполненность логина и пароля для подключения к УТ.
&НаКлиенте
Функция ПроверитьЗаполненностьПодключения()
	
	Если Не ЗначениеЗаполнено(Логин) Тогда
		ПоказатьПредупреждение(, "Введите логин");
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Пароль) Тогда
		ПоказатьПредупреждение(, "Введите пароль");
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Проверяет что все несопоставленные физлица заполнены перед сохранением маппинга.
&НаКлиенте
Функция ПроверитьЗаполненностьМаппинга()
	
	Для Каждого Строка Из НесопоставленныеФизлица Цикл
		
		Если Не ЗначениеЗаполнено(Строка.ПодразделениеГУИД) Тогда
			ПоказатьПредупреждение(,
				"Не заполнено подразделение для: " + Строка.Наименование);
			Возврат Ложь;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Строка.ЦентрРасходовГУИД) Тогда
			ПоказатьПредупреждение(,
				"Не заполнен центр расходов для: " + Строка.Наименование);
			Возврат Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

// Заполняет таблицу несопоставленных физлиц на странице сопоставления.
&НаКлиенте
Процедура ЗаполнитьТаблицуНесопоставленных(МассивФизлиц)
	
	НесопоставленныеФизлица.Очистить();
	
	Для Каждого Физлицо Из МассивФизлиц Цикл
		НоваяСтрока = НесопоставленныеФизлица.Добавить();
		НоваяСтрока.Идентификатор = Физлицо["Идентификатор"];
		НоваяСтрока.Наименование  = Физлицо["Наименование"];
	КонецЦикла;
	
КонецПроцедуры

// Создаёт структуру параметров HTTP-запроса к УТ с логином и паролем.
&НаСервере
Функция НовыеПараметрыЗапросаУТ()
	
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	ПараметрыЗапроса = ТекОбъект.НовыеПараметрыЗапроса();
	
	ПараметрыЗапроса.Заголовки.Вставить("Content-Type",  "application/json; charset=utf-8");
	ПараметрыЗапроса.Заголовки.Вставить("Authorization", ТекОбъект.СтрокаБазовойАвторизации(Логин, Пароль));
	
	ПараметрыЗапроса.ПараметрыПодключения.Сервер = ПолучитьСерверУТ();
	ПараметрыЗапроса.ПараметрыПодключения.Порт   = ПолучитьПортУТ();
	
	Возврат ПараметрыЗапроса;
	
КонецФункции

&НаСервере
Функция ВыполнитьЗапрос(ПараметрыЗапроса)
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	Возврат ТекОбъект.ВыполнитьЗапрос(ПараметрыЗапроса);
