// Формирует текстовый список несопоставленных физлиц для отображения в предупреждении.
&НаКлиенте
Функция СформироватьСписокНесопоставленных()
	
	СписокСтрок = Новый Массив;
	Для Каждого Строка Из НесопоставленныеФизлица Цикл
		СписокСтрок.Добавить("• " + Строка.Наименование);
	КонецЦикла;
	
	Возврат СтрСоединить(СписокСтрок, Символы.ПС);
	
КонецФункции

// Открывает форму выбора аналитики (подразделение/центр расходов/объект) для физлица.
&НаКлиенте
Процедура ЗаполнитьАналитику(Команда)
	
	// Проверяем что есть выделенные строки
	ВыделенныеСтроки = Элементы.НесопоставленныеФизлица.ВыделенныеСтроки;
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Выделите строки для заполнения аналитики.");
		Возврат;
	КонецЕсли;
	
	// Параметры для формы выбора аналитики
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("АдресСправочников", АдресСправочниковВХранилище);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ЗаполнитьАналитикуЗавершение", ЭтотОбъект, ВыделенныеСтроки);
	
	ОткрытьФорму(
		"ВнешняяОбработка.гкм_ФормированиеЗаявокНаРасходованиеДС.Форма.ФормаВыбораАналитики",
		ПараметрыФормы,
		ЭтаФорма,
		,
		,
		,
		ОписаниеОповещения,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца
	);   

КонецПроцедуры 

&НаКлиенте
Процедура ЗаполнитьАналитикуЗавершение(РезультатВыбора, ВыделенныеСтроки) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат; // Пользователь закрыл форму
	КонецЕсли;
	
	// Заполняем только заполненные значения из результата
	Для Каждого ИдСтроки Из ВыделенныеСтроки Цикл
		
		СтрокаТЗ = НесопоставленныеФизлица.НайтиПоИдентификатору(ИдСтроки);
		Если СтрокаТЗ = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(РезультатВыбора.ПодразделениеГУИД) Тогда
			СтрокаТЗ.ПодразделениеГУИД          = РезультатВыбора.ПодразделениеГУИД;
			СтрокаТЗ.ПодразделениеНаименование  = РезультатВыбора.ПодразделениеНаименование;

			СтрокаТЗ.ЦентрРасходовГУИД          = РезультатВыбора.ЦентрРасходовГУИД;
			СтрокаТЗ.ЦентрРасходовНаименование  = РезультатВыбора.ЦентрРасходовНаименование;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(РезультатВыбора.ОбъектСтроительстваГУИД) Тогда
			СтрокаТЗ.ОбъектСтроительстваГУИД         = РезультатВыбора.ОбъектСтроительстваГУИД;
			СтрокаТЗ.ОбъектСтроительстваНаименование = РезультатВыбора.ОбъектСтроительстваНаименование;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

