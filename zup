#Область ИнициализацияФормы

// Инициализация формы при создании на сервере.
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Элементы.СтраницаСопоставленияДанных.Видимость = Ложь;
	ПроводитьЗаявки 		  = Истина;
	СоздаватьЗаявкиНаЗарплату = Истина;
	СоздаватьЗаявкиНаНДФЛ 	  = Истина;

	РежимВыгрузки = 0; // 0 - Ведомость, 1 - Отражение зарплаты
	РежимПроверки = Ложь;

	// Значения по умолчанию - можно изменить на форме
	Если Не ЗначениеЗаполнено(СерверУТ) Тогда
		СерверУТ   = "localhost";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ИмяБазыУТ) Тогда
		ИмяБазыУТ = "UT";
	КонецЕсли;

	УстановитьВидимостьПоРежиму();

КонецПроцедуры

// Обработчик команды "На основании" - заполняет таблицу ведомостей или устанавливает
// документ отражения зарплаты в зависимости от типа переданного документа.
&НаКлиенте
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ОбъектыНазначенияМассив, СозданныеОбъекты) Экспорт
    
	Если ОбъектыНазначенияМассив.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Основание = ОбъектыНазначенияМассив[0];
	
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.ВедомостьНаВыплатуЗарплатыВБанк") Тогда
		
		РежимВыгрузки = 0;
		УстановитьВидимостьПоРежиму();
		
		ЭтаФорма.РежимОткрытияОкна = РежимОткрытияОкнаФормы.Независимый;
		ЭтаФорма.Открыть();
		
		// Добавляем все переданные ведомости в таблицу
		МассивВедомостей = Новый Массив;
		Для Каждого Документ Из ОбъектыНазначенияМассив Цикл
			Если ТипЗнч(Документ) = Тип("ДокументСсылка.ВедомостьНаВыплатуЗарплатыВБанк") Тогда
				МассивВедомостей.Добавить(Документ);
			КонецЕсли;
		КонецЦикла;
		
		ДобавитьВедомостиВТаблицу(МассивВедомостей);
		
	ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.ОтражениеЗарплатыВБухучете") Тогда
		
		ДокументИсточникОтражениеЗарплаты = Основание;
		РежимВыгрузки                     = 1;
		УстановитьВидимостьПоРежиму();
		
		ЭтаФорма.РежимОткрытияОкна = РежимОткрытияОкнаФормы.Независимый;
		ЭтаФорма.Открыть();
		
		ДокументИсточникОтражениеЗарплатыПриИзменении(Элементы.ДокументИсточникОтражениеЗарплаты);
		
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКоманд

// Кнопка "Заполнить таблицу" - заполняет таблицу ведомостей по фильтрам организация + период
&НаКлиенте
Процедура ЗаполнитьТаблицуВедомостей(Команда)
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		ПоказатьПредупреждение(, "Выберите организацию");
		Возврат;
	КонецЕсли;
	
	Если Не ПроверитьЗаполненностьПодключения() Тогда
		Возврат;
	КонецЕсли;
	
	Состояние("Заполнение таблицы ведомостей...");
	
	РезультатЗаполнения = ЗаполнитьТаблицуВедомостейСервер(
		Организация, Период.ДатаНачала, Период.ДатаОкончания);
	
	Если Не РезультатЗаполнения.Успех Тогда
		ПоказатьПредупреждение(, РезультатЗаполнения.Ошибка);
		Возврат;
	КонецЕсли;
	
	РезультатВыгрузки = "";
	Состояние("");
	ПересчитатьИтогиТаблицы();
	
КонецПроцедуры

// Добавляет переданные ведомости в таблицу (вызывается из ВыполнитьКоманду)
&НаКлиенте
Процедура ДобавитьВедомостиВТаблицу(МассивВедомостей)
	
	Если Не ПроверитьЗаполненностьПодключения() Тогда
		Возврат;
	КонецЕсли;
	
	Если МассивВедомостей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Состояние("Загрузка данных ведомостей...");
	
	РезультатДобавления = ДобавитьВедомостиВТаблицуСервер(МассивВедомостей);
	
	Если Не РезультатДобавления.Успех Тогда
		ПоказатьПредупреждение(, РезультатДобавления.Ошибка);
		Возврат;
	КонецЕсли;
	
	РезультатВыгрузки = "";
	Состояние("");
	ПересчитатьИтогиТаблицы();
	
КонецПроцедуры

// Кнопка "Проверить выгрузку"
&НаКлиенте
Процедура ПроверитьВыгрузку(Команда)
	РежимПроверки = Истина;
	ВыгрузитьВУТ(Неопределено);
КонецПроцедуры

// Кнопка "Выгрузить в УТ"
&НаКлиенте
Процедура ВыгрузитьВУТ(Команда)
	
	РежимПроверки = ?(Команда = Неопределено, РежимПроверки, Ложь);
	
	Если Не ПроверитьЗаполненностьПодключения() Тогда
		Возврат;
	КонецЕсли;
	
	Если РежимВыгрузки = 1 Тогда
		// --- Режим: Отражение зарплаты ---
		Если Не ЗначениеЗаполнено(ДокументИсточникОтражениеЗарплаты) Тогда
			ПоказатьПредупреждение(, "Выберите документ отражения зарплаты");
			Возврат;
		КонецЕсли;
		
		Состояние("Подготовка данных отражения зарплаты...");
		
		РезультатПодготовки = ПодготовитьДанныеОтраженияСервер(
			ДокументИсточникОтражениеЗарплаты);
		
		АдресДанныхОтражения = РезультатПодготовки.АдресДанных;
		
		Если Не РезультатПодготовки.Успех Тогда
			ПоказатьПредупреждение(, РезультатПодготовки.Ошибка);
			Возврат;
		КонецЕсли;
		
		// Проверяем настройки в УТ (служебный зарплатный проект для взносов)
		Состояние("Проверка настроек взносов в УТ...");
		
		РезультатПроверкиНастроек = ПроверитьНастройкиВзносовСервер(
			АдресДанныхОтражения);
		
		Если Не РезультатПроверкиНастроек.HTTPУспех Тогда
			ПоказатьПредупреждение(, "Ошибка проверки настроек: "
				+ РезультатПроверкиНастроек.Ошибка);
			Возврат;
		КонецЕсли;
		
		Если Не РезультатПроверкиНастроек.НастройкаВыполнена Тогда
			ПоказатьПредупреждение(,
				"Настройки взносов в УТ не заполнены:" + Символы.ПС
				+ СтрСоединить(РезультатПроверкиНастроек.НезаполненныеПоля, Символы.ПС));
			Возврат;
		КонецЕсли;
		
		// Проверяем сопоставление физлиц
		ПродолжитьВыгрузкуОтраженияПослеПроверкиНастроек();
		Возврат;
	КонецЕсли;
	
	// --- Режим: Ведомость ---
	ВыбранныеСтроки = ПолучитьВыбранныеСтрокиТаблицы();
	
	Если ВыбранныеСтроки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Отметьте хотя бы одну ведомость для выгрузки");
		Возврат;
	КонецЕсли;
	
	// Проверяем зарплатные проекты для всех выбранных ведомостей
	Состояние("Проверка зарплатных проектов...");
	
	РезультатПроверкиПроектов = ПроверитьЗарплатныеПроектыВедомостейСервер(ВыбранныеСтроки);
	
	Если Не РезультатПроверкиПроектов.HTTPУспех Тогда
		ПоказатьПредупреждение(, "Ошибка проверки зарплатного проекта: "
			+ РезультатПроверкиПроектов.Ошибка);
		Возврат;
	КонецЕсли;
	
	Если Не РезультатПроверкиПроектов.Найден Тогда
		
		// Проект не найден - предлагаем создать минимальную запись
		АдресДанныхДляСоздания = РезультатПроверкиПроектов.АдресДанных;
		ПоказатьВопрос(
			Новый ОписаниеОповещения("ОтветНаСозданиеПроектаВедомости", ЭтотОбъект,
				АдресДанныхДляСоздания),
			"Зарплатный проект не найден в УТ для документа:" + Символы.ПС
				+ РезультатПроверкиПроектов.ДокументПредставление + Символы.ПС + Символы.ПС
				+ "Создать запись для дальнейшей настройки?",
			РежимДиалогаВопрос.ДаНет,
			0,
			КодВозвратаДиалога.Нет
		);
		Возврат;
		
	ИначеЕсли Не РезультатПроверкиПроектов.НастройкаВыполнена Тогда
		
		ПоказатьПредупреждение(,
			"Зарплатный проект требует донастройки в УТ:" + Символы.ПС
				+ "Документ: " + РезультатПроверкиПроектов.ДокументПредставление + Символы.ПС
				+ СтрСоединить(РезультатПроверкиПроектов.НезаполненныеПоля, Символы.ПС));
		Возврат;
		
	КонецЕсли;
	
	// Проверяем сопоставление физлиц сразу по всем выбранным ведомостям
	Состояние("Проверка сопоставления физических лиц...");
	
	РезультатПроверки = ПроверитьСопоставлениеВедомостейСервер(ВыбранныеСтроки);
	
	Если Не РезультатПроверки.HTTPУспех Тогда
		ПоказатьПредупреждение(, "Ошибка проверки: " + РезультатПроверки.Ошибка);
		Возврат;
	КонецЕсли;
	
	Если РезультатПроверки.ЕстьНесопоставленные Тогда
		
		Состояние("Необходимо настроить сопоставление...");
		ЗаполнитьТаблицуНесопоставленных(РезультатПроверки.Физлица);
		
		Если Не ЗначениеЗаполнено(АдресСправочниковВХранилище) Тогда
			РезультатЗагрузки = ЗагрузитьСправочникиСервер();
			Если Не РезультатЗагрузки.Успех Тогда
				ПоказатьПредупреждение(,
					"Ошибка загрузки справочников: " + РезультатЗагрузки.Ошибка);
				Возврат;
			КонецЕсли;
			АдресСправочниковВХранилище = РезультатЗагрузки.АдресХранилища;
		КонецЕсли;
		
		ПоказатьПредупреждение(
			Новый ОписаниеОповещения("ПерейтиНаСтраницуСопоставления", ЭтотОбъект),
			"Для следующих сотрудников не настроено сопоставление с данными УТ:"
				+ Символы.ПС + Символы.ПС
				+ СформироватьСписокНесопоставленных()
				+ Символы.ПС + Символы.ПС
				+ "Заполните данные сопоставления и нажмите 'Записать соответствие'."
		);
		
	Иначе
		
		// Проверяем назначения платежа для выбранных строк
		ОшибкиНазначений = Новый Массив;
		Для Каждого Строка Из ТаблицаВедомостей Цикл
			Если Не Строка.Выбрать Тогда
				Продолжить;
			КонецЕсли;
			Если СоздаватьЗаявкиНаЗарплату И Не ЗначениеЗаполнено(Строка.НазначениеПлатежаЗарплата) Тогда
				ОшибкиНазначений.Добавить("Не заполнено назначение платежа (Зарплата): "
					+ Строка(Строка.ДокументИсточник));
			КонецЕсли;
			Если СоздаватьЗаявкиНаНДФЛ И Не ЗначениеЗаполнено(Строка.НазначениеПлатежаНДФЛ) Тогда
				ОшибкиНазначений.Добавить("Не заполнено назначение платежа (НДФЛ): "
					+ Строка(Строка.ДокументИсточник));
			КонецЕсли;
		КонецЦикла;
		
		Если ОшибкиНазначений.Количество() > 0 Тогда
			ПоказатьПредупреждение(, СтрСоединить(ОшибкиНазначений, Символы.ПС));
			Возврат;
		КонецЕсли;
		
		Если РежимПроверки Тогда
			ПоказатьПредупреждение(, "Документы готовы к выгрузке.");
		Иначе
			ВыполнитьВыгрузкуВыбранныхВедомостей(ВыбранныеСтроки);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Переключение режима выгрузки (0 - Ведомость, 1 - Отражение зарплаты)
&НаКлиенте
Процедура РежимВыгрузкиПриИзменении(Элемент)
	УстановитьВидимостьПоРежиму();
	РезультатВыгрузки = "";
КонецПроцедуры

// Обработчик выбора документа отражения зарплаты
&НаКлиенте
Процедура ДокументИсточникОтражениеЗарплатыПриИзменении(Элемент)
	
	// Сбрасываем предыдущие данные
	АдресДанныхОтражения                  = "";
	НазначениеПлатежаЕдиныйТариф          = "";
	НазначениеПлатежаФССНесчастныеСлучаи  = "";
	РезультатВыгрузки                     = "";
	
	Если Не ЗначениеЗаполнено(ДокументИсточникОтражениеЗарплаты) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПроверитьЗаполненностьПодключения() Тогда
		Возврат;
	КонецЕсли;
	
	Состояние("Загрузка данных отражения зарплаты...");
	
	РезультатПодготовки = ПодготовитьДанныеОтраженияСервер(
		ДокументИсточникОтражениеЗарплаты);
	
	АдресДанныхОтражения = РезультатПодготовки.АдресДанных;
	
	Если Не РезультатПодготовки.Успех Тогда
		ПоказатьПредупреждение(, РезультатПодготовки.Ошибка);
		Возврат;
	КонецЕсли;
	
	// Заполняем поля назначений из подготовленных данных
	НазначениеПлатежаЕдиныйТариф         = РезультатПодготовки.НазначениеЕТ;
	НазначениеПлатежаФССНесчастныеСлучаи = РезультатПодготовки.НазначениеФСС;
	
	Состояние("");
	
КонецПроцедуры

// Кнопка "Записать соответствие"
&НаКлиенте
Процедура ЗаписатьСоответствие(Команда)
	
	Если Не ПроверитьЗаполненностьМаппинга() Тогда
		Возврат;
	КонецЕсли;
	
	Состояние("Сохранение сопоставления в УТ...");
	
	РезультатСохранения = СохранитьМаппингСервер();
	
	Если РезультатСохранения.Успех Тогда
		
		Элементы.СтраницаСопоставленияДанных.Видимость = Ложь;
		Элементы.СтраницаВыгрузкиДанных.Видимость     = Истина;
		НесопоставленныеФизлица.Очистить();
		
		ПоказатьПредупреждение(
			,
			"Сопоставление успешно сохранено." + Символы.ПС + Символы.ПС
				+ "Нажмите 'Выгрузить в УТ' для повторной выгрузки ведомости."
		);
		
	Иначе
		ПоказатьПредупреждение(, "Ошибка сохранения: " + РезультатСохранения.Ошибка);
	КонецЕсли;
	
КонецПроцедуры

// Проверяет дубли при завершении редактирования строки таблицы ведомостей.
&НаКлиенте
Процедура ТаблицаВедомостейПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	
	Если ОтменаРедактирования Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока = Элементы.ТаблицаВедомостей.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекущаяСтрока.ДокументИсточник) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Строка Из ТаблицаВедомостей Цикл
		Если Строка <> ТекущаяСтрока И Строка.ДокументИсточник = ТекущаяСтрока.ДокументИсточник Тогда
			Отказ = Истина;
			ПоказатьПредупреждение(, "Ведомость уже есть в таблице: "
				+ Строка(ТекущаяСтрока.ДокументИсточник));
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Обновляет назначения платежа для выбранных строк таблицы из УТ
&НаКлиенте
Процедура ОбновитьНазначениеПлатежа(Команда)
	
	Если Не ПроверитьЗаполненностьПодключения() Тогда
		Возврат;
	КонецЕсли;
	
	Состояние("Обновление назначений платежа...");
	
	Результат = ОбновитьНазначениеПлатежаСервер();
	
	Если Не Результат.Успех Тогда
		ПоказатьПредупреждение(, Результат.Ошибка);
		Возврат;
	КонецЕсли;
	
	Состояние("");
	ПоказатьОповещениеПользователя("Назначения платежа обновлены");
	
КонецПроцедуры

// Устанавливает флаг Выбрать = Истина для всех строк таблицы
&НаКлиенте
Процедура ВыбратьВсе(Команда)
	Для Каждого Строка Из ТаблицаВедомостей Цикл
		Строка.Выбрать = Истина;
	КонецЦикла;
	ПересчитатьИтогиТаблицы();
КонецПроцедуры

// Снимает флаг Выбрать со всех строк таблицы
&НаКлиенте
Процедура СнятьВсе(Команда)
	Для Каждого Строка Из ТаблицаВедомостей Цикл
		Строка.Выбрать = Ложь;
	КонецЦикла;
	ПересчитатьИтогиТаблицы();
КонецПроцедуры

// Callback ответа на предложение создать зарплатный проект (режим ведомости)
&НаКлиенте
Процедура ОтветНаСозданиеПроектаВедомости(Ответ, АдресДанных) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Состояние("Создание зарплатного проекта в УТ...");
	
	РезультатСоздания = СохранитьЗарплатныйПроектСервер(АдресДанных);
	
	Если Не РезультатСоздания.Успех Тогда
		ПоказатьПредупреждение(, "Ошибка создания зарплатного проекта: "
			+ РезультатСоздания.Ошибка);
		Возврат;
	КонецЕсли;
	
	ПоказатьПредупреждение(,
		"Зарплатный проект успешно создан в УТ." + Символы.ПС + Символы.ПС
			+ "Необходимо донастроить реквизиты в регистре 'Настройки зарплатных проектов ЗУП'." + Символы.ПС
			+ "После донастройки повторите выгрузку."
	);
	
КонецПроцедуры

// Пересчитывает итоги подвала таблицы при любом изменении данных.
&НаКлиенте
Процедура ТаблицаВедомостейПриИзменении(Элемент)
	ПересчитатьИтогиТаблицы();
КонецПроцедуры

// Пересчитывает итоговые суммы по выбранным строкам и выводит в подвал таблицы
&НаКлиенте
Процедура ПересчитатьИтогиТаблицы()
	ИтогоЗарплата = 0;
	ИтогоНДФЛ    = 0;
	Для Каждого Строка Из ТаблицаВедомостей Цикл
		Если Строка.Выбрать Тогда
			ИтогоЗарплата = ИтогоЗарплата + Строка.СуммаПоДокументу;
			ИтогоНДФЛ    = ИтогоНДФЛ    + Строка.СуммаНДФЛ;
		КонецЕсли;
	КонецЦикла;
	Элементы.ТаблицаВедомостейСуммаПоДокументу.ТекстПодвала = Формат(ИтогоЗарплата, "ЧДЦ=2; ЧРГ= ");
	Элементы.ТаблицаВедомостейСуммаНДФЛ.ТекстПодвала        = Формат(ИтогоНДФЛ,    "ЧДЦ=2; ЧРГ= ");
КонецПроцедуры

// Обработчик изменения колонки ДокументИсточник в таблице - загружает данные для строки
&НаКлиенте
Процедура ТаблицаВедомостейДокументИсточникПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.ТаблицаВедомостей.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекущаяСтрока.ДокументИсточник) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПроверитьЗаполненностьПодключения() Тогда
		Возврат;
	КонецЕсли;
	// Проверка дубля выполняется в ТаблицаВедомостейПередОкончаниемРедактирования
	МассивВедомостей = Новый Массив;
	МассивВедомостей.Добавить(ТекущаяСтрока.ДокументИсточник);
	ДобавитьВедомостиВТаблицу(МассивВедомостей);
	
КонецПроцедуры

// Проверяет соединение с УТ отправляя тестовый запрос к сервису.
&НаКлиенте
Процедура ПроверитьСоединение(Команда)

	Если Не ПроверитьЗаполненностьПодключения() Тогда
		Возврат;
	КонецЕсли;

	Состояние("Проверка соединения с УТ...");

	РезультатПроверки = ПроверитьСоединениеСервер();

	Если РезультатПроверки.Успех Тогда
		ПоказатьПредупреждение(, "Соединение с УТ установлено успешно.");
	Иначе
		ПоказатьПредупреждение(, "Ошибка соединения с УТ:" + Символы.ПС + РезультатПроверки.Ошибка);
	КонецЕсли;

	Состояние("");

КонецПроцедуры

#КонецОбласти

#Область СерверныеФункции

// Отправляет тестовый запрос к УТ для проверки соединения.
// Возвращает Структуру(Успех, Ошибка).
&НаСервере
Функция ПроверитьСоединениеСервер()

	Результат = Новый Структура("Успех, Ошибка", Ложь, "");

	Попытка
		ПараметрыЗапроса = НовыеПараметрыЗапросаУТ();
		ПараметрыЗапроса.АдресРесурса = ПолучитьАдресРесурсаУТ("/v1/ping/");
		ПараметрыЗапроса.Метод        = "GET";
		ПараметрыЗапроса.СобытиеЖурналаРегистрации = "ПроверкаСоединенияУТ";

		РезультатЗапроса = ВыполнитьЗапрос(ПараметрыЗапроса);

		Если Не РезультатЗапроса.Успешно Тогда
			Результат.Ошибка = РезультатЗапроса.ТекстОшибки;
		ИначеЕсли РезультатЗапроса.КодСостояния <> КодСостоянияОК() Тогда
			Результат.Ошибка = "HTTP " + РезультатЗапроса.КодСостояния
				+ ": " + РезультатЗапроса.Ответ.ПолучитьТелоКакСтроку();
		Иначе
			Результат.Успех = Истина;
		КонецЕсли;
	Исключение
		Результат.Ошибка = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Читает данные ведомости, получает шаблоны из УТ и подставляет плейсхолдеры
&НаСервере
Функция ПодготовитьДанныеИНазначенияСервер(Знач ДокументИсточник)
	
	Результат = Новый Структура(
		"Успех, АдресДанныхВедомости, НазначениеПлатежаЗарплата, НазначениеПлатежаНДФЛ, Ошибка",
		Ложь, "", "", "", ""
	);
	
	Попытка
		
		// Читаем данные ведомости
		ДанныеВедомости = ПолучитьДанныеВедомостиСервер(ДокументИсточник);
		
		// Адрес сохраняем сразу - независимо от результата получения проекта
		Результат.АдресДанныхВедомости = ПоместитьВоВременноеХранилище(
			ДанныеВедомости, УникальныйИдентификатор);
		
		// Получаем данные зарплатного проекта из УТ по GUID
		ПараметрыЗапроса = НовыеПараметрыЗапросаУТ();
		ПараметрыЗапроса.АдресРесурса = ПолучитьАдресРесурсаУТ(
			"/v1/payrollproject/get?id=" + ДанныеВедомости.ЗарплатныйПроектГУИД
			+ "&inn=" + ДанныеВедомости.ОрганизацияИНН);
		ПараметрыЗапроса.Метод = "GET";
		ПараметрыЗапроса.СобытиеЖурналаРегистрации = "ВыгрузкаВедомостиВУТ.ПолучениеПроекта";
		
		РезультатЗапроса = ВыполнитьЗапрос(ПараметрыЗапроса);
		
		Если Не РезультатЗапроса.Успешно Тогда
			Результат.Ошибка = "Ошибка получения зарплатного проекта: "
				+ РезультатЗапроса.ТекстОшибки;
			Возврат Результат;
		КонецЕсли;
		
		Если РезультатЗапроса.КодСостояния <> КодСостоянияОК() Тогда
			Результат.Ошибка = "Ошибка получения зарплатного проекта: HTTP "
				+ РезультатЗапроса.КодСостояния;
			Возврат Результат;
		КонецЕсли;
		
		ДанныеПроекта = ЗначениеИзСтрокиJSON(
			РезультатЗапроса.Ответ.ПолучитьТелоКакСтроку(), Истина);
		
		Если Не ДанныеПроекта["Найден"] Тогда
			Результат.Ошибка = "Зарплатный проект не настроен в УТ."
				+ Символы.ПС + "Поля назначения платежа не заполнены."
				+ Символы.ПС + "Обратитесь к администратору для настройки справочника 'Зарплатные проекты' в УТ.";
			Возврат Результат;
		КонецЕсли;
		
		// Подставляем плейсхолдеры в шаблоны
		Шаблоны = ДанныеПроекта["Шаблоны"];
		
		ШаблонЗарплата = ?(Шаблоны["Зарплата"] <> Неопределено,
			Шаблоны["Зарплата"], "");
		ШаблонНДФЛ = ?(Шаблоны["НДФЛ"] <> Неопределено,
			Шаблоны["НДФЛ"], "");
		
		Результат.НазначениеПлатежаЗарплата = ПодставитьПлейсхолдеры(
			ШаблонЗарплата, ДанныеВедомости, ДанныеПроекта);
		
		Результат.НазначениеПлатежаНДФЛ = ПодставитьПлейсхолдеры(
			ШаблонНДФЛ, ДанныеВедомости, ДанныеПроекта);
		
		Результат.Успех = Истина;
		
	Исключение
		Результат.Ошибка = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Подставляет плейсхолдеры в квадратных скобках
// Плейсхолдеры [ФИО] и [НомерЛицевогоСчета] оставляем - УТ подставит при создании заявок
&НаСервере
Функция ПодставитьПлейсхолдеры(Шаблон, ДанныеВедомости, ДанныеПроекта)
	
	Если Не ЗначениеЗаполнено(Шаблон) Тогда
		Возврат "";
	КонецЕсли;
	
	ТекстВыплаты = ПолучитьТекстВидаВыплаты(ДанныеВедомости.ВидДокументаОснования);
	
	Результат = Шаблон;
	Результат = СтрЗаменить(Результат, "[ВидВыплаты]",              ТекстВыплаты);
	Результат = СтрЗаменить(Результат, "[Период]",                  ДанныеВедомости.ПериодРегистрации);
	Результат = СтрЗаменить(Результат, "[НомерДоговора]",           ДанныеПроекта["НомерДоговора"]);
	Результат = СтрЗаменить(Результат, "[ДатаДоговора]",            
		Формат(ДанныеПроекта["ДатаДоговора"], "ДФ=dd.MM.yyyy") + " г.");
	Результат = СтрЗаменить(Результат, "[ДатаВедомости]",           ДанныеВедомости.ДатаВедомостиТекст);
	Результат = СтрЗаменить(Результат, "[НаименованиеОрганизации]", ДанныеВедомости.НаименованиеОрганизации);
	Результат = СтрЗаменить(Результат, "[АдресОрганизации]",        ДанныеВедомости.АдресОрганизации);
	// [ФИО] и [НомерЛицевогоСчета] оставляем - УТ подставит при создании заявок для прямой выплаты
	
	Возврат Результат;
	
КонецФункции

