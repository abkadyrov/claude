&НаСервереБезКонтекста
Функция ПолучитьДанныеВедомостиСервер(ДокументИсточник)
	
	// Запрос строк зарплаты
	ЗапросЗарплата = Новый Запрос;
	ЗапросЗарплата.Текст =
		"ВЫБРАТЬ
		|	ВедомостьЗарплата.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ВедомостьЗарплата.КВыплате КАК Сумма,
		|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ВедомостьЗарплата.ФизическоеЛицо) КАК ИдентификаторФизлица,
		|	ВедомостьЗарплата.НомерЛицевогоСчета КАК НомерЛицевогоСчета
		|ИЗ
		|	Документ.ВедомостьНаВыплатуЗарплатыВБанк.Зарплата КАК ВедомостьЗарплата
		|ГДЕ
		|	ВедомостьЗарплата.Ссылка = &Ссылка";
	
	ЗапросЗарплата.УстановитьПараметр("Ссылка", ДокументИсточник);
	
	ТаблицаЗарплата = ЗапросЗарплата.Выполнить().Выгрузить(); 
	
	// Формируем массив физлиц
	Физлица = Новый Массив;
	Для Каждого Строка Из ТаблицаЗарплата Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("Идентификатор",      Строка(Строка.ИдентификаторФизлица));
		Элемент.Вставить("Наименование",       Строка(Строка.ФизическоеЛицо));
		Элемент.Вставить("Сумма",              Строка.Сумма);
		Элемент.Вставить("НомерЛицевогоСчета", Строка.НомерЛицевогоСчета);
		Физлица.Добавить(Элемент);
	КонецЦикла;
	
	// Запрос строк НДФЛ из отдельной ТЧ (аналогично строкам зарплаты)
	ЗапросНДФЛ = Новый Запрос;
	ЗапросНДФЛ.Текст =
		"ВЫБРАТЬ
		|	ВедомостьНДФЛ.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ВедомостьНДФЛ.Сумма КАК Сумма,
		|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ВедомостьНДФЛ.ФизическоеЛицо) КАК ИдентификаторФизлица
		|ИЗ
		|	Документ.ВедомостьНаВыплатуЗарплатыВБанк.НДФЛ КАК ВедомостьНДФЛ
		|ГДЕ
		|	ВедомостьНДФЛ.Ссылка = &Ссылка";
	
	ЗапросНДФЛ.УстановитьПараметр("Ссылка", ДокументИсточник);
	
	ТаблицаНДФЛ = ЗапросНДФЛ.Выполнить().Выгрузить();
	
	// Формируем массив физлиц НДФЛ
	ФизлицаНДФЛ = Новый Массив;
	Для Каждого Строка Из ТаблицаНДФЛ Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("Идентификатор",  Строка(Строка.ИдентификаторФизлица));
		Элемент.Вставить("Наименование",   Строка(Строка.ФизическоеЛицо));
		Элемент.Вставить("Сумма",          Строка.Сумма);
		ФизлицаНДФЛ.Добавить(Элемент);
	КонецЦикла;
	
	ДокОбъект = ДокументИсточник.ПолучитьОбъект();
	
	АдресОрганизации = ПолучитьАдресОрганизации(ДокОбъект.Организация);
	
	Результат = Новый Структура;
	Результат.Вставить("Физлица", 					Физлица);
	Результат.Вставить("ФизлицаНДФЛ", 				ФизлицаНДФЛ);
	Результат.Вставить("НомерВедомости",          	ДокОбъект.Номер);
	Результат.Вставить("ДатаВедомости",           	ДокОбъект.Дата);
	Результат.Вставить("ДатаВедомостиТекст",      	Формат(ДокОбъект.Дата, "ДЛФ=D") + " г.");
	Результат.Вставить("ПериодРегистрации",       	НРег(Формат(ДокОбъект.ПериодРегистрации, "ДФ='MMMM yyyy'")) + " г.");
	Результат.Вставить("ВидДокументаОснования",   	Строка(ДокОбъект.СпособВыплаты.ВидДокументаОснования));
	Результат.Вставить("НаименованиеОрганизации", 	ДокОбъект.Организация.Наименование);
	Результат.Вставить("АдресОрганизации",         	АдресОрганизации);
	Результат.Вставить("ОрганизацияГУИД",          	Строка(ДокОбъект.Организация.УникальныйИдентификатор()));
	Результат.Вставить("ОрганизацияИНН",           	ДокОбъект.Организация.ИНН);
	Результат.Вставить("ЗарплатныйПроектГУИД",     	Строка(ДокОбъект.ЗарплатныйПроект.УникальныйИдентификатор()));
	Результат.Вставить("ЗарплатныйПроектНаим",     	Строка(ДокОбъект.ЗарплатныйПроект));
	Результат.Вставить("ПрямаяВыплата",            	
		Не ДокОбъект.ЗарплатныйПроект.ИспользоватьЭлектронныйДокументооборотСБанком);
	
	Возврат Результат;
	
КонецФункции
 
&НаСервереБезКонтекста
Функция ПолучитьАдресОрганизации(Организация)
	
	МассивОрганизаций = Новый  Массив;
	МассивОрганизаций.Добавить(Организация);
	
	АдресаОрганизаций = УправлениеКонтактнойИнформациейЗарплатаКадры.АдресаОрганизаций(
		МассивОрганизаций, ТекущаяДатаСеанса());
	
	ОписаниеЮридическогоАдреса = УправлениеКонтактнойИнформациейЗарплатаКадры.АдресОрганизации(АдресаОрганизаций,
		Организация, Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации);

	Возврат ОписаниеЮридическогоАдреса.Представление;
	
КонецФункции

// Устанавливает видимость полей формы в зависимости от режима выгрузки
&НаСервере
Процедура УстановитьВидимостьПоРежиму()
	РежимОтражения = РежимВыгрузки = 1;
	Элементы.ДокументИсточник.Видимость                     = Не РежимОтражения;
	Элементы.ДокументИсточникОтражениеЗарплаты.Видимость    = РежимОтражения;
КонецПроцедуры

// Читает данные документа ОтражениеЗарплатыВБухучете:
// суммирует ВзносыПоЕдиномуТарифу и ФССНесчастныеСлучаи в разрезе физлиц
&НаСервереБезКонтекста
Функция ПолучитьДанныеОтраженияЗарплатыСервер(ДокументИсточник)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ТЧ.ФизическоеЛицо) КАК Идентификатор,
		|	ТЧ.ФизическоеЛицо                          КАК ФизическоеЛицо,
		|	СУММА(ТЧ.ВзносыПоЕдиномуТарифу)            КАК ВзносыПоЕдиномуТарифу,
		|	СУММА(ТЧ.ФССНесчастныеСлучаи)              КАК ФССНесчастныеСлучаи
		|ИЗ
		|	Документ.ОтражениеЗарплатыВБухучете.НачисленнаяЗарплатаИВзносы КАК ТЧ
		|ГДЕ
		|	ТЧ.Ссылка = &Ссылка
		|СГРУППИРОВАТЬ ПО
		|	ТЧ.ФизическоеЛицо";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументИсточник);
	ТаблицаВзносов = Запрос.Выполнить().Выгрузить();
	
	ФизлицаЕТ  = Новый Массив;
	ФизлицаФСС = Новый Массив;
	
	Для Каждого Строка Из ТаблицаВзносов Цикл
		
		Ид          = Строка(Строка.Идентификатор);
		Наименование = Строка(Строка.ФизическоеЛицо);
		
		Если Строка.ВзносыПоЕдиномуТарифу <> 0 Тогда
			Элемент = Новый Структура;
			Элемент.Вставить("Идентификатор", Ид);
			Элемент.Вставить("Наименование",  Наименование);
			Элемент.Вставить("Сумма",         Строка.ВзносыПоЕдиномуТарифу);
			ФизлицаЕТ.Добавить(Элемент);
		КонецЕсли;
		
		Если Строка.ФССНесчастныеСлучаи <> 0 Тогда
			Элемент = Новый Структура;
			Элемент.Вставить("Идентификатор", Ид);
			Элемент.Вставить("Наименование",  Наименование);
			Элемент.Вставить("Сумма",         Строка.ФССНесчастныеСлучаи);
			ФизлицаФСС.Добавить(Элемент);
		КонецЕсли;
		
	КонецЦикла;
	
	ДокОбъект = ДокументИсточник.ПолучитьОбъект();
	
	Результат = Новый Структура;
	Результат.Вставить("ФизлицаЕТ",           ФизлицаЕТ);
	Результат.Вставить("ФизлицаФСС",          ФизлицаФСС);
	Результат.Вставить("НомерДокумента",       ДокОбъект.Номер);
	Результат.Вставить("ДатаДокумента",        ДокОбъект.Дата);
	Результат.Вставить("ОрганизацияИНН",       ДокОбъект.Организация.ИНН);
	
	Возврат Результат;
	
КонецФункции

// Подготавливает данные отражения зарплаты и помещает во временное хранилище.
&НаСервере
Функция ПодготовитьДанныеОтраженияСервер(Знач ДокументИсточник, Знач Логин, Знач Пароль)
	
	Результат = Новый Структура("Успех, АдресДанных, Ошибка", Ложь, "", "");
	
	Попытка
		ДанныеОтражения = ПолучитьДанныеОтраженияЗарплатыСервер(ДокументИсточник);
		Результат.АдресДанных = ПоместитьВоВременноеХранилище(
			ДанныеОтражения, УникальныйИдентификатор);
		Результат.Успех = Истина;
	Исключение
		Результат.Ошибка = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Проверяет наличие и заполненность настроек взносов в УТ для данной организации.
&НаСервере
Функция ПроверитьНастройкиВзносовСервер(Знач АдресДанныхОтражения, Знач Логин, Знач Пароль)
	
	Результат = Новый Структура(
		"HTTPУспех, НастройкаВыполнена, НезаполненныеПоля, Ошибка",
		Ложь, Ложь, Новый Массив, ""
	);
	
	Попытка
		
		ДанныеОтражения = ПолучитьИзВременногоХранилища(АдресДанныхОтражения);
		
		Тело = Новый Структура(
			"ОрганизацияИНН, ТипИсточника",
			ДанныеОтражения.ОрганизацияИНН,
			"ОтражениеЗарплаты"
		);
		
		ПараметрыЗапроса = НовыеПараметрыЗапросаУТ(Логин, Пароль);
		ПараметрыЗапроса.АдресРесурса  = ПолучитьАдресРесурсаУТ("/v1/payrollproject/check");
		ПараметрыЗапроса.Метод         = "POST";
		ПараметрыЗапроса.ТелоЗапроса   = ЗначениеВСтрокуJSON(Тело);
		ПараметрыЗапроса.СобытиеЖурналаРегистрации = "ВыгрузкаВедомостиВУТ.ПроверкаНастроекВзносов";
		
		РезультатЗапроса = ВыполнитьЗапрос(ПараметрыЗапроса);
		
		Если Не РезультатЗапроса.Успешно Тогда
			Результат.Ошибка = РезультатЗапроса.ТекстОшибки;
			Возврат Результат;
		КонецЕсли;
		
		Если РезультатЗапроса.КодСостояния <> КодСостоянияОК() Тогда
			Результат.Ошибка = "HTTP " + РезультатЗапроса.КодСостояния
				+ ": " + РезультатЗапроса.Ответ.ПолучитьТелоКакСтроку();
			Возврат Результат;
		КонецЕсли;
		
		ОтветДанные = ЗначениеИзСтрокиJSON(
			РезультатЗапроса.Ответ.ПолучитьТелоКакСтроку());
		
		Результат.HTTPУспех          = Истина;
		Результат.НастройкаВыполнена = ОтветДанные["НастройкаВыполнена"];
		Результат.НезаполненныеПоля  = ?(ОтветДанные["НезаполненныеПоля"] <> Неопределено,
			ОтветДанные["НезаполненныеПоля"], Новый Массив);
		
	Исключение
		Результат.Ошибка = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Проверяет сопоставление физлиц из отражения зарплаты.
&НаСервере
Функция ПроверитьСопоставлениеОтраженияСервер(Знач АдресДанныхОтражения, Знач Логин, Знач Пароль)
	
	Результат = Новый Структура(
		"HTTPУспех, ЕстьНесопоставленные, Физлица, Ошибка",
		Ложь, Ложь, Новый Массив, ""
	);
	
	Попытка
		
		ДанныеОтражения = ПолучитьИзВременногоХранилища(АдресДанныхОтражения);
		
		// Объединяем физлиц из обоих массивов без дублей
		СловарьФизлиц = Новый Соответствие;
		Для Каждого Физлицо Из ДанныеОтражения.ФизлицаЕТ Цикл
			СловарьФизлиц.Вставить(Физлицо.Идентификатор,
				Новый Структура("Идентификатор, Наименование",
					Физлицо.Идентификатор, Физлицо.Наименование));
		КонецЦикла;
		Для Каждого Физлицо Из ДанныеОтражения.ФизлицаФСС Цикл
			СловарьФизлиц.Вставить(Физлицо.Идентификатор,
				Новый Структура("Идентификатор, Наименование",
					Физлицо.Идентификатор, Физлицо.Наименование));
		КонецЦикла;
		
		МассивДляПроверки = Новый Массив;
		Для Каждого КЗ Из СловарьФизлиц Цикл
			МассивДляПроверки.Добавить(КЗ.Значение);
		КонецЦикла;
		
		Тело = Новый Структура("Физлица", МассивДляПроверки);
		
		ПараметрыЗапроса = НовыеПараметрыЗапросаУТ(Логин, Пароль);
		ПараметрыЗапроса.АдресРесурса  = ПолучитьАдресРесурсаУТ("/v1/individuals/check");
		ПараметрыЗапроса.Метод         = "POST";
		ПараметрыЗапроса.ТелоЗапроса   = ЗначениеВСтрокуJSON(Тело);
		ПараметрыЗапроса.СобытиеЖурналаРегистрации = "ВыгрузкаВедомостиВУТ.ПроверкаСопоставленияОтражения";
		
		РезультатЗапроса = ВыполнитьЗапрос(ПараметрыЗапроса);
		
		Если Не РезультатЗапроса.Успешно Тогда
			Результат.Ошибка = РезультатЗапроса.ТекстОшибки;
			Возврат Результат;
		КонецЕсли;
		
		Если РезультатЗапроса.КодСостояния <> КодСостоянияОК() Тогда
			Результат.Ошибка = "HTTP " + РезультатЗапроса.КодСостояния
				+ ": " + РезультатЗапроса.Ответ.ПолучитьТелоКакСтроку();
			Возврат Результат;
		КонецЕсли;
		
		ОтветДанные = ЗначениеИзСтрокиJSON(
			РезультатЗапроса.Ответ.ПолучитьТелоКакСтроку());
		
		Результат.HTTPУспех            = Истина;
		Результат.ЕстьНесопоставленные = ОтветДанные["ЕстьНесопоставленные"];
		Результат.Физлица              = ОтветДанные["Физлица"];
		
	Исключение
		Результат.Ошибка = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Выгружает данные документа ОтражениеЗарплатыВБухучете в УТ как заявки на соц. отчисления
&НаСервере
Процедура ВыполнитьВыгрузкуОтраженияЗарплатыСервер(Знач АдресДанныхОтражения, Знач Логин, Знач Пароль)
	
	Попытка
		
		ДанныеОтражения = ПолучитьИзВременногоХранилища(АдресДанныхОтражения);
		
		Если ДанныеОтражения.ФизлицаЕТ.Количество() = 0
			И ДанныеОтражения.ФизлицаФСС.Количество() = 0 Тогда
			РезультатВыгрузки = "Нет данных для выгрузки: суммы взносов равны нулю.";
			Возврат;
		КонецЕсли;
		
		ДополнительныеПараметры = Новый Структура(
			"ПроводитьДокумент, РежимТестирования",
			ПроводитьЗаявки, РежимТестирования);
		
		Тело = Новый Структура;
		Тело.Вставить("ТипИсточника",    "ОтражениеЗарплаты");
		Тело.Вставить("Документ",        Новый Структура(
			"Номер, Дата, ОрганизацияИНН",
			ДанныеОтражения.НомерДокумента,
			ДанныеОтражения.ДатаДокумента,
			ДанныеОтражения.ОрганизацияИНН
		));
		Тело.Вставить("СтрокиЕТ",                  ДанныеОтражения.ФизлицаЕТ);
		Тело.Вставить("СтрокиФСС",                 ДанныеОтражения.ФизлицаФСС);
		Тело.Вставить("ДополнительныеПараметры",   ДополнительныеПараметры);
		
		ПараметрыЗапроса = НовыеПараметрыЗапросаУТ(Логин, Пароль);
		ПараметрыЗапроса.АдресРесурса  = ПолучитьАдресРесурсаУТ("/v1/paymentrequests/create");
		ПараметрыЗапроса.Метод         = "POST";
		ПараметрыЗапроса.ТелоЗапроса   = ЗначениеВСтрокуJSON(Тело);
		ПараметрыЗапроса.СобытиеЖурналаРегистрации = "ВыгрузкаВедомостиВУТ.ВыгрузкаОтраженияЗарплаты";
		
		РезультатЗапроса = ВыполнитьЗапрос(ПараметрыЗапроса);
		
		Если Не РезультатЗапроса.Успешно Тогда
			РезультатВыгрузки = "Ошибка: " + РезультатЗапроса.ТекстОшибки;
			Возврат;
		КонецЕсли;
		
		Если РезультатЗапроса.КодСостояния <> КодСостоянияОК() Тогда
			РезультатВыгрузки = "Ошибка выгрузки: HTTP " + РезультатЗапроса.КодСостояния
				+ Символы.ПС + РезультатЗапроса.Ответ.ПолучитьТелоКакСтроку();
			Возврат;
		КонецЕсли;
		
		ОтветДанные = ЗначениеИзСтрокиJSON(
			РезультатЗапроса.Ответ.ПолучитьТелоКакСтроку());
		
		МассивЗаявок     = ОтветДанные["Заявки"];
		ОбщаяСуммаЕТ     = 0;
		ОбщаяСуммаФСС    = 0;
		ТекстРезультата  = "";
		
		Для Каждого Заявка Из МассивЗаявок Цикл
			Сумма      = Заявка["Сумма"];
			ТипВыплаты = Заявка["ТипВыплаты"];
			Если ТипВыплаты = "ФССНесчастныеСлучаи" Тогда
				ОбщаяСуммаФСС = ОбщаяСуммаФСС + Сумма;
			Иначе
				ОбщаяСуммаЕТ = ОбщаяСуммаЕТ + Сумма;
			КонецЕсли;
			ТекстРезультата = ТекстРезультата
				+ "• " + Заявка["Номер"] + " от " + Заявка["Дата"]
				+ " на сумму " + Формат(Сумма, "ЧДЦ=2; ЧРГ= ") + " руб."
				+ " (" + ТипВыплаты + ")" + Символы.ПС;
		КонецЦикла;
		
		ТекстРезультата = "Создано заявок: " + МассивЗаявок.Количество() + Символы.ПС
			+ "Взносы по ЕТ: "         + Формат(ОбщаяСуммаЕТ,  "ЧДЦ=2; ЧРГ= ") + " руб." + Символы.ПС
			+ "ФСС (несч. случаи): "   + Формат(ОбщаяСуммаФСС, "ЧДЦ=2; ЧРГ= ") + " руб." + Символы.ПС
			+ Символы.ПС + ТекстРезультата;
		
		РезультатВыгрузки = ТекстРезультата;
		
	Исключение
		РезультатВыгрузки = "Ошибка: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область ВспомогательныеФункции

&НаКлиенте
Функция ПроверитьЗаполненностьПодключения()
	
	Если Не ЗначениеЗаполнено(Логин) Тогда
		ПоказатьПредупреждение(, "Введите логин");
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Пароль) Тогда
		ПоказатьПредупреждение(, "Введите пароль");
		Возврат Ложь;
	КонецЕсли;
	
