&НаКлиенте
Процедура ОтветНаСозданиеПроекта(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		АдресДанныхВедомости = "";
		Возврат;
	КонецЕсли;
	
	Состояние("Создание зарплатного проекта в УТ...");
	
	РезультатСозданияПроекта = СохранитьЗарплатныйПроектСервер(АдресДанныхВедомости, Логин, Пароль);
	
	Если Не РезультатСозданияПроекта.Успех Тогда
		ПоказатьПредупреждение(, "Ошибка создания зарплатного проекта: "
			+ РезультатСозданияПроекта.Ошибка);
		АдресДанныхВедомости = "";
		Возврат;
	КонецЕсли;
	
	АдресДанныхВедомости      = "";
	НазначениеПлатежаЗарплата = "";
	НазначениеПлатежаНДФЛ     = "";
	
	ПоказатьПредупреждение(
		,
		"Зарплатный проект успешно создан в УТ." + Символы.ПС + Символы.ПС
			+ "Необходимо:" + Символы.ПС
			+ "1. Привязать справочник 'Зарплатные проекты' в регистре УТ" + Символы.ПС
			+ "2. Донастроить реквизиты в регистре 'Настройки зарплатных проектов ЗУП'" + Символы.ПС + Символы.ПС
			+ "После донастройки перевыберите документ и повторите выгрузку."
	);
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьВыгрузкуПослеПроверкиПроекта()
	
	Состояние("Проверка сопоставления физических лиц...");
	
	РезультатПроверки = ПроверитьСопоставлениеСервер(АдресДанныхВедомости, Логин, Пароль);
	
	Если Не РезультатПроверки.HTTPУспех Тогда
		ПоказатьПредупреждение(, "Ошибка проверки: " + РезультатПроверки.Ошибка);
		Возврат;
	КонецЕсли;
	
	Если РезультатПроверки.ЕстьНесопоставленные Тогда
		
		Состояние("Необходимо настроить сопоставление...");
		ЗаполнитьТаблицуНесопоставленных(РезультатПроверки.Физлица);
		
		Если Не ЗначениеЗаполнено(АдресСправочниковВХранилище) Тогда
			РезультатЗагрузки = ЗагрузитьСправочникиСервер(Логин, Пароль);
			Если Не РезультатЗагрузки.Успех Тогда
				ПоказатьПредупреждение(,
					"Ошибка загрузки справочников: " + РезультатЗагрузки.Ошибка);
				Возврат;
			КонецЕсли;
			АдресСправочниковВХранилище = РезультатЗагрузки.АдресХранилища;
		КонецЕсли;
		
		ПоказатьПредупреждение(
			Новый ОписаниеОповещения("ПерейтиНаСтраницуСопоставления", ЭтотОбъект),
			"Для следующих сотрудников не настроено сопоставление с подразделениями УТ:"
				+ Символы.ПС + Символы.ПС
				+ СформироватьСписокНесопоставленных()
				+ Символы.ПС + Символы.ПС
				+ "Заполните данные сопоставления и нажмите 'Записать соответствие'."
		);
		
	Иначе
		ВыполнитьВыгрузкуВедомости(АдресДанныхВедомости, Логин, Пароль);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьВыгрузкуОтраженияПослеПроверкиНастроек()
	
	Состояние("Проверка сопоставления физических лиц...");
	
	РезультатПроверки = ПроверитьСопоставлениеОтраженияСервер(
		АдресДанныхОтражения, Логин, Пароль);
	
	Если Не РезультатПроверки.HTTPУспех Тогда
		ПоказатьПредупреждение(, "Ошибка проверки: " + РезультатПроверки.Ошибка);
		Возврат;
	КонецЕсли;
	
	Если РезультатПроверки.ЕстьНесопоставленные Тогда
		
		Состояние("Необходимо настроить сопоставление...");
		ЗаполнитьТаблицуНесопоставленных(РезультатПроверки.Физлица);
		
		Если Не ЗначениеЗаполнено(АдресСправочниковВХранилище) Тогда
			РезультатЗагрузки = ЗагрузитьСправочникиСервер(Логин, Пароль);
			Если Не РезультатЗагрузки.Успех Тогда
				ПоказатьПредупреждение(,
					"Ошибка загрузки справочников: " + РезультатЗагрузки.Ошибка);
				Возврат;
			КонецЕсли;
			АдресСправочниковВХранилище = РезультатЗагрузки.АдресХранилища;
		КонецЕсли;
		
		ПоказатьПредупреждение(
			Новый ОписаниеОповещения("ПерейтиНаСтраницуСопоставления", ЭтотОбъект),
			"Для следующих сотрудников не настроено сопоставление с подразделениями УТ:"
				+ Символы.ПС + Символы.ПС
				+ СформироватьСписокНесопоставленных()
				+ Символы.ПС + Символы.ПС
				+ "Заполните данные сопоставления и нажмите 'Записать соответствие'."
		);
		
	Иначе
		Состояние("Выгрузка отражения зарплаты...");
		ВыполнитьВыгрузкуОтраженияЗарплатыСервер(АдресДанныхОтражения, Логин, Пароль);
		Состояние("");
	КонецЕсли;
	
КонецПроцедуры

