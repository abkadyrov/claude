// Модуль формы

#Область ИнициализацияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Элементы.СтраницаСопоставленияДанных.Видимость = Ложь;
	ПроводитьЗаявки 			= Ложь;
	СоздаватьЗаявкиНаЗарплату	= Истина;
	СоздаватьЗаявкиНаНДФЛ 		= Истина;
	РежимВыгрузки				= 0; // 0 - Ведомость, 1 - Отражение зарплаты
	
	УстановитьВидимостьПоРежиму();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКоманд

// Кнопка "Обновить справочники"
&НаКлиенте
Процедура ОбновитьСправочники(Команда)
	
	Если Не ПроверитьЗаполненностьПодключения() Тогда
		Возврат;
	КонецЕсли;
	
	Состояние("Загрузка справочников из УТ...");
	
	РезультатЗагрузки = ЗагрузитьСправочникиСервер(Логин, Пароль);
	
	Если РезультатЗагрузки.Успех Тогда
		АдресСправочниковВХранилище = РезультатЗагрузки.АдресХранилища;
		ПоказатьОповещениеПользователя(
			"Справочники обновлены", , ,
			БиблиотекаКартинок.Информация
		);
	Иначе
		ПоказатьПредупреждение(, "Ошибка загрузки справочников: " + РезультатЗагрузки.Ошибка);
	КонецЕсли;
	
КонецПроцедуры

// Обработчик выбора документа - загружает данные ведомости и назначения платежей
&НаКлиенте
Процедура ДокументИсточникПриИзменении(Элемент)
	
	// Сбрасываем предыдущие данные
	АдресДанныхВедомости      	= "";
	НазначениеПлатежаЗарплата 	= "";
	НазначениеПлатежаНДФЛ     	= "";
	РезультатВыгрузки 			= "";	
	
	Если Не ЗначениеЗаполнено(ДокументИсточник) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПроверитьЗаполненностьПодключения() Тогда
		Возврат;
	КонецЕсли;
	
	Состояние("Загрузка данных ведомости...");
	
	РезультатПодготовки = ПодготовитьДанныеИНазначенияСервер(ДокументИсточник, Логин, Пароль);
	
	// Адрес всегда берём - данные ведомости читаются независимо от проекта
	АдресДанныхВедомости = РезультатПодготовки.АдресДанныхВедомости;
	
	Если Не РезультатПодготовки.Успех Тогда
		// Предупреждаем но не блокируем - выгрузка всё равно возможна
		// При нажатии "Выгрузить" проверка проекта повторится
		ПоказатьПредупреждение(, РезультатПодготовки.Ошибка);
		Возврат;
	КонецЕсли;
	
	НазначениеПлатежаЗарплата = РезультатПодготовки.НазначениеПлатежаЗарплата;
	НазначениеПлатежаНДФЛ     = РезультатПодготовки.НазначениеПлатежаНДФЛ;
	
	Состояние("");
	
КонецПроцедуры

// Кнопка "Выгрузить в УТ"
&НаКлиенте
Процедура ВыгрузитьВУТ(Команда)
	
	Если Не ПроверитьЗаполненностьПодключения() Тогда
		Возврат;
	КонецЕсли;
	
	Если РежимВыгрузки = 1 Тогда
		// --- Режим: Отражение зарплаты ---
		Если Не ЗначениеЗаполнено(ДокументИсточникОтражениеЗарплаты) Тогда
			ПоказатьПредупреждение(, "Выберите документ отражения зарплаты");
			Возврат;
		КонецЕсли;
		
		Состояние("Подготовка данных отражения зарплаты...");
		
		РезультатПодготовки = ПодготовитьДанныеОтраженияСервер(
			ДокументИсточникОтражениеЗарплаты, Логин, Пароль);
		
		АдресДанныхОтражения = РезультатПодготовки.АдресДанных;
		
		Если Не РезультатПодготовки.Успех Тогда
			ПоказатьПредупреждение(, РезультатПодготовки.Ошибка);
			Возврат;
		КонецЕсли;
		
		// Проверяем настройки в УТ (служебный зарплатный проект для взносов)
		Состояние("Проверка настроек взносов в УТ...");
		
		РезультатПроверкиНастроек = ПроверитьНастройкиВзносовСервер(
			АдресДанныхОтражения, Логин, Пароль);
		
		Если Не РезультатПроверкиНастроек.HTTPУспех Тогда
			ПоказатьПредупреждение(, "Ошибка проверки настроек: "
				+ РезультатПроверкиНастроек.Ошибка);
			Возврат;
		КонецЕсли;
		
		Если Не РезультатПроверкиНастроек.НастройкаВыполнена Тогда
			ПоказатьПредупреждение(,
				"Настройки взносов в УТ не заполнены:" + Символы.ПС
				+ СтрСоединить(РезультатПроверкиНастроек.НезаполненныеПоля, Символы.ПС));
			Возврат;
		КонецЕсли;
		
		// Проверяем сопоставление физлиц
		ПродолжитьВыгрузкуОтраженияПослеПроверкиНастроек();
		Возврат;
	КонецЕсли;
	
	// --- Режим: Ведомость ---
	Если Не ЗначениеЗаполнено(ДокументИсточник) Тогда
		ПоказатьПредупреждение(, "Выберите документ ведомости");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(АдресДанныхВедомости) Тогда
		ПоказатьПредупреждение(, "Данные ведомости не загружены. Перевыберите документ.");
		Возврат;
	КонецЕсли;
	
	// Проверяем зарплатный проект в УТ
	Состояние("Проверка зарплатного проекта...");
	
	РезультатПроверкиПроекта = ПроверитьЗарплатныйПроектСервер(АдресДанныхВедомости, Логин, Пароль);
	
	Если Не РезультатПроверкиПроекта.HTTPУспех Тогда
		ПоказатьПредупреждение(, "Ошибка проверки зарплатного проекта: "
			+ РезультатПроверкиПроекта.Ошибка);
		Возврат;
	КонецЕсли;
	
	Если Не РезультатПроверкиПроекта.Найден Тогда
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ОтветНаСозданиеПроекта", ЭтотОбъект);
		
		ПоказатьВопрос(
			ОписаниеОповещения,
			"Зарплатный проект не найден в УТ." + Символы.ПС
				+ "Создать минимальную запись для дальнейшей настройки?",
			РежимДиалогаВопрос.ДаНет,
			0,
			КодВозвратаДиалога.Нет
		);
		
		Возврат;
		
	ИначеЕсли Не РезультатПроверкиПроекта.НастройкаВыполнена Тогда
		
		ТекстОшибки = "Зарплатный проект требует донастройки в УТ:" + Символы.ПС
			+ СтрСоединить(РезультатПроверкиПроекта.НезаполненныеПоля, Символы.ПС);
		ПоказатьПредупреждение(, ТекстОшибки);
		Возврат;
		
	КонецЕсли;
	
	// Проект найден и донастроен - продолжаем
	ПродолжитьВыгрузкуПослеПроверкиПроекта();
	
КонецПроцедуры

// Переключение режима выгрузки (0 - Ведомость, 1 - Отражение зарплаты)
&НаКлиенте
Процедура РежимВыгрузкиПриИзменении(Элемент)
	УстановитьВидимостьПоРежиму();
	РезультатВыгрузки = "";
КонецПроцедуры

// Обработчик выбора документа отражения зарплаты
&НаКлиенте
Процедура ДокументИсточникОтражениеЗарплатыПриИзменении(Элемент)
	РезультатВыгрузки = "";
КонецПроцедуры

// Кнопка "Записать соответствие"
&НаКлиенте
Процедура ЗаписатьСоответствие(Команда)
	
	Если Не ПроверитьЗаполненностьМаппинга() Тогда
		Возврат;
	КонецЕсли;
	
	Состояние("Сохранение сопоставления в УТ...");
	
	РезультатСохранения = СохранитьМаппингСервер(Логин, Пароль);
	
	Если РезультатСохранения.Успех Тогда
		
		Элементы.СтраницаСопоставленияДанных.Видимость = Ложь;
		Элементы.СтраницаВыгрузкиДанных.Видимость     = Истина;
		НесопоставленныеФизлица.Очистить();
		АдресДанныхВедомости = "";
		
		ПоказатьПредупреждение(
			,
			"Сопоставление успешно сохранено." + Символы.ПС + Символы.ПС
				+ "Нажмите 'Выгрузить в УТ' для повторной выгрузки ведомости."
		);
		
	Иначе
		ПоказатьПредупреждение(, "Ошибка сохранения: " + РезультатСохранения.Ошибка);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СерверныеФункции

// Читает данные ведомости, получает шаблоны из УТ и подставляет плейсхолдеры
&НаСервере
Функция ПодготовитьДанныеИНазначенияСервер(Знач ДокументИсточник, Знач Логин, Знач Пароль)
	
	Результат = Новый Структура(
		"Успех, АдресДанныхВедомости, НазначениеПлатежаЗарплата, НазначениеПлатежаНДФЛ, Ошибка",
		Ложь, "", "", "", ""
	);
	
	Попытка
		
		// Читаем данные ведомости
		ДанныеВедомости = ПолучитьДанныеВедомостиСервер(ДокументИсточник);
		
		// Адрес сохраняем сразу - независимо от результата получения проекта
		Результат.АдресДанныхВедомости = ПоместитьВоВременноеХранилище(
			ДанныеВедомости, УникальныйИдентификатор);
		
		// Получаем данные зарплатного проекта из УТ по GUID
		ПараметрыЗапроса = НовыеПараметрыЗапросаУТ(Логин, Пароль);
		ПараметрыЗапроса.АдресРесурса = ПолучитьАдресРесурсаУТ(
			"/v1/payrollproject/get?id=" + ДанныеВедомости.ЗарплатныйПроектГУИД);
		ПараметрыЗапроса.Метод = "GET";
		ПараметрыЗапроса.СобытиеЖурналаРегистрации = "ВыгрузкаВедомостиВУТ.ПолучениеПроекта";
		
		РезультатЗапроса = ВыполнитьЗапрос(ПараметрыЗапроса);
		
		Если Не РезультатЗапроса.Успешно Тогда
			Результат.Ошибка = "Ошибка получения зарплатного проекта: "
				+ РезультатЗапроса.ТекстОшибки;
			Возврат Результат;
		КонецЕсли;
		
		Если РезультатЗапроса.КодСостояния <> КодСостоянияОК() Тогда
			Результат.Ошибка = "Ошибка получения зарплатного проекта: HTTP "
				+ РезультатЗапроса.КодСостояния;
			Возврат Результат;
		КонецЕсли;
		
		ДанныеПроекта = ЗначениеИзСтрокиJSON(
			РезультатЗапроса.Ответ.ПолучитьТелоКакСтроку());
		
		Если Не ДанныеПроекта["Найден"] Тогда
			Результат.Ошибка = "Зарплатный проект не настроен в УТ."
				+ Символы.ПС + "Поля назначения платежа не заполнены."
				+ Символы.ПС + "Обратитесь к администратору для настройки справочника 'Зарплатные проекты' в УТ.";
			Возврат Результат;
		КонецЕсли;
		
		// Подставляем плейсхолдеры в шаблоны
		Шаблоны = ДанныеПроекта["Шаблоны"];
		
		ШаблонЗарплата = ?(Шаблоны["Зарплата"] <> Неопределено,
			Шаблоны["Зарплата"], "");
		ШаблонНДФЛ = ?(Шаблоны["НДФЛ"] <> Неопределено,
			Шаблоны["НДФЛ"], "");
		
		Результат.НазначениеПлатежаЗарплата = ПодставитьПлейсхолдеры(
			ШаблонЗарплата, ДанныеВедомости, ДанныеПроекта);
		
		Результат.НазначениеПлатежаНДФЛ = ПодставитьПлейсхолдеры(
			ШаблонНДФЛ, ДанныеВедомости, ДанныеПроекта);
		
		Результат.Успех = Истина;
		
	Исключение
		Результат.Ошибка = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Подставляет плейсхолдеры в квадратных скобках
// Плейсхолдеры [ФИО] и [НомерЛицевогоСчета] оставляем - УТ подставит при создании заявок
&НаСервере
Функция ПодставитьПлейсхолдеры(Шаблон, ДанныеВедомости, ДанныеПроекта)
	
	Если Не ЗначениеЗаполнено(Шаблон) Тогда
		Возврат "";
	КонецЕсли;
	
	ТекстВыплаты = ПолучитьТекстВидаВыплаты(ДанныеВедомости.ВидДокументаОснования);
	
	Результат = Шаблон;
	Результат = СтрЗаменить(Результат, "[ВидВыплаты]",              ТекстВыплаты);
	Результат = СтрЗаменить(Результат, "[Период]",                  ДанныеВедомости.ПериодРегистрации);
	Результат = СтрЗаменить(Результат, "[НомерДоговора]",           ДанныеПроекта["НомерДоговора"]);
	Результат = СтрЗаменить(Результат, "[ДатаДоговора]",            
		Формат(ДанныеПроекта["ДатаДоговора"], "ДФ=dd.MM.yyyy") + " г.");
	Результат = СтрЗаменить(Результат, "[ДатаВедомости]",           ДанныеВедомости.ДатаВедомостиТекст);
	Результат = СтрЗаменить(Результат, "[НаименованиеОрганизации]", ДанныеВедомости.НаименованиеОрганизации);
	Результат = СтрЗаменить(Результат, "[АдресОрганизации]",        ДанныеВедомости.АдресОрганизации);
	// [ФИО] и [НомерЛицевогоСчета] оставляем - УТ подставит при создании заявок для прямой выплаты
	
	Возврат Результат;
	
КонецФункции

// Преобразует значение перечисления ВидДокументаОснования в текст
&НаСервере
Функция ПолучитьТекстВидаВыплаты(ВидДокументаОснования)
	
	Соответствие = Новый Соответствие;
	Соответствие.Вставить("НачислениеЗарплаты",                         "зарплаты");
	Соответствие.Вставить("НачислениеЗаПервуюПоловинуМесяца",           "аванса");
	Соответствие.Вставить("Премия",                                     "премии");
	Соответствие.Вставить("Отпуск",                                     "отпускных");
	Соответствие.Вставить("БольничныйЛист",                             "пособия по временной нетрудоспособности");
	Соответствие.Вставить("ВозвратНДФЛ",                                "возврата НДФЛ");
	Соответствие.Вставить("ЕдиновременноеПособиеЗаСчетФСС",            	"единовременного пособия за счет ФСС");
	Соответствие.Вставить("ИсключениеИзСписковЧасти",                   "выплаты при исключении из списков части");
	Соответствие.Вставить("Командировка",                               "командировочных");
	Соответствие.Вставить("КомпенсацияЗаЗадержкуЗарплаты",             	"компенсации за задержку зарплаты");
	Соответствие.Вставить("МатериальнаяПомощь",                         "материальной помощи");
	Соответствие.Вставить("НачислениеПоДоговорам",                      "выплаты по договорам");
	Соответствие.Вставить("ОплатаДнейУходаЗаДетьмиИнвалидами",         	"оплаты дней ухода за детьми-инвалидами");
	Соответствие.Вставить("ОплатаПоСреднемуЗаработку",                  "выплаты по среднему заработку");
	Соответствие.Вставить("ОплатаСверхурочныхВоеннослужащим",           "оплаты сверхурочных военнослужащим");
	Соответствие.Вставить("ОтпускВоеннослужащего",                      "отпускных военнослужащего");
	Соответствие.Вставить("ОтпускПоБеременностиИРодамВоеннослужащего",  "пособия по беременности и родам");
	Соответствие.Вставить("ОтпускПоУходуЗаРебенком",                   	"пособия по уходу за ребенком");
	Соответствие.Вставить("ОтпускПоУходуЗаРебенкомВоеннослужащего",   	"пособия по уходу за ребенком военнослужащего");
	Соответствие.Вставить("ПростойСотрудников",                         "оплаты простоя");
	Соответствие.Вставить("РазовоеНачисление",                          "разового начисления");
	Соответствие.Вставить("СохраняемоеДенежноеДовольствие",             "сохраняемого денежного довольствия");
	Соответствие.Вставить("Увольнение",                                 "увольнения");
	
	ТекстВыплаты = Соответствие[ВидДокументаОснования];
	
	Если ТекстВыплаты = Неопределено Тогда
		Возврат НРег(ВидДокументаОснования);
	КонецЕсли;
	
	Возврат ТекстВыплаты;
	
КонецФункции

&НаСервере
Функция ПроверитьЗарплатныйПроектСервер(Знач АдресДанныхВедомости, Знач Логин, Знач Пароль)
	
	Результат = Новый Структура(
		"HTTPУспех, Найден, НастройкаВыполнена, НезаполненныеПоля, Ошибка",
		Ложь, Ложь, Ложь, Новый Массив, ""
	);
	
	Попытка
		
		ДанныеВедомости = ПолучитьИзВременногоХранилища(АдресДанныхВедомости);
		
		Тело = Новый Структура(
			"ИдентификаторЗарплатногоПроекта, Наименование, ОрганизацияИНН",
			ДанныеВедомости.ЗарплатныйПроектГУИД,
			ДанныеВедомости.ЗарплатныйПроектНаим,
			ДанныеВедомости.ОрганизацияИНН
		);
		
		ПараметрыЗапроса = НовыеПараметрыЗапросаУТ(Логин, Пароль);
		ПараметрыЗапроса.АдресРесурса  = ПолучитьАдресРесурсаУТ("/v1/payrollproject/check");
		ПараметрыЗапроса.Метод         = "POST";
		ПараметрыЗапроса.ТелоЗапроса   = ЗначениеВСтрокуJSON(Тело);
		ПараметрыЗапроса.СобытиеЖурналаРегистрации = "ВыгрузкаВедомостиВУТ.ПроверкаПроекта";
		
